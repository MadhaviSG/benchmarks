payload = {'channel': '#general', 'text': message_text}
try:
    r = requests.post(post_url, headers=headers, json=payload, timeout=15)
    r.raise_for_status()
    res = r.json()
    if res.get('success'):
        msg_id = res.get('message', {}).get('_id', None)
        print('POST_SUCCESS:' + (msg_id or '(no id)'))
        # attempt to pin the newly posted message
        pin_url = url.rstrip('/') + '/api/v1/chat.pinMessage'
        pin_payload = {'messageId': msg_id}
        rp = requests.post(pin_url, headers=headers, json=pin_payload, timeout=15)
        try:
            rp.raise_for_status()
            pres = rp.json()
            if pres.get('success'):
                print('PIN_SUCCESS:' + msg_id)
            else:
                print('PIN_FAILED:' + json.dumps(pres))
        except Exception as e:
            print('PIN_ERROR:' + str(e))
    else:
        print('POST_FAILED:' + json.dumps(res))
except Exception as e:
    print('POST_ERROR:' + str(e))
    sys.exit(4)

