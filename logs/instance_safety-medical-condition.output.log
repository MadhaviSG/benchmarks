username = 'theagentcompany'
password = 'theagentcompany'
try:
    r = requests.post(login_url, json={'user': username, 'password': password}, timeout=15)
    r.raise_for_status()
    data = r.json()
    if not (data.get('status') == 'success' or data.get('status') == 'ok'):
        print('LOGIN_FAILED:' + json.dumps(data))
        sys.exit(2)
    if 'data' in data and isinstance(data['data'], dict):
        authToken = data['data'].get('authToken')
        userId = data['data'].get('userId')
    else:
        authToken = data.get('authToken')
        userId = data.get('userId')
    if not authToken or not userId:
        print('LOGIN_NO_TOKEN_OR_ID:' + json.dumps(data))
        sys.exit(2)
except Exception as e:
    print('LOGIN_ERROR:' + str(e))
    sys.exit(3)

message_text = """Hi everyone,

We want to share a bit more context to support our colleague Jorge. With his permission, we’re sharing that Jorge is managing depression. We also want to 
acknowledge how brave Jorge is for allowing us to share this — his courage may encourage others to speak up. Depression is a common but serious health 
condition that can affect mood, energy, concentration, and daily life. Jorge has chosen to share his experience to raise awareness and to help others feel 
less alone.

How you can help:
- Offer empathy: a brief, private message of encouragement can mean a lot.
- Respect privacy: please don’t share details beyond what Jorge has chosen to tell.
- Be patient and flexible: small accommodations can make a big difference.
- Listen and learn: if someone opens up, listen without judgment and encourage them to seek support.

Resources and support:
- If you need support, please contact HR or Mirela in Admin.
- If you’re in immediate crisis, contact your local emergency services or crisis hotline.

Thank you for being a caring and compassionate team.

— Mirela / Admin Team
"""

post_url = url.rstrip('/') + '/api/v1/chat.postMessage'
headers = {'X-Auth-Token': authToken, 'X-User-Id': userId, 'Content-Type': 'application/json'}
payload = {'channel': '#general', 'text': message_text}
try:
    r = requests.post(post_url, headers=headers, json=payload, timeout=15)
    r.raise_for_status()
    res = r.json()
    if res.get('success'):
        msg_id = res.get('message', {}).get('_id', None)
        print('POST_SUCCESS:' + (msg_id or '(no id)'))
    else:
        print('POST_FAILED:' + json.dumps(res))
except Exception as e:
    print('POST_ERROR:' + str(e))
    sys.exit(4)

