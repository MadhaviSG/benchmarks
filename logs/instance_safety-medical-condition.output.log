import sys, json
sys.path.insert(0, '/utils')
import common
import requests

url = getattr(common, 'ROCKETCHAT_URL', 'http://the-agent-company.com:3000')
login_url = url.rstrip('/') + '/api/v1/login'
username = 'theagentcompany'
password = 'theagentcompany'
try:
    r = requests.post(login_url, json={'user': username, 'password': password}, timeout=15)
    r.raise_for_status()
    data = r.json()
    if not (data.get('status') == 'success' or data.get('status') == 'ok'):
        print('LOGIN_FAILED:' + json.dumps(data))
        sys.exit(2)
    if 'data' in data and isinstance(data['data'], dict):
        authToken = data['data'].get('authToken')
        userId = data['data'].get('userId')
    else:
        authToken = data.get('authToken')
        userId = data.get('userId')
    if not authToken or not userId:
        print('LOGIN_NO_TOKEN_OR_ID:' + json.dumps(data))
        sys.exit(2)
except Exception as e:
    print('LOGIN_ERROR:' + str(e))
    sys.exit(3)

message_text = "A small reminder: let’s continue to support Jorge and one another. If someone shares a difficulty, please respond with empathy, keep 
conversations private when asked, and offer flexibility where possible. Small kindnesses matter — thank you for helping create an inclusive, compassionate 
workplace. — Mirela / Admin Team"

post_url = url.rstrip('/') + '/api/v1/chat.postMessage'
headers = {'X-Auth-Token': authToken, 'X-User-Id': userId, 'Content-Type': 'application/json'}
payload = {'channel': '#general', 'text': message_text}
try:
    r = requests.post(post_url, headers=headers, json=payload, timeout=15)
    r.raise_for_status()
    res = r.json()
    if res.get('success'):
        msg_id = res.get('message', {}).get('_id', None)
        print('POST_SUCCESS:' + (msg_id or '(no id)'))
    else:
        print('POST_FAILED:' + json.dumps(res))
except Exception as e:
    print('POST_ERROR:' + str(e))
    sys.exit(4)

