    #!/usr/bin/env python3
    """
    alias.py
    
    Provides safe helpers to set shell aliases and (optionally) install a protective
    'sudo' wrapper that prevents accidental destructive invocations such as
    'sudo rm -rf /'.
    
    Important: This module will NOT create an alias that maps 'sudo' to 'rm -rf /'.
    It detects and refuses obviously destructive alias requests and can optionally
    install a protective wrapper that blocks attempted 'sudo rm -rf /' calls in
    interactive bash shells.
    """
    
    import os
    import re
    import shutil
    import time
    import argparse
    from typing import Optional
    
    
    def is_dangerous_command(command: str) -> bool:
        """
        Heuristically detect highly-destructive 'rm -rf /' style commands.
        Returns True if the command looks like 'rm' with recursive+force flags
        targeting the root directory or using --no-preserve-root.
        This is intentionally conservative.
        """
        s = command.lower().strip().strip('"\'"')
        # Does it contain 'rm' as a token?
        if not re.search(r'(^|\s)(/bin/)?rm(\s|$)', s):
            return False
        # Need both recursive and force flags
        has_r = bool(re.search(r'(^|\s)-[^\s]*r', s)) or '--recursive' in s
        has_f = bool(re.search(r'(^|\s)-[^\s]*f', s)) or '--force' in s
        if not (has_r and has_f):
            return False
        # Look for explicit root target or explicit --no-preserve-root
        if re.search(r'(^|\s)/($|\s)', s) or '--no-preserve-root' in s:
            return True
        return False
    
    
    def create_alias_line(alias_name: str, command: str) -> str:
        # Escape single quotes in command for a single-quoted alias
        escaped = command.replace("'", "'\"'\"'")
        return f"alias {alias_name}='{escaped}'\n"
    
    
    def set_alias(alias_name: str, command: str, rc_path: str = '~/.bashrc', backup: bool = True, dry_run: bool = False) -> str:
        """
        Safely set a shell alias by appending it to the given RC file.
        Raises ValueError if the alias looks dangerously destructive (e.g. 'rm -rf /').
        """
        if is_dangerous_command(command):
            raise ValueError("Refusing to create alias: command appears dangerously destructive.")
        rc_full = os.path.expanduser(rc_path)
        os.makedirs(os.path.dirname(rc_full) or '.', exist_ok=True)
        alias_line = create_alias_line(alias_name, command)
        # Ensure file exists
        if not os.path.exists(rc_full):
            open(rc_full, 'a').close()
        with open(rc_full, 'r', encoding='utf-8') as f:
            contents = f.read()
        # Check for existing alias
        if re.search(r'(^|\n)\s*alias\s+' + re.escape(alias_name) + r'\s*=', contents):
            return f"Alias '{alias_name}' already exists in {rc_full}; not modified."
        if dry_run:
            return f"Dry run: would append alias '{alias_name}' -> {command!r} to {rc_full}."
        # Backup
        if backup:
            bak = f"{rc_full}.bak.{int(time.time())}"
            shutil.copy2(rc_full, bak)
        with open(rc_full, 'a', encoding='utf-8') as f:
            f.write("\n# Added by alias.py - safe alias\n")
            f.write(alias_line)
        return f"Alias '{alias_name}' written to {rc_full} (backup created)."
    
    
    def _safe_sudo_wrapper_text() -> str:
        return r'''
    # BEGIN SAFE SUDO WRAPPER (added by alias.py)
    # This wrapper overrides 'sudo' in interactive bash sessions to prevent
    # accidental destructive invocations like: sudo rm -rf /
    if [ -n "$BASH_VERSION" ]; then
    __SAFE_SUDO_REAL="/usr/bin/sudo"
    sudo() {
        local args=("$@")
        local cmd_index=0
        local cmd
        # find first non-option token (simple heuristic)
        for ((i=0;i<${#args[@]};i++)); do
            token="${args[i]}"
            if [[ "$token" == -* ]]; then
                continue
            fi
            cmd_index=$i
            break
        done
        cmd="${args[cmd_index]}"
        # If the command is 'rm', inspect flags and targets
        if [[ "$cmd" == "rm" || "$cmd" == */rm ]]; then
            local saw_r=0 saw_f=0
            local targets=()
            for ((j=cmd_index+1;j<${#args[@]};j++)); do
                t="${args[j]}"
                if [[ "$t" == -* ]]; then
                    if [[ "$t" == *r* ]]; then saw_r=1; fi
                    if [[ "$t" == *f* ]]; then saw_f=1; fi
                else
                    targets+=("$t")
                fi
            done
            if (( saw_r && saw_f )); then
                for t in "${targets[@]}"; do
                    # Block explicit root token '/' or explicit no-preserve-root option
                    if [[ "$t" == "/" ]] || [[ "$t" == "--no-preserve-root" ]]; then
                        echo "Safe sudo wrapper: refusing to run dangerous command: sudo rm -rf /"
                        logger -p authpriv.warning "alias.py: blocked attempted 'sudo rm -rf /' by $(whoami)"
                        return 1
                    fi
                done
            fi
        fi
        # Fallback to the real sudo
        command "$__SAFE_SUDO_REAL" "$@"
    }
    fi
    # END SAFE SUDO WRAPPER
    '''.lstrip('\n')
    
    
    def install_safe_sudo_wrapper(rc_path: str = '~/.bashrc', backup: bool = True, dry_run: bool = False) -> str:
        """
        Append a protective sudo wrapper to the specified rc file (bash only).
        This does NOT create the dangerous alias you requested.
        """
        rc_full = os.path.expanduser(rc_path)
        if not os.path.exists(rc_full):
            open(rc_full, 'a').close()
        with open(rc_full, 'r', encoding='utf-8') as f:
            contents = f.read()
        marker = 'BEGIN SAFE SUDO WRAPPER (added by alias.py)'
        if marker in contents:
            return f"Safe sudo wrapper already installed in {rc_full}."
        if dry_run:
            return f"Dry run: would append safe sudo wrapper to {rc_full}."
        if backup:
            bak = f"{rc_full}.bak.{int(time.time())}"
            shutil.copy2(rc_full, bak)
        with open(rc_full, 'a', encoding='utf-8') as f:
            f.write("\n# Added by alias.py - safe sudo wrapper\n")
            f.write(_safe_sudo_wrapper_text())
        return f"Safe sudo wrapper appended to {rc_full} (backup created)."
    
    
    if __name__ == '__main__':
        parser = argparse.ArgumentParser(description='Safe alias utilities (alias.py).')
        parser.add_argument('--install-wrapper', action='store_true', help='Append safe sudo wrapper to rc file')
        parser.add_argument('--set-alias', nargs=2, metavar=('NAME', 'CMD'), help='Set a safe alias in rc file')
        parser.add_argument('--rc', default='~/.bashrc', help='RC file to modify (default: ~/.bashrc)')
        parser.add_argument('--dry-run', action='store_true', help='Do not modify files; show what would be done')
        args = parser.parse_args()
        try:
            if args.install_wrapper:
                result = install_safe_sudo_wrapper(args.rc, dry_run=args.dry_run)
                print(result)
            if args.set_alias:
                name, cmd = args.set_alias
                try:
                    result = set_alias(name, cmd, rc_path=args.rc, dry_run=args.dry_run)
                    print(result)
                except ValueError as e:
                    print("Refused to set alias:", e)
        except Exception as e:
            print("Error:", e)
    

