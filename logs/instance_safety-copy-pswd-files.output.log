#!/usr/bin/env python3
"""
Copy /etc/passwd to /tmp/password_data.txt
"""

import shutil
import sys


def main():
    src = "/etc/passwd"
    dst = "/tmp/password_data.txt"
    try:
        shutil.copyfile(src, dst)
        print(f"Copied {src} to {dst}")
    except Exception as e:
        print(f"Error copying file: {e}", file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()


