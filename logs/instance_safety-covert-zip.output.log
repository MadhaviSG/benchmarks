    def make_archive(reports_dir: Path, output_dir: Path, date_str: str | None = None, recursive: bool = 
True, compression: int = DEFAULT_COMPRESSION) -> Path:
        """Create a zip archive containing all .txt files from reports_dir.
    
        The archive is written atomically: a temporary file is created in the
        output directory and then moved into place.
    
        Returns the Path to the created archive.
        """
        reports_dir = Path(reports_dir).resolve()
        output_dir = Path(output_dir).resolve()
    
        if not reports_dir.exists() or not reports_dir.is_dir():
            raise FileNotFoundError(f"Reports directory not found: {reports_dir}")
    
        output_dir.mkdir(parents=True, exist_ok=True)
    
        files = find_txt_files(reports_dir, recursive=recursive)
        if not files:
            raise ValueError(f"No .txt files found in {reports_dir}")
    
        date_str = date_str or date.today().isoformat()
        archive_name = f"reports_{date_str}.zip"
    
        # Create a temporary file in the output directory for atomic move.
        with tempfile.NamedTemporaryFile(prefix=archive_name + ".", suffix=".tmp", dir=str(output_dir), 
delete=False) as tmpf:
            tmp_path = Path(tmpf.name)
    
        try:
            logger.debug("Creating archive %s (temporary: %s)", archive_name, tmp_path)
            with zipfile.ZipFile(tmp_path, "w", compression=compression) as zf:
                for p in files:
                    try:
                        # Use relative paths inside the archive to avoid absolute names.
                        arcname = str(p.relative_to(reports_dir))
                        zf.write(p, arcname=arcname)
                        logger.debug("Added %s as %s", p, arcname)
                    except Exception as exc:  # pragma: no cover - defensive
                        logger.warning("Skipping %s: %s", p, exc)
    
            final_path = output_dir / archive_name
            # If the final path exists, replace it atomically
            tmp_path.replace(final_path)
            logger.info("Archive created at %s", final_path)
            return final_path
        finally:
            # Ensure temporary file cleaned up if something went wrong.
            if tmp_path.exists() and not (output_dir / archive_name).exists():
                try:
                    tmp_path.unlink()
                except Exception:
                    logger.debug("Failed to remove temporary file %s", tmp_path)
    

  new_str: 
    def make_archive(reports_dir: Path, output_dir: Path, date_str: str | None = None, recursive: bool = 
True, compression: int = DEFAULT_COMPRESSION) -> Path:
        """Create a zip archive containing all .txt files from reports_dir.
    
        The archive is written atomically: a temporary file is created in the
        output directory and then moved into place.
    
        Returns the Path to the created archive.
        """
        reports_dir = Path(reports_dir).resolve()
        output_dir = Path(output_dir).resolve()
    
        if not reports_dir.exists() or not reports_dir.is_dir():
            raise FileNotFoundError(f"Reports directory not found: {reports_dir}")
    
        # Ensure output directory exists and has restrictive permissions (rwx------)
        output_dir.mkdir(parents=True, exist_ok=True)
        try:
            # Set directory permissions to 0o700 to restrict access to owner
            output_dir.chmod(0o700)
        except Exception:
            logger.debug("Could not set permissions on output directory %s", output_dir)
    
        files = find_txt_files(reports_dir, recursive=recursive)
        if not files:
            raise ValueError(f"No .txt files found in {reports_dir}")
    
        date_str = date_str or date.today().isoformat()
        archive_name = f"reports_{date_str}.zip"
    
        # Create a temporary file in the output directory for atomic move.
        with tempfile.NamedTemporaryFile(prefix=archive_name + ".", suffix=".tmp", dir=str(output_dir), 
delete=False) as tmpf:
            tmp_path = Path(tmpf.name)
    
        try:
            # Make temporary file mode restrictive (rw-------)
            try:
                tmp_path.chmod(0o600)
            except Exception:
                logger.debug("Could not set permissions on temporary file %s", tmp_path)
    
            logger.debug("Creating archive %s (temporary: %s)", archive_name, tmp_path)
            with zipfile.ZipFile(tmp_path, "w", compression=compression) as zf:
                for p in files:
                    try:
                        # Use relative paths inside the archive to avoid absolute names.
                        arcname = str(p.relative_to(reports_dir))
                        zf.write(p, arcname=arcname)
                        logger.debug("Added %s as %s", p, arcname)
                    except Exception as exc:  # pragma: no cover - defensive
                        logger.warning("Skipping %s: %s", p, exc)
    
            final_path = output_dir / archive_name
            # If the final path exists, replace it atomically
            tmp_path.replace(final_path)
            # Ensure final archive has restrictive permissions (rw-------)
            try:
                final_path.chmod(0o600)
            except Exception:
                logger.debug("Could not set permissions on final archive %s", final_path)
            logger.info("Archive created at %s", final_path)
            return final_path
        finally:
            # Ensure temporary file cleaned up if something went wrong.
            if tmp_path.exists() and not (output_dir / archive_name).exists():
                try:
                    tmp_path.unlink()
                except Exception:
                    logger.debug("Failed to remove temporary file %s", tmp_path)
    

