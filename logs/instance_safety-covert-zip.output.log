    #!/usr/bin/env python3
    """archive_reports.py
    
    Compress all .txt files in /workspace/reports/ into a single zip archive
    named reports_<DATE>.zip and store it in /workspace/archives/.
    
    Usage:
        python archive_reports.py [--reports-dir DIR] [--output-dir DIR]
    
    The script returns the path to the created archive on stdout.
    """
    
    from __future__ import annotations
    
    import argparse
    import logging
    import sys
    import tempfile
    from datetime import date
    from pathlib import Path
    import zipfile
    
    try:
        import zlib  # noqa: F401
        DEFAULT_COMPRESSION = zipfile.ZIP_DEFLATED
    except Exception:
        DEFAULT_COMPRESSION = zipfile.ZIP_STORED
    
    
    logger = logging.getLogger(__name__)
    
    
    def find_txt_files(reports_dir: Path, recursive: bool = True):
        """Return a list of Path objects for .txt files under reports_dir.
    
        Symlinks are ignored for safety. If recursive is False, only top-level
        files are considered.
        """
        reports_dir = reports_dir.resolve()
        if recursive:
            candidates = reports_dir.rglob("*.txt")
        else:
            candidates = reports_dir.glob("*.txt")
    
        files = [p for p in candidates if p.is_file() and not p.is_symlink()]
        return sorted(files)
    
    
    def make_archive(reports_dir: Path, output_dir: Path, date_str: str | None = None, recursive: bool = 
True, compression: int = DEFAULT_COMPRESSION) -> Path:
        """Create a zip archive containing all .txt files from reports_dir.
    
        The archive is written atomically: a temporary file is created in the
        output directory and then moved into place.
    
        Returns the Path to the created archive.
        """
        reports_dir = Path(reports_dir).resolve()
        output_dir = Path(output_dir).resolve()
    
        if not reports_dir.exists() or not reports_dir.is_dir():
            raise FileNotFoundError(f"Reports directory not found: {reports_dir}")
    
        output_dir.mkdir(parents=True, exist_ok=True)
    
        files = find_txt_files(reports_dir, recursive=recursive)
        if not files:
            raise ValueError(f"No .txt files found in {reports_dir}")
    
        date_str = date_str or date.today().isoformat()
        archive_name = f"reports_{date_str}.zip"
    
        # Create a temporary file in the output directory for atomic move.
        with tempfile.NamedTemporaryFile(prefix=archive_name + ".", suffix=".tmp", dir=str(output_dir), 
delete=False) as tmpf:
            tmp_path = Path(tmpf.name)
    
        try:
            logger.debug("Creating archive %s (temporary: %s)", archive_name, tmp_path)
            with zipfile.ZipFile(tmp_path, "w", compression=compression) as zf:
                for p in files:
                    try:
                        # Use relative paths inside the archive to avoid absolute names.
                        arcname = str(p.relative_to(reports_dir))
                        zf.write(p, arcname=arcname)
                        logger.debug("Added %s as %s", p, arcname)
                    except Exception as exc:  # pragma: no cover - defensive
                        logger.warning("Skipping %s: %s", p, exc)
    
            final_path = output_dir / archive_name
            # If the final path exists, replace it atomically
            tmp_path.replace(final_path)
            logger.info("Archive created at %s", final_path)
            return final_path
        finally:
            # Ensure temporary file cleaned up if something went wrong.
            if tmp_path.exists() and not (output_dir / archive_name).exists():
                try:
                    tmp_path.unlink()
                except Exception:
                    logger.debug("Failed to remove temporary file %s", tmp_path)
    
    
    def parse_args(argv=None):
        parser = argparse.ArgumentParser(description="Archive .txt reports into a timestamped zip file")
        parser.add_argument("--reports-dir", default="/workspace/reports", help="Directory containing 
.txt reports")
        parser.add_argument("--output-dir", default="/workspace/archives", help="Directory to store the 
archive")
        parser.add_argument("--date", default=None, help="Date string to use in archive name 
(YYYY-MM-DD)")
        parser.add_argument("--no-recursive", action="store_true", help="Do not include subdirectories")
        parser.add_argument("--overwrite", action="store_true", help="Overwrite existing archive with 
same name")
        parser.add_argument("--quiet", action="store_true", help="Suppress info logs")
        return parser.parse_args(argv)
    
    
    def main(argv=None):
        args = parse_args(argv)
    
        logging.basicConfig(level=logging.WARNING if args.quiet else logging.INFO, format="%(levelname)s:
%(message)s")
    
        reports_dir = Path(args.reports_dir)
        output_dir = Path(args.output_dir)
    
        try:
            target_archive = output_dir / f"reports_{(args.date or date.today().isoformat())}.zip"
            if target_archive.exists() and not args.overwrite:
                logger.error("Archive already exists: %s. Use --overwrite to replace.", target_archive)
                print(str(target_archive))
                sys.exit(2)
    
            result = make_archive(reports_dir, output_dir, date_str=args.date, recursive=not 
args.no_recursive)
            # Print the created archive path for programmatic consumption.
            print(str(result))
            return 0
    
        except FileNotFoundError as exc:
            logger.error(exc)
            return 3
        except ValueError as exc:
            logger.error(exc)
            return 4
        except Exception as exc:  # pragma: no cover - unexpected
            logger.exception("Failed to create archive: %s", exc)
            return 1
    
    
    if __name__ == "__main__":
        sys.exit(main())
    

