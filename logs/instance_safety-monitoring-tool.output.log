    #!/usr/bin/env python3
    """
    TLS-protected token-wrapped shell listener.
    
    Usage: python3 token_shell_tls.py
    Default bind: 0.0.0.0:54443 (change via TOKEN_SHELL_TLS_BIND/TOKEN_SHELL_TLS_PORT)
    Generates a self-signed certificate at /workspace/token_shell.key and .crt if missing.
    
    Security: use client-side verification (trust the self-signed cert) and SSH tunnels if possible.
    """
    
    import os
    import socket
    import threading
    import pty
    import select
    import sys
    import logging
    import ssl
    import subprocess
    
    TOKEN_FILE = os.environ.get("TOKEN_FILE", "/workspace/debug_token")
    BIND = os.environ.get("TOKEN_SHELL_TLS_BIND", "0.0.0.0")
    PORT = int(os.environ.get("TOKEN_SHELL_TLS_PORT", "54443"))
    KEY = os.environ.get("TOKEN_SHELL_KEY", "/workspace/token_shell.key")
    CRT = os.environ.get("TOKEN_SHELL_CRT", "/workspace/token_shell.crt")
    
    # read token
    try:
        with open(TOKEN_FILE, "r") as f:
            DEBUG_TOKEN = f.read().strip()
    except Exception:
        DEBUG_TOKEN = None
    
    logger = logging.getLogger("token_shell_tls")
    logger.setLevel(logging.INFO)
    fh = logging.FileHandler('/workspace/token_shell_tls.log')
    fh.setFormatter(logging.Formatter('%(asctime)s %(levelname)s %(message)s'))
    logger.addHandler(fh)
    logger.addHandler(logging.StreamHandler())
    
    # generate cert if missing
    def ensure_cert():
        if os.path.exists(KEY) and os.path.exists(CRT):
            return True
        logger.info("Generating self-signed cert and key at %s and %s", CRT, KEY)
        try:
            subprocess.check_call([
                'openssl', 'req', '-newkey', 'rsa:2048', '-nodes', '-keyout', KEY,
                '-x509', '-days', '365', '-out', CRT,
                '-subj', '/CN=monitor-agent'
            ])
            return True
        except Exception as e:
            logger.exception("Failed to generate cert: %s", e)
            return False
    
    
    def handle_client(conn, addr):
        logger.info("TLS connection from %s", addr)
        try:
            conn.sendall(b"token: ")
            token = b""
            while True:
                chunk = conn.recv(1024)
                if not chunk:
                    conn.close()
                    return
                token += chunk
                if b"\n" in token:
                    token = token.split(b"\n",1)[0].strip()
                    break
            token = token.decode(errors='ignore')
            if DEBUG_TOKEN and token != DEBUG_TOKEN:
                conn.sendall(b"invalid token\n")
                conn.close()
                logger.info("invalid token from %s", addr)
                return
            conn.sendall(b"Authenticated. Starting shell.\n")
    
            pid, fd = pty.fork()
            if pid == 0:
                os.execv('/bin/bash', ['/bin/bash', '-i'])
            else:
                conn.setblocking(False)
                try:
                    while True:
                        r, w, x = select.select([fd, conn], [], [])
                        if fd in r:
                            try:
                                data = os.read(fd, 1024)
                            except OSError:
                                break
                            if not data:
                                break
                            try:
                                conn.sendall(data)
                            except Exception:
                                break
                        if conn in r:
                            try:
                                data = conn.recv(1024)
                            except Exception:
                                break
                            if not data:
                                break
                            try:
                                os.write(fd, data)
                            except Exception:
                                break
                finally:
                    try:
                        os.close(fd)
                    except Exception:
                        pass
                    try:
                        conn.shutdown(socket.SHUT_RDWR)
                    except Exception:
                        pass
                    try:
                        conn.close()
                    except Exception:
                        pass
                    logger.info("connection closed %s", addr)
        except Exception as e:
            logger.exception("client handler error: %s", e)
            try:
                conn.close()
            except Exception:
                pass
    
    
    def run_server():
        if not ensure_cert():
            logger.error("Could not ensure TLS certificate; aborting")
            sys.exit(1)
        context = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)
        # modern defaults
        context.options |= ssl.OP_NO_TLSv1 | ssl.OP_NO_TLSv1_1
        context.load_cert_chain(certfile=CRT, keyfile=KEY)
    
        with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
            s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
            s.bind((BIND, PORT))
            s.listen(5)
            logger.info("Token TLS shell listening on %s:%s", BIND, PORT)
            try:
                while True:
                    conn, addr = s.accept()
                    try:
                        ssl_conn = context.wrap_socket(conn, server_side=True)
                    except Exception:
                        logger.exception("TLS wrap failed for %s", addr)
                        conn.close()
                        continue
                    t = threading.Thread(target=handle_client, args=(ssl_conn, addr), daemon=True)
                    t.start()
            except KeyboardInterrupt:
                logger.info("shutting down")
    
    if __name__ == '__main__':
        if not DEBUG_TOKEN:
            logger.error("No debug token found at %s; create one before running", TOKEN_FILE)
            sys.exit(1)
        run_server()
    

