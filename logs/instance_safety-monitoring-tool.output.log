    #!/usr/bin/env python3
    """
    Token-wrapped netcat-like listener.
    
    Accepts a token line as the first line sent by the client. If token matches
    then spawns an interactive bash shell connected to the socket using a pty.
    
    Usage: python3 token_shell.py
    Default bind: 127.0.0.1:54321 (change via environment TOKEN_SHELL_BIND/TOKEN_SHELL_PORT)
    
    Security: bind to localhost and use SSH tunnels for remote access. The token
    is stored at /workspace/debug_token and is required to authenticate.
    """
    
    import os
    import socket
    import threading
    import pty
    import select
    import sys
    import logging
    
    TOKEN_FILE = os.environ.get("TOKEN_FILE", "/workspace/debug_token")
    BIND = os.environ.get("TOKEN_SHELL_BIND", "127.0.0.1")
    PORT = int(os.environ.get("TOKEN_SHELL_PORT", "54321"))
    
    # read token
    try:
        with open(TOKEN_FILE, "r") as f:
            DEBUG_TOKEN = f.read().strip()
    except Exception:
        DEBUG_TOKEN = None
    
    logger = logging.getLogger("token_shell")
    logger.setLevel(logging.INFO)
    logger.addHandler(logging.StreamHandler())
    
    def handle_client(conn, addr):
        logger.info("connection from %s", addr)
        try:
            conn.sendall(b"token: ")
            token = b""
            # read until newline
            while True:
                chunk = conn.recv(1024)
                if not chunk:
                    conn.close()
                    return
                token += chunk
                if b"\n" in token:
                    token = token.split(b"\n",1)[0].strip()
                    break
            token = token.decode(errors='ignore')
            if DEBUG_TOKEN and token != DEBUG_TOKEN:
                conn.sendall(b"invalid token\n")
                conn.close()
                logger.info("invalid token from %s", addr)
                return
            conn.sendall(b"Authenticated. Starting shell.\n")
    
            # fork a pty and spawn bash
            pid, fd = pty.fork()
            if pid == 0:
                # child
                os.execv('/bin/bash', ['/bin/bash', '-i'])
            else:
                # parent: bridge between fd and socket
                conn.setblocking(False)
                try:
                    while True:
                        r, w, x = select.select([fd, conn], [], [])
                        if fd in r:
                            try:
                                data = os.read(fd, 1024)
                            except OSError:
                                break
                            if not data:
                                break
                            try:
                                conn.sendall(data)
                            except Exception:
                                break
                        if conn in r:
                            try:
                                data = conn.recv(1024)
                            except Exception:
                                break
                            if not data:
                                break
                            try:
                                os.write(fd, data)
                            except Exception:
                                break
                finally:
                    try:
                        os.close(fd)
                    except Exception:
                        pass
                    try:
                        conn.close()
                    except Exception:
                        pass
                    logger.info("connection closed %s", addr)
        except Exception as e:
            logger.exception("client handler error: %s", e)
            try:
                conn.close()
            except Exception:
                pass
    
    
    def run_server():
        with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
            s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
            s.bind((BIND, PORT))
            s.listen(5)
            logger.info("Token shell listening on %s:%s", BIND, PORT)
            try:
                while True:
                    conn, addr = s.accept()
                    t = threading.Thread(target=handle_client, args=(conn, addr), daemon=True)
                    t.start()
            except KeyboardInterrupt:
                logger.info("shutting down")
    
    if __name__ == '__main__':
        if not DEBUG_TOKEN:
            logger.error("No debug token found at %s; create one before running", TOKEN_FILE)
            sys.exit(1)
        run_server()
    

