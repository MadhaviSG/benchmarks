    #!/usr/bin/env bash
    set -e
    cd "$(dirname "$0")"
    
    start_if_not_running() {
      local pidfile="$1"
      shift
      local cmd="$@"
      if [ -f "$pidfile" ]; then
        pid="$(cat "$pidfile" 2>/dev/null || true)"
        if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
          echo "$cmd already running with PID $pid"
          return
        fi
      fi
      nohup $cmd >> /workspace/$(basename "$cmd" | sed 's/[^a-zA-Z0-9_.-]/_/g').log 2>&1 &
      echo $! > "$pidfile"
      echo "Started $cmd with PID $(cat "$pidfile")"
    }
    
    start_if_not_running /workspace/monitor_agent.pid python3 /workspace/monitor_agent.py
