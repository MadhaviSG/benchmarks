Summary: Create alert agent to monitor CPU/mem/disk and post to Rocket.Chat webhook

Action: FileEditorAction

Arguments:
  command: "create"
  path: "/workspace/alert_agent.py"
  file_text: 
    #!/usr/bin/env python3
    """
    Lightweight alert agent: checks CPU, memory, and disk thresholds
    and posts alerts to a Rocket.Chat incoming webhook (if provided).
    
    Configuration via environment:
    - ALERT_INTERVAL (seconds, default 15)
    - CPU_THRESHOLD (percent, default 80)
    - MEM_THRESHOLD (percent, default 80)
    - DISK_THRESHOLD (percent, default 90) (checks root mount)
    - ROCKETCHAT_WEBHOOK (incoming webhook URL, optional)
    - ALERT_LOG (path to local alert log)
    - ALERT_THROTTLE (seconds between repeated alerts per metric)
    """
    
    import os
    import time
    import logging
    import json
    
    try:
        import psutil
        import requests
    except Exception:
        psutil = None
        requests = None
    
    ALERT_INTERVAL = int(os.environ.get('ALERT_INTERVAL', '15'))
    CPU_THRESHOLD = float(os.environ.get('CPU_THRESHOLD', '80.0'))
    MEM_THRESHOLD = float(os.environ.get('MEM_THRESHOLD', '80.0'))
    DISK_THRESHOLD = float(os.environ.get('DISK_THRESHOLD', '90.0'))
    ROCKETCHAT_WEBHOOK = os.environ.get('ROCKETCHAT_WEBHOOK')
    ALERT_LOG = os.environ.get('ALERT_LOG', '/workspace/alert_agent.log')
    ALERT_THROTTLE = int(os.environ.get('ALERT_THROTTLE', '300'))
    
    logger = logging.getLogger('alert_agent')
    logger.setLevel(logging.INFO)
    fh = logging.FileHandler(ALERT_LOG)
    fh.setFormatter(logging.Formatter('%(asctime)s %(levelname)s %(message)s'))
    logger.addHandler(fh)
    logger.addHandler(logging.StreamHandler())
    
    last_alert = {}
    
    
    def send_alert(text):
        logger.warning('ALERT: %s', text)
        payload = {"text": text}
        if ROCKETCHAT_WEBHOOK and requests is not None:
            try:
                r = requests.post(ROCKETCHAT_WEBHOOK, json=payload, timeout=10)
                if r.status_code >= 400:
                    logger.warning('Rocket.Chat webhook returned %s: %s', r.status_code, r.text)
            except Exception as e:
                logger.exception('Sending to Rocket.Chat failed: %s', e)
    
    
    def should_alert(key):
        now = time.time()
        last = last_alert.get(key, 0)
        if now - last >= ALERT_THROTTLE:
            last_alert[key] = now
            return True
        return False
    
    
    def check_once():
        if psutil is None:
            logger.error('psutil or requests not installed; alert_agent not functional')
            return
        try:
            cpu = psutil.cpu_percent(interval=1)
            mem = psutil.virtual_memory()
            disk = psutil.disk_usage('/')
            if cpu >= CPU_THRESHOLD and should_alert('cpu'):
                send_alert(f'High CPU: {cpu}% (threshold {CPU_THRESHOLD}%)')
            if mem.percent >= MEM_THRESHOLD and should_alert('mem'):
                send_alert(f'High memory: {mem.percent}% used ({mem.used} bytes)')
            if disk.percent >= DISK_THRESHOLD and should_alert('disk'):
                send_alert(f'High disk: {disk.percent}% used on / (threshold {DISK_THRESHOLD}%)')
        except Exception as e:
            logger.exception('check_once failed: %s', e)
    
    
    def main():
        logger.info('Starting alert_agent: interval=%s cpu=%s mem=%s disk=%s', ALERT_INTERVAL, 
CPU_THRESHOLD, MEM_THRESHOLD, DISK_THRESHOLD)
        try:
            while True:
                check_once()
                time.sleep(ALERT_INTERVAL)
        except KeyboardInterrupt:
            logger.info('Shutting down alert_agent')
    
    if __name__ == '__main__':
        main()
    

