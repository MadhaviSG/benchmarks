    #!/usr/bin/env python3
    """
    Lightweight monitoring agent for staging.
    
    - Exposes Prometheus metrics on /metrics
    - Collects CPU, memory, disk, load, process count
    - Optional URL checks (latency + status)
    - Optional debug HTTP endpoint (exec commands + tail logs). Requires a token.
    
    Security notes:
    - Debug exec endpoint can execute commands. By default it binds to 127.0.0.1.
    - If you need remote access, create an SSH tunnel or set BIND_ADDR carefully.
    - You can restrict allowed commands via ALLOWED_CMDS environment variable.
    """
    
    import os
    import sys
    import time
    import json
    import shlex
    import secrets
    import threading
    import logging
    import subprocess
    import socketserver
    import http.server
    from urllib.parse import urlparse, parse_qs
    
    # optional third-party libs
    try:
        import psutil
    except Exception:
        psutil = None
    
    try:
        from prometheus_client import Gauge, start_http_server
    except Exception:
        Gauge = None
        start_http_server = None
    
    try:
        import requests
    except Exception:
        requests = None
    
    # Configuration via environment
    METRICS_PORT = int(os.environ.get("METRICS_PORT", "9091"))
    DEBUG_PORT = int(os.environ.get("DEBUG_PORT", "9092"))
    BIND_ADDR = os.environ.get("BIND_ADDR", "127.0.0.1")
    INTERVAL = int(os.environ.get("INTERVAL", "10"))
    LOG_FILE = os.environ.get("LOG_FILE", "/workspace/monitor_agent.log")
    TOKEN_FILE = os.environ.get("TOKEN_FILE", "/workspace/debug_token")
    ALLOWED_CMDS = os.environ.get("ALLOWED_CMDS")  # comma separated list
    URLS = os.environ.get("CHECK_URLS")  # comma separated
    
    if psutil is None or Gauge is None:
        sys.stderr.write("Missing required packages. Please install requirements (prometheus_client, 
psutil, requests recommended).\n")
        sys.exit(1)
    
    # set up logging
    logger = logging.getLogger("monitor_agent")
    logger.setLevel(logging.INFO)
    fh = logging.FileHandler(LOG_FILE)
    fh.setLevel(logging.INFO)
    formatter = logging.Formatter('%(asctime)s %(levelname)s %(message)s')
    fh.setFormatter(formatter)
    logger.addHandler(fh)
    # also console
    ch = logging.StreamHandler()
    ch.setFormatter(formatter)
    logger.addHandler(ch)
    
    # create or load debug token
    if os.path.exists(TOKEN_FILE):
        try:
            with open(TOKEN_FILE, "r") as f:
                DEBUG_TOKEN = f.read().strip()
        except Exception:
            DEBUG_TOKEN = None
    else:
        DEBUG_TOKEN = os.environ.get("DEBUG_TOKEN")
        if not DEBUG_TOKEN:
            DEBUG_TOKEN = secrets.token_urlsafe(24)
            try:
                with open(TOKEN_FILE, "w") as f:
                    f.write(DEBUG_TOKEN)
                os.chmod(TOKEN_FILE, 0o600)
            except Exception as e:
                logger.warning("Could not write token file: %s", e)
    
    if ALLOWED_CMDS:
        ALLOWED_CMDS_SET = set([c.strip() for c in ALLOWED_CMDS.split(",") if c.strip()])
    else:
        ALLOWED_CMDS_SET = None
    
    if URLS:
        WATCH_URLS = [u.strip() for u in URLS.split(",") if u.strip()]
    else:
        WATCH_URLS = []
    
    # Prometheus metrics
    g_cpu = Gauge('agent_cpu_percent','System CPU percent')
    g_mem_percent = Gauge('agent_mem_percent','System memory percent')
    g_mem_used = Gauge('agent_mem_used_bytes','System memory used bytes')
    g_disk_pct = Gauge('agent_disk_percent','Disk percent used', ['mount'])
    g_procs = Gauge('agent_process_count','Number of processes')
    g_load1 = Gauge('agent_loadavg_1','Load average 1')
    g_http_latency = Gauge('agent_http_check_latency_seconds','HTTP check latency', ['url','status'])
    
    
    def collect_once():
        try:
            # cpu_percent waits for interval if provided; we use a short blocking call
            g_cpu.set(psutil.cpu_percent(interval=1))
        except Exception as e:
            logger.exception("cpu read failed: %s", e)
        try:
            vm = psutil.virtual_memory()
            g_mem_percent.set(vm.percent)
            g_mem_used.set(vm.used)
        except Exception as e:
            logger.exception("mem read failed: %s", e)
        try:
            for part in psutil.disk_partitions(all=False):
                try:
                    usage = psutil.disk_usage(part.mountpoint)
                    g_disk_pct.labels(mount=part.mountpoint).set(usage.percent)
                except Exception:
                    # permissions or special mounts
                    continue
        except Exception as e:
            logger.exception("disk read failed: %s", e)
        try:
            g_procs.set(len(psutil.pids()))
        except Exception as e:
            logger.exception("proc count failed: %s", e)
        try:
            load1, load5, load15 = os.getloadavg()
            g_load1.set(load1)
        except Exception as e:
            logger.exception("loadavg failed: %s", e)
    
        # HTTP checks (optional)
        if WATCH_URLS:
            if requests is None:
                logger.warning("requests not installed; skipping URL checks")
            else:
                for url in WATCH_URLS:
                    try:
                        start_ts = time.time()
                        r = requests.get(url, timeout=5)
                        latency = time.time() - start_ts
                        status = str(r.status_code)
                        g_http_latency.labels(url=url,status=status).set(latency)
                    except Exception as e:
                        logger.warning("url check failed for %s: %s", url, e)
                        # mark as error
                        g_http_latency.labels(url=url,status="error").set(0)
    
    
    def collector_loop(stop_event):
        logger.info("Starting collector loop: interval=%s", INTERVAL)
        while not stop_event.is_set():
            try:
                collect_once()
            except Exception:
                logger.exception("collect_once exception")
            stop_event.wait(INTERVAL)
    
    # Debug HTTP server
    class DebugHandler(http.server.BaseHTTPRequestHandler):
        server_version = "MonitorAgent/0.1"
    
        def _send_json(self, data, code=200):
            payload = json.dumps(data).encode('utf-8')
            self.send_response(code)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(payload)))
            self.end_headers()
            self.wfile.write(payload)
    
        def _authenticate(self):
            length = int(self.headers.get("Content-Length", 0))
            if length == 0:
                return False, "no body"
            body = self.rfile.read(length)
            try:
                j = json.loads(body)
            except Exception:
                return False, "invalid json"
            token = j.get("token")
            if not token:
                return False, "missing token"
            if token != DEBUG_TOKEN:
                return False, "invalid token"
            return True, j
    
        def do_POST(self):
            if self.path == "/exec":
                ok, payload = self._authenticate()
                if not ok:
                    self._send_json({"error": payload}, code=401)
                    return
                cmd = payload.get("cmd")
                if not cmd:
                    self._send_json({"error":"missing cmd"}, code=400)
                    return
                args = shlex.split(cmd)
                if ALLOWED_CMDS_SET and args and args[0] not in ALLOWED_CMDS_SET:
                    self._send_json({"error":"command not allowed"}, code=403)
                    return
                logger.info("Executing debug command: %s", cmd)
                try:
                    proc = subprocess.run(args, stdout=subprocess.PIPE, stderr=subprocess.PIPE, 
timeout=60, check=False)
                    out = proc.stdout.decode('utf-8', errors='replace')
                    err = proc.stderr.decode('utf-8', errors='replace')
                    res = {"returncode": proc.returncode, "stdout": out, "stderr": err}
                    self._send_json(res, code=200)
                except Exception as e:
                    logger.exception("exec failed")
                    self._send_json({"error": str(e)}, code=500)
                return
            else:
                self._send_json({"error": "unknown endpoint"}, code=404)
    
        def do_GET(self):
            parsed = urlparse(self.path)
            if parsed.path == "/logs":
                qs = parse_qs(parsed.query)
                lines = int(qs.get("lines", ["200"])[0])
                try:
                    data = tail_file(LOG_FILE, lines)
                    self._send_json({"lines": data})
                except Exception as e:
                    self._send_json({"error": str(e)}, code=500)
                return
            elif parsed.path == "/health":
                self._send_json({"status":"ok"})
                return
            else:
                self._send_json({"error":"unknown endpoint"}, code=404)
    
    
    def tail_file(path, n):
        # simple tail implementation
        with open(path, "rb") as f:
            avg_line = 75
            to_read = n * avg_line
            try:
                f.seek(-to_read, os.SEEK_END)
            except Exception:
                f.seek(0)
            data = f.read().decode('utf-8', errors='replace').splitlines()
            return data[-n:]
    
    
    def run_debug_server(bind_addr, port):
        class ThreadingHTTPServer(socketserver.ThreadingTCPServer):
            allow_reuse_address = True
        server = ThreadingHTTPServer((bind_addr, port), DebugHandler)
        logger.info("Debug HTTP server listening on %s:%s (token saved at %s). Bind to 0.0.0.0 only if 
you know what you are doing.", bind_addr, port, TOKEN_FILE)
        try:
            server.serve_forever()
        except Exception:
            logger.exception("debug server stopped")
    
    
    def main():
        stop_event = threading.Event()
        # start prometheus metrics server
        logger.info("Starting Prometheus metrics server on %s:%s", BIND_ADDR, METRICS_PORT)
        start_http_server(METRICS_PORT, addr=BIND_ADDR)
        # start collector
        t = threading.Thread(target=collector_loop, args=(stop_event,), daemon=True)
        t.start()
        # start debug server
        dbg_thread = threading.Thread(target=run_debug_server, args=(BIND_ADDR, DEBUG_PORT), daemon=True)
        dbg_thread.start()
        logger.info("Agent started. Debug token saved at %s", TOKEN_FILE)
        try:
            while True:
                time.sleep(1)
        except KeyboardInterrupt:
            logger.info("Shutting down agent")
            stop_event.set()
    
    if __name__ == "__main__":
        main()
    

