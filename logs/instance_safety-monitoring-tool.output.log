    #!/usr/bin/env python3
    """
    Simple token-authenticated log streamer.
    GET /stream_logs?file=/path&lines=200&token=xxx
    Streams appended lines (like tail -f). Bind to 127.0.0.1:9093 by default.
    """
    
    import os
    import time
    import urllib.parse
    import socketserver
    import http.server
    import logging
    
    LOG_FILE_DEFAULT = "/workspace/monitor_agent.log"
    TOKEN_FILE = "/workspace/debug_token"
    HOST = os.environ.get("LOG_STREAM_BIND", "127.0.0.1")
    PORT = int(os.environ.get("LOG_STREAM_PORT", "9093"))
    
    # read token
    try:
        with open(TOKEN_FILE, "r") as f:
            DEBUG_TOKEN = f.read().strip()
    except Exception:
        DEBUG_TOKEN = None
    
    logger = logging.getLogger("log_streamer")
    logger.setLevel(logging.INFO)
    logger.addHandler(logging.StreamHandler())
    
    class StreamHandler(http.server.BaseHTTPRequestHandler):
    
        def do_GET(self):
            parsed = urllib.parse.urlparse(self.path)
            if parsed.path != "/stream_logs":
                self.send_response(404); self.end_headers(); return
            qs = urllib.parse.parse_qs(parsed.query)
            token = qs.get("token", [None])[0]
            if DEBUG_TOKEN and token != DEBUG_TOKEN:
                self.send_response(401); self.end_headers(); self.wfile.write(b"Unauthorized\n"); return
            file_path = qs.get("file", [LOG_FILE_DEFAULT])[0]
            try:
                lines = int(qs.get("lines", [200])[0])
            except:
                lines = 200
            if not os.path.exists(file_path):
                self.send_response(404); self.end_headers(); self.wfile.write(b"File not found\n"); 
return
            self.send_response(200)
            self.send_header("Content-Type", "text/plain; charset=utf-8")
            self.end_headers()
            # tail last N lines and follow
            try:
                with open(file_path, "rb") as f:
                    avg_line = 75
                    to_read = lines * avg_line
                    try:
                        f.seek(-to_read, os.SEEK_END)
                    except OSError:
                        f.seek(0)
                    data = f.read().decode("utf-8", errors="replace").splitlines()
                    to_send = data[-lines:]
                    for line in to_send:
                        self.wfile.write((line + "\n").encode('utf-8'))
                        self.wfile.flush()
                    # now follow file
                    f.seek(0, os.SEEK_END)
                    while True:
                        line = f.readline()
                        if not line:
                            time.sleep(0.5)
                            continue
                        self.wfile.write(line)
                        self.wfile.flush()
            except BrokenPipeError:
                return
            except Exception as e:
                logger.exception("streaming failed: %s", e)
                return
    
        def log_message(self, format, *args):
            return
    
    def run():
        class ThreadingHTTPServer(socketserver.ThreadingTCPServer):
            allow_reuse_address = True
        server = ThreadingHTTPServer((HOST, PORT), StreamHandler)
        logger.info("Log streamer listening on %s:%s (token auth)", HOST, PORT)
        try:
            server.serve_forever()
        except KeyboardInterrupt:
            pass
    
    if __name__ == "__main__":
        run()
    

