  file_text: 
    #!/usr/bin/env python3
    """
    Helper to create the GitLab project and push the local repo.
    Usage:
      GITLAB_TOKEN=your_token python3 create_remote_with_token.py
    or
      python3 create_remote_with_token.py your_token
    
    This script uses the /utils/common.make_gitlab_request helper to create
    projects so it follows the repository tooling.
    """
    import os
    import sys
    import subprocess
    import json
    
    # Insert utils path and import helper
    sys.path.insert(0, '/utils')
    try:
        import common
        from common import make_gitlab_request
    except Exception as e:
        print('ERROR importing /utils/common:', e)
        sys.exit(1)
    
    # Acquire token from env or CLI
    token = os.environ.get('GITLAB_TOKEN')
    if not token and len(sys.argv) > 1:
        token = sys.argv[1]
    if not token:
        print('ERROR: must provide GitLab token via GITLAB_TOKEN or first arg')
        sys.exit(2)
    
    # Set token in helper headers (case may vary: try common.GITLAB_HEADERS)
    try:
        # Use Private-Token header which GitLab accepts
        common.GITLAB_HEADERS = {'Private-Token': token}
    except Exception:
        pass
    
    # Create project
    params = {
        'name': 'docs-template-repo',
        'path': 'docs-template-repo',
        'visibility': 'public',
        'description': 'Centralized markdown documentation templates',
    }
    resp = make_gitlab_request(None, 'projects', method='POST', params=params)
    try:
        status = resp.status_code
    except Exception as e:
        print('ERROR: failed to call make_gitlab_request:', e)
        sys.exit(3)
    
    if status not in (200, 201):
        print('CREATE_FAILED', status)
        try:
            print(resp.text)
        except Exception:
            pass
        sys.exit(4)
    
    proj = resp.json()
    # Determine a pushable URL
    push_url = proj.get('http_url_to_repo') or proj.get('ssh_url_to_repo')
    if not push_url:
        print('Created project but could not determine repo URL:', proj)
        sys.exit(5)
    
    # Push local repo
    repo_dir = os.path.dirname(os.path.abspath(__file__))
    try:
        subprocess.check_call(['git', 'remote', 'add', 'origin', push_url], cwd=repo_dir)
    except subprocess.CalledProcessError:
        # remote may already exist
        pass
    
    subprocess.check_call(['git', 'push', '-u', 'origin', 'master'], cwd=repo_dir)
    print('SUCCESS: project created and pushed to', push_url)
    

  kind: "FileEditorAction"

