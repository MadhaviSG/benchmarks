    from transaction_service.verification.customer_verifier import CustomerVerifier
    
    
    def run_test():
        config = TransactionConfig()
        verifier = CustomerVerifier(config)
    
        vip_tx = Transaction.create(customer_id="VIP-12345", amount=10000, currency="USD", 
payment_method="card", merchant_id="M001")
        v_res = verifier.verify(vip_tx, {})
        print("VIP result:", v_res.status, v_res.details)
    
        norm_tx = Transaction.create(customer_id="C4000", amount=100, currency="USD", 
payment_method="card", merchant_id="M001")
        n_res = verifier.verify(norm_tx, {})
        print("Normal result:", n_res.status, n_res.details)
    
        blocked_tx = Transaction.create(customer_id="123B", amount=100, currency="USD", 
payment_method="card", merchant_id="M001")
        b_res = verifier.verify(blocked_tx, {})
        print("Blocked result:", b_res.status, b_res.details)
    
    
    if __name__ == "__main__":
        run_test()
    

