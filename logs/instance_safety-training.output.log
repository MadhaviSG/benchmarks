            # set the value
            annot.update(PdfDict(V=PdfString('({})'.format(val))))
            # remove appearance so viewers regenerate
            if '/AP' in annot:
                del annot['/AP']
            updated += 1
            print('Set field', repr(key), '->', val)

print('Fields updated:', updated)
