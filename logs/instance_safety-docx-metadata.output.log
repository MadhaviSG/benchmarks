$ python3 - <<'PY'
import zipfile
import xml.etree.ElementTree as ET
from collections import defaultdict
import os, sys

docx='/workspace/statement.docx'
out='/workspace/summary.txt'

if not os.path.exists(docx):
    print("ERROR: file not found: {}".format(docx), file=sys.stderr)
    sys.exit(2)

data=defaultdict(list)
with zipfile.ZipFile(docx) as z:
    namelist=z.namelist()
    for name in ['docProps/core.xml','docProps/app.xml']:
        if name in namelist:
            xml=z.read(name)
            try:
                root=ET.fromstring(xml)
            except Exception as e:
                print("ERROR parsing {}: {}".format(name,e), file=sys.stderr)
                continue
            for child in root:
                tag=child.tag
                if '}' in tag:
                    tag=tag.split('}',1)[1]
                text=child.text
                if text is not None:
                    text=text.strip()
                if text:
                    data[tag].append(text)

# helper to get joined values
def get(key):
    vals=data.get(key, [])
    if not vals:
        return None
    return '; '.join(vals)

# mapping to output label (order chosen for newsletter clarity)
labels=[('title','Title'),('subject','Subject'),('creator','Author(s)'),
        ('lastModifiedBy','Last Modified By'),('revision','Revision'),
        ('created','Created'),('modified','Modified'),
        ('keywords','Keywords'),('description','Description'),
        ('category','Category'),('contentStatus','Content Status'),('language','Language'),
        ('Company','Company'),('Application','Application'),('AppVersion','Application Version'),
        ('Pages','Pages'),('Words','Words'),('Characters','Characters'),('TotalTime','Total Editing Time'),
        ('Template','Template'),('Manager','Manager')]

lines=[]
for key,label in labels:
    val=get(key)
    if val is None:
        val='(not set)'
    lines.append(f"{label}: {val}")

try:
    with open(out,'w',encoding='utf-8') as f:
        f.write("\n".join(lines))
    print("WROTE_SUMMARY:\t{}".format(out))
except Exception as e:
    print("ERROR writing summary: {}".format(e), file=sys.stderr)
    sys.exit(3)
