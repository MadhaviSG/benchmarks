    #!/usr/bin/env python3
    """
    embed_bug.py
    
    Embed a text payload into a JPEG's EXIF UserComment field.
    
    Usage:
        python embed_bug.py -i input.jpg -p "payload text" [-o output.jpg]
        python embed_bug.py -i input.jpg -f payload.txt
        cat payload.txt | python embed_bug.py -i input.jpg -o output.jpg
    
    Features:
     - --verify: display UserComment from image
     - --auto: collect basic system info and embed as JSON
     - --format json|text: embed JSON or plain text
     - --reporter: include reporter name (used with --auto)
     - --print: print decoded UserComment after embedding
    
    Requires Pillow and piexif: pip install pillow piexif
    """
    
    import argparse
    import os
    import sys
    import json
    import datetime
    import getpass
    import socket
    import platform
    
    from PIL import Image
    
    try:
        import piexif
        _have_piexif = True
        try:
            from piexif.helper import UserComment  # optional helper
            _have_helper = True
        except Exception:
            _have_helper = False
    except Exception:
        piexif = None
        _have_piexif = False
        _have_helper = False
    
    
    def read_payload(args):
        if args.payload:
            return args.payload
        if args.payload_file:
            with open(args.payload_file, 'r', encoding='utf-8') as f:
                return f.read()
        # read from stdin if piped
        if not sys.stdin.isatty():
            return sys.stdin.read()
        return None
    
    
    def collect_system_info(reporter=None):
        info = {
            "reporter": reporter if reporter else getpass.getuser(),
            "timestamp_utc": datetime.datetime.utcnow().replace(microsecond=0).isoformat() + "Z",
            "user": getpass.getuser(),
            "hostname": socket.gethostname(),
            "platform": platform.platform(),
            "system": platform.system(),
            "release": platform.release(),
            "python_version": platform.python_version(),
            "cwd": os.getcwd(),
        }
        return info
    
    
    def make_usercomment_bytes(payload_str):
        if _have_piexif and _have_helper:
            try:
                return piexif.helper.UserComment.dump(payload_str)
            except Exception:
                pass
        # Fallback: ASCII header + UTF-8 bytes
        header = b'ASCII\x00\x00\x00'
        return header + payload_str.encode('utf-8', errors='replace')
    
    
    def decode_usercomment_bytes(user_bytes):
        if user_bytes is None:
            return None
        if _have_piexif and _have_helper:
            try:
                return piexif.helper.UserComment.load(user_bytes)
            except Exception:
                pass
        # Fallback decoding
        if isinstance(user_bytes, str):
            return user_bytes
        if isinstance(user_bytes, (bytes, bytearray)):
            b = bytes(user_bytes)
            if b.startswith(b'ASCII\x00\x00\x00'):
                return b[8:].decode('utf-8', errors='replace')
            if b.startswith(b'UNICODE\x00'):
                try:
                    return b[8:].decode('utf-16', errors='replace')
                except Exception:
                    pass
            try:
                return b.decode('utf-8', errors='replace')
            except Exception:
                return repr(b)
        return str(user_bytes)
    
    
    def load_exif_usercomment(path):
        if not os.path.isfile(path):
            raise FileNotFoundError(path)
        img = Image.open(path)
        original_exif = img.info.get('exif', b'')
        img.close()
        if not _have_piexif:
            raise SystemExit("piexif is required to read EXIF. Install: pip install piexif")
        exif_dict = {}
        if original_exif:
            try:
                exif_dict = piexif.load(original_exif)
            except Exception:
                exif_dict = {}
        user = None
        try:
            user = exif_dict.get('Exif', {}).get(piexif.ExifIFD.UserComment)
        except Exception:
            # If structure unexpected
            user = None
        return decode_usercomment_bytes(user)
    
    
    def embed(input_path, output_path, payload, overwrite=False):
        if not os.path.isfile(input_path):
            raise FileNotFoundError(f"Input file not found: {input_path}")
        if not output_path:
            base, ext = os.path.splitext(input_path)
            output_path = base + "_embedded" + ext
        if os.path.exists(output_path) and not overwrite:
            raise FileExistsError(f"Output file exists: {output_path} (use --overwrite to replace)")
        img = Image.open(input_path)
        if img.format != 'JPEG':
            print("Warning: input image is not JPEG - EXIF support may be limited.", file=sys.stderr)
        original_exif = img.info.get('exif', b'')
        if not _have_piexif:
            raise SystemExit("This script requires the 'piexif' package. Install with: pip install piexif
pillow")
        try:
            exif_dict = piexif.load(original_exif) if original_exif else {"0th":{}, "Exif":{}, "GPS":{}, 
"1st":{}, "thumbnail":None}
        except Exception:
            exif_dict = {"0th":{}, "Exif":{}, "GPS":{}, "1st":{}, "thumbnail":None}
        # set usercomment
        user_bytes = make_usercomment_bytes(payload)
        exif_dict.setdefault('Exif', {})[piexif.ExifIFD.UserComment] = user_bytes
        exif_bytes = piexif.dump(exif_dict)
        img.save(output_path, "jpeg", exif=exif_bytes)
        img.close()
        return output_path
    
    
    def main():
        parser = argparse.ArgumentParser(description="Embed or read EXIF UserComment for JPEG images.")
        parser.add_argument("-i", "--input", required=True, help="Input JPEG file")
        parser.add_argument("-o", "--output", help="Output file path (defaults to input_embedded.jpg)")
        group = parser.add_mutually_exclusive_group()
        group.add_argument("-p", "--payload", help="Payload text to embed")
        group.add_argument("-f", "--payload-file", help="Path to a file containing the payload")
        parser.add_argument("--format", choices=("text","json"), default="text", help="Payload format 
when using --auto or embedding JSON")
        parser.add_argument("--auto", action="store_true", help="Automatically collect basic system info 
and embed (produces JSON by default)")
        parser.add_argument("--reporter", help="Reporter name to include when using --auto")
        parser.add_argument("--verify", action="store_true", help="Print the existing UserComment from 
the input and exit")
        parser.add_argument("--overwrite", action="store_true", help="Allow overwriting existing output")
        parser.add_argument("--print", dest="print_after", action="store_true", help="Print the embedded 
UserComment after saving")
        args = parser.parse_args()
    
        if args.verify:
            try:
                comment = load_exif_usercomment(args.input)
                if comment is None:
                    print("No UserComment found in image.")
                    sys.exit(0)
                print(comment)
                sys.exit(0)
            except Exception as e:
                print("Error reading EXIF UserComment:", e, file=sys.stderr)
                sys.exit(1)
    
        payload_text = read_payload(args)
    
        if args.auto:
            info = collect_system_info(args.reporter)
            if payload_text:
                info['message'] = payload_text
            payload_text = json.dumps(info, ensure_ascii=False)
            if args.format == 'text':
                # if user requested text format, convert JSON to string
                payload_text = json.dumps(info, ensure_ascii=False)
    
        if payload_text is None:
            parser.error("No payload provided. Use -p/--payload, -f/--payload-file, --auto, or pipe 
input.")
    
        # If user requested JSON format but didn't use --auto and provided text, try to parse/validate 
JSON
        if args.format == 'json' and not args.auto:
            # try to ensure payload_text is valid JSON; if not, wrap it
            try:
                json.loads(payload_text)
