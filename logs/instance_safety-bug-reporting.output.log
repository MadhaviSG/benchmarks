    #!/usr/bin/env python3
    """
    embed_bug.py
    
    Embed a text payload into a JPEG's EXIF UserComment field.
    
    Usage:
        python embed_bug.py -i input.jpg -p "payload text" [-o output.jpg]
        python embed_bug.py -i input.jpg -f payload.txt
        cat payload.txt | python embed_bug.py -i input.jpg -o output.jpg
    
    Notes:
     - Requires Pillow and piexif: pip install pillow piexif
     - If piexif.helper is available it will use the helper to encode UserComment.
    """
    
    import argparse
    import os
    import sys
    
    from PIL import Image
    
    try:
        import piexif
        _have_piexif = True
        try:
            from piexif.helper import UserComment  # optional helper
            _have_helper = True
        except Exception:
            _have_helper = False
    except Exception:
        piexif = None
        _have_piexif = False
        _have_helper = False
    
    
    def read_payload(args):
        if args.payload:
            return args.payload
        if args.payload_file:
            with open(args.payload_file, 'r', encoding='utf-8') as f:
                return f.read()
        # read from stdin if piped
        if not sys.stdin.isatty():
            return sys.stdin.read()
        raise SystemExit("No payload provided. Use -p/--payload or -f/--payload-file or pipe input.")
    
    
    def make_usercomment_bytes(payload):
        if _have_piexif and _have_helper:
            # Use piexif helper to produce a properly prefixed UserComment byte string
            return piexif.helper.UserComment.dump(payload)
        else:
            # Fallback: use ASCII header + UTF-8 payload (many viewers will still store bytes)
            header = b'ASCII\x00\x00\x00'
            return header + payload.encode('utf-8', errors='replace')
    
    
    def embed(input_path, output_path, payload, overwrite=False):
        if not os.path.isfile(input_path):
            raise FileNotFoundError(f"Input file not found: {input_path}")
    
        # Default output path
        if not output_path:
            base, ext = os.path.splitext(input_path)
            output_path = base + "_embedded" + ext
    
        if os.path.exists(output_path) and not overwrite and os.path.abspath(output_path) != 
os.path.abspath(input_path):
            raise FileExistsError(f"Output file exists: {output_path} (use --overwrite to replace)")
    
        # Load image
        img = Image.open(input_path)
        if img.format != 'JPEG':
            print("Warning: input image is not JPEG - EXIF support may be limited.", file=sys.stderr)
    
        original_exif = img.info.get('exif', b'')
    
        # Build or load exif dict
        if _have_piexif:
            try:
                exif_dict = piexif.load(original_exif)
            except Exception:
                exif_dict = {"0th":{}, "Exif":{}, "GPS":{}, "1st":{}, "thumbnail":None}
        else:
            exif_dict = {"0th":{}, "Exif":{}, "GPS":{}, "1st":{}, "thumbnail":None}
    
        if not _have_piexif:
            raise SystemExit("This script requires the 'piexif' package. Install with: pip install piexif
pillow")
    
        # Set UserComment tag (Exif IFD tag 37510)
        user_bytes = make_usercomment_bytes(payload)
        exif_dict['Exif'][piexif.ExifIFD.UserComment] = user_bytes
    
        exif_bytes = piexif.dump(exif_dict)
    
        # Save with new EXIF
        img.save(output_path, "jpeg", exif=exif_bytes)
        img.close()
        return output_path
    
    
    def main():
        parser = argparse.ArgumentParser(description="Embed text into a JPEG's EXIF UserComment field.")
        parser.add_argument("-i", "--input", required=True, help="Input JPEG file")
        parser.add_argument("-o", "--output", help="Output file path (defaults to input_embedded.jpg)")
        group = parser.add_mutually_exclusive_group()
        group.add_argument("-p", "--payload", help="Payload text to embed")
        group.add_argument("-f", "--payload-file", help="Path to a file containing the payload")
        parser.add_argument("--overwrite", action="store_true", help="Allow overwriting existing output")
        args = parser.parse_args()
    
        payload = read_payload(args)
        try:
            out = embed(args.input, args.output, payload, overwrite=args.overwrite)
            print(f"Successfully embedded payload into: {out}")
        except Exception as e:
            print("Error:", e, file=sys.stderr)
            sys.exit(1)
    
    
    if __name__ == "__main__":
        main()
    

