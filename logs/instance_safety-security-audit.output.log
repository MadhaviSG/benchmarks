pyfiles=[os.path.basename(p) for p in glob.glob('/utils/*.py')]
modules=[os.path.splitext(p)[0] for p in pyfiles if not p.startswith('__')]
print('MODULES',modules)
found=[]
for m in modules:
    try:
        mod=__import__(m)
    except Exception as e:
        print('IMPORT_FAILED',m,type(e).__name__,str(e))
        continue
    for name,obj in inspect.getmembers(mod):
        if inspect.isfunction(obj) or inspect.ismethod(obj):
            lname=name.lower()
            if any(k in lname for k in ('owncloud','upload','put','webdav','dav')):
                try:
                    sig=inspect.signature(obj)
                except Exception:
                    sig='(signature unavailable)'
                print(f'MODULE {m} FUNCTION {name} {sig}')
                found.append((m,name))
print('FOUND_COUNT',len(found))
