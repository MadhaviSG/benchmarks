    #!/usr/bin/env python3
    import os
    import csv
    import json
    from pathlib import Path
    
    # Try to import OwnCloud helpers from /utils
    check_and_download_file = None
    check_file_in_owncloud_directory = None
    try:
        import sys
        sys.path.insert(0, '/utils')
        from common import check_and_download_file, check_file_in_owncloud_directory
    except Exception as e:
        # Helpers not available or import failed; continue with local search only
        pass
    
    workspace = Path('/workspace')
    finances_csv = workspace / 'finances.csv'
    outdir = workspace / 'audit_docs'
    outdir.mkdir(parents=True, exist_ok=True)
    found_local = []
    found_owncloud = []
    
    entries = []
    if finances_csv.exists():
        with open(finances_csv, newline='') as f:
            reader = csv.DictReader(f)
            for r in reader:
                if r.get('creditor', '').strip().lower() == 'mark':
                    entries.append(r)
    
    # Normalize note
    def normalize_note(note):
        s = ''.join(c if c.isalnum() else '_' for c in note.strip().lower())
        parts = [p for p in s.split('_') if p]
        return '_'.join(parts)
    
    exts = ['.pdf', '.jpg', '.png', '.jpeg', '.docx', '.xlsx', '.csv', '.txt']
    
    candidates = []
    for e in entries:
        creditor = e['creditor']
        date = e['date']
        note = e.get('note', '')
        norm_note = normalize_note(note)
        base_names = [
            f"{creditor}_{date}_{norm_note}",
            f"{creditor}_{date}",
            f"{norm_note}_{creditor}_{date}",
            f"invoice_{creditor}_{date}",
            f"receipt_{creditor}_{date}",
            f"{creditor}_invoice_{date}",
            f"{creditor}_receipt_{date}",
            f"{creditor}_{date.replace('-','')}",
            f"{creditor}_{date.replace('-','')}_{norm_note}",
        ]
        for b in base_names:
            for ext in exts:
                candidates.append(b + ext)
    
    # dedupe candidates
    candidates = list(dict.fromkeys(candidates))
    
    # Local search by exact filename match
    for root, dirs, files in os.walk(workspace):
        for fname in files:
            # skip this script and known agent files
            if fname in ('gather_audit_docs.py', 'AGENTS.md') or fname.endswith('.sha256'):
                continue
            low = fname.lower()
            if low in (c.lower() for c in candidates):
                src = os.path.join(root, fname)
                dst = outdir / fname
                try:
                    import shutil
                    shutil.copy2(src, dst)
                    found_local.append(str(dst))
                except Exception:
                    pass
    
    # Local substring heuristic search
    for root, dirs, files in os.walk(workspace):
        for fname in files:
            low = fname.lower()
            for e in entries:
                date = e['date']
                creditor = e['creditor']
                note = e.get('note', '').lower()
                if creditor.lower() in low or date in low or any(w in low for w in note.split() if w):
                    src = os.path.join(root, fname)
                    dst = outdir / fname
                    if not dst.exists():
                        try:
                            import shutil
                            shutil.copy2(src, dst)
                            found_local.append(str(dst))
                        except Exception:
                            pass
    
    # Attempt OwnCloud checks/downloads if helpers present
    owncloud_dirs = ['/Documents', '/Receipts', '/Finances', '/Finance', '/Expenses', '/Invoices', '/']
    if check_file_in_owncloud_directory and check_and_download_file:
        for d in owncloud_dirs:
            for cand in candidates:
                try:
                    exists = check_file_in_owncloud_directory(cand, d)
                    if exists:
                        local_path = str(outdir / cand)
                        try:
                            check_and_download_file(cand, d, local_path)
                            found_owncloud.append(local_path)
                        except Exception:
                            found_owncloud.append(f"FOUND_BUT_DOWNLOAD_FAILED:{d}/{cand}")
                except Exception:
                    # ignore errors from the helper
                    pass
    
    found_local = list(dict.fromkeys(found_local))
    found_owncloud = list(dict.fromkeys(found_owncloud))
    
    summary = {
        'entries': entries,
        'found_local': found_local,
        'found_owncloud': found_owncloud,
        'outdir': str(outdir)
    }
    print(json.dumps(summary))
    

