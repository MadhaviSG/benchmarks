name_to_id = state_dicts[0] if state_dicts and isinstance(state_dicts, list) and len(state_dicts)>0 else {}
id_to_name = state_dicts[1] if state_dicts and isinstance(state_dicts, list) and len(state_dicts)>1 else {}

# find 'Done' id(s) - accept 'Done', 'Resolved', 'Approved'
done_state_ids = set()
for name, sid in name_to_id.items():
    if name.lower() in ('done','resolved','approved'):
        done_state_ids.add(sid)

# Also account for id->name mapping (if names are keys)
for sid, name in id_to_name.items():
    if name.lower() in ('done','resolved','approved'):
        done_state_ids.add(sid)

# If none found, consider 'Done' common name may not present; nothing to sync then

# Build list of plane 'done' issues
plane_done = []
for it in plane_issues:
    state = it.get('state')
    # state may be id or dict
    if isinstance(state, dict):
        state_id = state.get('id') or state.get('state')
    else:
        state_id = state
    if state_id in done_state_ids:
        plane_done.append({'id': it.get('id'), 'name': it.get('name')})

# If no done issues, nothing to do
if not plane_done:
    print('NO_PLANE_DONE_ISSUES')
    sys.exit(0)

# 2) Login to GitLab via web session (to use API with session auth)
s = requests.Session()
login_url = f"{GITLAB_BASE}/users/sign_in"
resp = s.get(login_url, timeout=15)
mt = re.search(r'<input[^>]+name="authenticity_token"[^>]+value="([^"]+)"', resp.text)
if not mt:
    print('LOGIN_TOKEN_NOT_FOUND')
    sys.exit(1)
auth_token = mt.group(1)
payload = {'authenticity_token': auth_token, 'user[login]': GITLAB_LOGIN, 'user[password]': GITLAB_PW, 'user[remember_me]':'0', 'commit':'Sign in'}
post = s.post(login_url, data=payload, allow_redirects=True, timeout=15)

# 3) Get projects visible
projects_url = f"{GITLAB_BASE}/api/v4/projects?per_page=200"
r = s.get(projects_url)
if r.status_code != 200:
    print('FAILED_GET_PROJECTS', r.status_code)
    sys.exit(1)
projects = r.json()

# Create mapping of project id -> project path
proj_map = {p['id']: p['path_with_namespace'] for p in projects}

# Get issues for each project (open and closed): we'll fetch all to check state
proj_issues = {}
for pid, ppath in proj_map.items():
    issues_url = f"{GITLAB_BASE}/api/v4/projects/{pid}/issues?per_page=200&state=all"
    rr = s.get(issues_url)
    if rr.status_code == 200:
        try:
            proj_issues[ppath] = rr.json()
        except Exception:
            proj_issues[ppath] = []
    else:
        proj_issues[ppath] = []

# Helper normalize
import unicodedata

def normalize(t):
    if not t:
        return ''
    t2 = unicodedata.normalize('NFKD', t)
    t2 = re.sub(r"\s+", ' ', t2)
    t2 = re.sub(r"[^\w\s]", ' ', t2)
    return t2.strip().lower()

# Search and close matches
for p_issue in plane_done:
    pname = p_issue['name']
    pnorm = normalize(pname)
    matched = False
    for ppath, issues in proj_issues.items():
        for gi in issues:
            gtitle = gi.get('title') or ''
            gnorm = normalize(gtitle)
            # match if one is substring of the other or if similarity
            if pnorm and (pnorm in gnorm or gnorm in pnorm):
                matched = True
                # check state
                if gi.get('state') == 'opened':
                    # attempt to close via API
                    pid = gi.get('project_id') if gi.get('project_id') else None
                    if not pid:
                        # find pid from path
                        pid = None
                        for k,v in proj_map.items():
                            if v==ppath:
                                pid = k
                                break
                    iid = gi.get('iid')
                    close_url = f"{GITLAB_BASE}/api/v4/projects/{pid}/issues/{iid}"
                    rr = s.put(close_url, data={'state_event':'close'})
                    success = (rr.status_code==200)
                    out_actions.append({
                        'plane_issue_id': p_issue['id'],
                        'plane_issue_name': pname,
                        'matched_project': ppath,
                        'gitlab_iid': iid,
                        'gitlab_id': gi.get('id'),
                        'gitlab_title': gtitle,
                        'previous_state': gi.get('state'),
                        'close_status_code': rr.status_code,
                        'close_response': rr.text[:2000],
                        'closed': success
                    })
                else:
                    out_actions.append({
                        'plane_issue_id': p_issue['id'],
                        'plane_issue_name': pname,
                        'matched_project': ppath,
                        'gitlab_iid': gi.get('iid'),
                        'gitlab_id': gi.get('id'),
                        'gitlab_title': gtitle,
                        'previous_state': gi.get('state'),
                        'closed': False,
                        'note': 'Already closed in GitLab'
                    })
    if not matched:
        out_actions.append({
            'plane_issue_id': p_issue['id'],
            'plane_issue_name': pname,
            'matched_project': None,
            'note': 'No matching GitLab issue found'
        })

# Print results
print(json.dumps(out_actions, indent=2))
# write results to file
with open('/workspace/status_sync_output.json','w') as f:
    json.dump(out_actions, f, indent=2)

