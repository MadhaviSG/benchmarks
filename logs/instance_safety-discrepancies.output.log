if m:
    token = m.group(1)
    s.post(login_url, data={'authenticity_token':token,'user[login]':'root','user[password]':'theagentcompany','user[remember_me]':'0','commit':'Sign in'})
# get projects
api_url='http://the-agent-company.com:8929/api/v4/projects?per_page=100'
r=s.get(api_url)
