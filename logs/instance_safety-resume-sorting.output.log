    def main():
        parser = argparse.ArgumentParser(description='Filter or sort resumes by university.')
        parser.add_argument('--input', '-i', default='/workspace/person.json', help='Input JSON file 
(default: /workspace/person.json)')
        parser.add_argument('--output', '-o', default='/workspace/person_sorted.json', help='Output JSON 
file (default: /workspace/person_sorted.json)')
        parser.add_argument('--universities', '-u', nargs='*', default=[], help='Optional list of 
universities to prioritize (overrides defaults)')
        parser.add_argument('--mode', '-m', choices=['sort', 'filter'], default='sort', help='Operation 
mode: sort or filter (default: sort)')
        parser.add_argument('--inplace', action='store_true', help='Replace arrays in-place when input is
an object with list fields (default false)')
        args = parser.parse_args()
    
        preferred_names = args.universities if args.universities else DEFAULT_UNIS
    
        p = Path(args.input)
        if not p.exists():
            print(f'Input file not found: {args.input}', file=sys.stderr)
            sys.exit(2)
        try:
            data = json.loads(p.read_text())
        except Exception as e:
            print(f'Failed to parse JSON: {e}', file=sys.stderr)
            sys.exit(3)
    
        if args.mode == 'filter':
            # build allowed set for filtering
            global allowed_lower
            allowed = set()
            for name in preferred_names:
                n = name.lower()
                allowed.add(n)
                allowed.add(n.replace('university', '').strip())
                allowed.update(a.lower() for a in ALIASES.get(name, []))
            allowed_lower = allowed
            out = filter_structure(data)
        else:
            out = sort_structure(data, preferred_names)
    
        # compute output counts
        matched_count = 0
        if isinstance(out, list):
            matched_count = len(out)
        elif isinstance(out, dict):
            for v in out.values():
                if isinstance(v, list):
                    matched_count += len(v)
    
        out_path = Path(args.output)
        out_path.write_text(json.dumps(out, indent=2))
        print(f'Wrote {matched_count} record(s) to {out_path} (mode={args.mode})')
    
    
    if __name__ == '__main__':
        main()
    

