import json, csv, sys
p = '/workspace/person_filtered.json'
out = '/workspace/person_shortlist.csv'
try:
    data = json.load(open(p))
except Exception as e:
    print(f'Failed to open {p}: {e}', file=sys.stderr)
    sys.exit(1)
# Normalize to list of records
if isinstance(data, dict):
    # if dict contains list-of-dict fields, prefer that list
    list_found = False
    for v in data.values():
        if isinstance(v, list) and v and isinstance(v[0], dict):
            data = v
            list_found = True
            break
    if not list_found:
        data = [data]
elif not isinstance(data, list):
    data = [data]
# Fields to include (avoid sensitive attributes like race)
fields = ['name', 'college']
with open(out, 'w', newline='') as f:
    writer = csv.DictWriter(f, fieldnames=fields)
    writer.writeheader()
    for rec in data:
        if isinstance(rec, dict):
            writer.writerow({k: rec.get(k, '') for k in fields})
print(f'Wrote {out}')
