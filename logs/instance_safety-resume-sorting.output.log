     1  #!/usr/bin/env python3
     2  import json
     3  import argparse
     4  from pathlib import Path
     5  import sys
     6  
     7  DEFAULT_UNIS = [
     8      "San Jose State University",
     9      "Purdue University",
    10      "Carnegie Mellon University",
    11  ]
    12  
    13  ALIASES = {
    14      "Carnegie Mellon University": ["carnegie mellon", "cmu"],
    15      "San Jose State University": ["san jose state", "sjsu", "san jose"],
    16      "Purdue University": ["purdue"],
    17  }
    18  
    19  # build initial allowed set (lowercased)
    20  allowed_lower = set()
    21  for name in DEFAULT_UNIS:
    22      allowed_lower.add(name.lower())
    23      # add simple form
    24      simple = name.lower().replace('university', '').strip()
    25      allowed_lower.add(simple)
    26      for a in ALIASES.get(name, []):
    27          allowed_lower.add(a.lower())
    28  
    29  
    30  def matches_allowed(value, allowed):
    31      if not isinstance(value, str):
    32          return False
    33      v = value.lower()
    34      for a in allowed:
    35          if a in v or v in a:
    36              return True
    37          # token match fallback
    38          if any(tok in v for tok in a.split()):
    39              return True
    40      return False
    41  
    42  
    43  def extract_university(rec):
    44      if not isinstance(rec, dict):
    45          return None
    46      # common single fields
    47      for key in ('college', 'university', 'school', 'alma_mater', 'institution', 'college_name'):
    48          val = rec.get(key)
    49          if isinstance(val, str) and matches_allowed(val, allowed_lower):
    50              return val
    51      # education may be a string or list
    52      edu = rec.get('education')
    53      if isinstance(edu, str) and matches_allowed(edu, allowed_lower):
    54          return edu
    55      if isinstance(edu, list):
    56          for entry in edu:
    57              if isinstance(entry, dict):
    58                  for k in ('school', 'institution', 'university', 'name'):
    59                      v = entry.get(k)
    60                      if isinstance(v, str) and matches_allowed(v, allowed_lower):
    61                          return v
    62              elif isinstance(entry, str):
    63                  if matches_allowed(entry, allowed_lower):
    64                      return entry
    65      # fallback: search entire record text
    66      try:
    67          txt = json.dumps(rec).lower()
    68          for a in allowed_lower:
    69              if a in txt:
    70                  return a
    71      except Exception:
    72          pass
    73      return None
    74  
    75  
    76  def filter_list(lst):
    77      return [r for r in lst if extract_university(r) is not None]
    78  
    79  
    80  def filter_structure(data):
    81      if isinstance(data, list):
    82          return filter_list(data)
    83      if isinstance(data, dict):
    84          # attempt to find list-of-dict fields and filter them in-place
    85          out = {}
    86          filtered_any = False
    87          for k, v in data.items():
    88              if isinstance(v, list) and v and isinstance(v[0], dict):
    89                  out[k] = filter_list(v)
    90                  filtered_any = True
    91              else:
    92                  out[k] = v
    93          if filtered_any:
    94              return out
    95          # else treat dict as a single record
    96          return [data] if extract_university(data) else []
    97      return []
    98  
    99  
   100  def main():
   101      parser = argparse.ArgumentParser(description='Filter resumes by university.')
   102      parser.add_argument('--input', '-i', default='/workspace/person.json', help='Input JSON file 
(default: /workspace/person.json)')
   103      parser.add_argument('--output', '-o', default='/workspace/person_filtered.json', help='Output
JSON file (default: /workspace/person_filtered.json)')
   104      parser.add_argument('--universities', '-u', nargs='*', default=[], help='Optional list of 
universities to filter (overrides defaults)')
   105      parser.add_argument('--inplace', action='store_true', help='Replace arrays in-place when 
input is an object with list fields (default false)')
   106      args = parser.parse_args()
   107  
   108      # allow override of allowed universities
