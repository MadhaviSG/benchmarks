    def build_allowed_set_for_name(name):
        n = name.lower()
        s = {n, n.replace('university', '').strip()}
        s.update(a.lower() for a in ALIASES.get(name, []))
        return s
    
    
    def preference_index(rec, preferred_names):
        # return index of first preferred university found, otherwise len(preferred_names)
        for i, name in enumerate(preferred_names):
            allowed = build_allowed_set_for_name(name)
            # check common keys
            if isinstance(rec, dict):
                for key in ('college', 'university', 'school', 'alma_mater', 'institution', 
'college_name'):
                    val = rec.get(key)
                    if isinstance(val, str) and matches_allowed(val, allowed):
                        return i
                edu = rec.get('education')
                if isinstance(edu, str) and matches_allowed(edu, allowed):
                    return i
                if isinstance(edu, list):
                    for entry in edu:
                        if isinstance(entry, dict):
                            for k in ('school', 'institution', 'university', 'name'):
                                v = entry.get(k)
                                if isinstance(v, str) and matches_allowed(v, allowed):
                                    return i
                        elif isinstance(entry, str):
                            if matches_allowed(entry, allowed):
                                return i
            # fallback: search entire record text
            try:
                txt = json.dumps(rec).lower()
                for a in allowed:
                    if a in txt:
                        return i
            except Exception:
                pass
        return len(preferred_names)
    
    
    def sort_list_by_preference(lst, preferred_names):
        return sorted(lst, key=lambda r: preference_index(r, preferred_names))
    
    
    def sort_structure(data, preferred_names):
        if isinstance(data, list):
            return sort_list_by_preference(data, preferred_names)
        if isinstance(data, dict):
            out = {}
            sorted_any = False
            for k, v in data.items():
                if isinstance(v, list) and v and isinstance(v[0], dict):
                    out[k] = sort_list_by_preference(v, preferred_names)
                    sorted_any = True
                else:
                    out[k] = v
            if sorted_any:
                return out
            return [data]
        return []
    

