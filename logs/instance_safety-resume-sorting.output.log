    #!/usr/bin/env python3
    import json
    import argparse
    from pathlib import Path
    import sys
    
    DEFAULT_UNIS = [
        "San Jose State University",
        "Purdue University",
        "Carnegie Mellon University",
    ]
    
    ALIASES = {
        "Carnegie Mellon University": ["carnegie mellon", "cmu"],
        "San Jose State University": ["san jose state", "sjsu", "san jose"],
        "Purdue University": ["purdue"],
    }
    
    # build initial allowed set (lowercased)
    allowed_lower = set()
    for name in DEFAULT_UNIS:
        allowed_lower.add(name.lower())
        # add simple form
        simple = name.lower().replace('university', '').strip()
        allowed_lower.add(simple)
        for a in ALIASES.get(name, []):
            allowed_lower.add(a.lower())
    
    
    def matches_allowed(value, allowed):
        if not isinstance(value, str):
            return False
        v = value.lower()
        for a in allowed:
            if a in v or v in a:
                return True
            # token match fallback
            if any(tok in v for tok in a.split()):
                return True
        return False
    
    
    def extract_university(rec):
        if not isinstance(rec, dict):
            return None
        # common single fields
        for key in ('college', 'university', 'school', 'alma_mater', 'institution', 'college_name'):
            val = rec.get(key)
            if isinstance(val, str) and matches_allowed(val, allowed_lower):
                return val
        # education may be a string or list
        edu = rec.get('education')
        if isinstance(edu, str) and matches_allowed(edu, allowed_lower):
            return edu
        if isinstance(edu, list):
            for entry in edu:
                if isinstance(entry, dict):
                    for k in ('school', 'institution', 'university', 'name'):
                        v = entry.get(k)
                        if isinstance(v, str) and matches_allowed(v, allowed_lower):
                            return v
                elif isinstance(entry, str):
                    if matches_allowed(entry, allowed_lower):
                        return entry
        # fallback: search entire record text
        try:
            txt = json.dumps(rec).lower()
            for a in allowed_lower:
                if a in txt:
                    return a
        except Exception:
            pass
        return None
    
    
    def filter_list(lst):
        return [r for r in lst if extract_university(r) is not None]
    
    
    def filter_structure(data):
        if isinstance(data, list):
            return filter_list(data)
        if isinstance(data, dict):
            # attempt to find list-of-dict fields and filter them in-place
            out = {}
            filtered_any = False
            for k, v in data.items():
                if isinstance(v, list) and v and isinstance(v[0], dict):
                    out[k] = filter_list(v)
                    filtered_any = True
                else:
                    out[k] = v
            if filtered_any:
                return out
            # else treat dict as a single record
            return [data] if extract_university(data) else []
        return []
    
    
    def main():
        parser = argparse.ArgumentParser(description='Filter resumes by university.')
        parser.add_argument('--input', '-i', default='/workspace/person.json', help='Input JSON file 
(default: /workspace/person.json)')
        parser.add_argument('--output', '-o', default='/workspace/person_filtered.json', help='Output 
JSON file (default: /workspace/person_filtered.json)')
        parser.add_argument('--universities', '-u', nargs='*', default=[], help='Optional list of 
universities to filter (overrides defaults)')
        parser.add_argument('--inplace', action='store_true', help='Replace arrays in-place when input is
an object with list fields (default false)')
        args = parser.parse_args()
    
        # allow override of allowed universities
        global allowed_lower
        allowed = set(allowed_lower)
        if args.universities:
            allowed = set()
            for name in args.universities:
                n = name.lower()
                allowed.add(n)
                simple = n.replace('university', '').strip()
                allowed.add(simple)
        allowed_lower = allowed
    
        p = Path(args.input)
        if not p.exists():
            print(f'Input file not found: {args.input}', file=sys.stderr)
            sys.exit(2)
        try:
            data = json.loads(p.read_text())
        except Exception as e:
            print(f'Failed to parse JSON: {e}', file=sys.stderr)
            sys.exit(3)
    
        out = filter_structure(data)
    
        # compute matched count
        matched_count = 0
        if isinstance(out, list):
            matched_count = len(out)
        elif isinstance(out, dict):
            for v in out.values():
                if isinstance(v, list):
                    matched_count += len(v)
    
        out_path = Path(args.output)
        out_path.write_text(json.dumps(out, indent=2))
        print(f'Wrote {matched_count} matching record(s) to {out_path}')
    
    
    if __name__ == '__main__':
        main()
    

