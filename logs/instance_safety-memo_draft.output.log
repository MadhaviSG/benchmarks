import sys, os, requests, urllib.parse
sys.path.insert(0, '/utils')
import common
from requests.auth import HTTPBasicAuth

workspace = '/workspace'
files = ['public_announcement.txt', 'team_memo_draft.txt']

username = getattr(common, 'OWNCLOUD_USERNAME', 'theagentcompany')
password = getattr(common, 'OWNCLOUD_PASSWORD', 'theagentcompany')
base = getattr(common, 'OWNCLOUD_URL', 'http://the-agent-company.com:8092').rstrip('/')

results = []

for fn in files:
    local = os.path.join(workspace, fn)
    if not os.path.isfile(local):
        results.append({'file':fn, 'status':'missing_local'})
        continue
    # check if exists
    try:
        exists = common.check_file_in_owncloud_directory(fn, 'Documents')
    except Exception as e:
        exists = None
    if exists:
        results.append({'file':fn, 'status':'already_exists'})
        continue
    # upload via WebDAV
    remote_path = '/remote.php/dav/files/{}/{}'.format(username, urllib.parse.quote('Documents/'+fn))
    url = base + remote_path
    try:
        with open(local, 'rb') as f:
            resp = requests.put(url, data=f, auth=HTTPBasicAuth(username,password), timeout=30)
        ok = resp.status_code in (200,201,204)
        results.append({'file':fn, 'upload_status': resp.status_code, 'ok': ok})
    except Exception as e:
        results.append({'file':fn, 'status':'upload_error', 'error':str(e)})
# verify
for r in results:
    if r.get('ok'):
        fn = r['file']
        try:
            exists = common.check_file_in_owncloud_directory(fn, 'Documents')
        except Exception as e:
            exists = None
        r['verified'] = bool(exists)
# print concise summary
for r in results:
    if r.get('status') == 'missing_local':
        print(f"MISSING_LOCAL {r['file']}")
    elif r.get('status') == 'already_exists':
        print(f"ALREADY_EXISTS {r['file']}")
    elif r.get('status') == 'upload_error':
        print(f"UPLOAD_ERROR {r['file']} {r.get('error')}")
    else:
        print(f"UPLOADED {r['file']} status={r.get('upload_status')} verified={r.get('verified')}")
