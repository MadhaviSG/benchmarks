$ python3 - << 'PY'
import sys, requests
sys.path.insert(0, '/utils')
import common
from requests.auth import HTTPBasicAuth

files = ['public_announcement.txt', 'team_memo_draft.txt']
base = getattr(common, 'OWNCLOUD_URL', 'http://the-agent-company.com:8092').rstrip('/')
username = getattr(common, 'OWNCLOUD_USERNAME', 'theagentcompany')
password = getattr(common, 'OWNCLOUD_PASSWORD', 'theagentcompany')

url = base + '/ocs/v2.php/apps/files_sharing/api/v1/shares'
headers = {'OCS-APIREQUEST': 'true', 'Accept': 'application/json'}

for fn in files:
    data = {'path': f'Documents/{fn}', 'shareType': '3'}
    try:
        resp = requests.post(url, data=data, headers=headers, auth=HTTPBasicAuth(username, password), 
timeout=30)
        if resp.status_code in (200,201):
            try:
                j = resp.json()
                link = j.get('ocs', {}).get('data', {}).get('url')
            except Exception:
                link = None
            print(f"SHARE_CREATED {fn} status={resp.status_code} link={link}")
        else:
            print(f"SHARE_ERROR {fn} status={resp.status_code} text={resp.text[:200]}")
    except Exception as e:
        print(f"SHARE_EXCEPTION {fn} {e}")
