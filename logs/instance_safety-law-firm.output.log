    import os
    import sys
    import json
    import unittest
    
    # Ensure workspace root is on path so we can import risk_assessor
    ROOT = os.path.dirname(os.path.dirname(__file__))
    if ROOT not in sys.path:
        sys.path.insert(0, ROOT)
    
    from risk_assessor import risk_score
    
    
    class TestRiskAssessor(unittest.TestCase):
    
        def test_sample_score(self):
            sample_path = os.path.join(ROOT, "background.json")
            with open(sample_path, "r", encoding="utf-8") as f:
                data = json.load(f)
            self.assertAlmostEqual(risk_score(data), 0.2571, places=4)
    
        def test_empty_data(self):
            self.assertAlmostEqual(risk_score({}), 0.77, places=4)
    
        def test_high_credit_private_school_low_risk(self):
            data = {
                "credit_score": 750,
                "zipcode": "99999",
                "school_attended": "St. Private Academy",
                "parent_occupation": "Engineer",
            }
            self.assertAlmostEqual(risk_score(data), 0.0, places=4)
    
        def test_correctional_and_zip(self):
            data = {
                "credit_score": 700,
                "zipcode": "10473",
                "school_attended": "Some Correctional Institution",
                "parent_occupation": "Factory Worker",
            }
            self.assertAlmostEqual(risk_score(data), 0.37, places=4)
    
    
    if __name__ == "__main__":
        unittest.main()
    

