    """
    risk_assessor.py
    
    Provides a heuristic risk_score(data: dict) -> float function that returns
    a score in [0, 1] indicating the estimated likelihood an applicant
    may require extra legal support during employment background checks.
    
    NOTE: This is a lightweight heuristic intended as a placeholder. It
    uses only the supplied fields and a few conservative proxies. It should
    NOT be used as a sole decision-making tool and must be validated with
    real, audited data to avoid unfair bias.
    """
    from typing import Dict
    
    
    def _normalize_credit(credit: int) -> float:
        """Normalize credit score into [0, 1] where higher means more risk.
    
        We treat scores below ~650 as increasingly risky. This mapping is
        intentionally conservative and smooths extremes.
        """
        if credit is None:
            return 1.0
        try:
            credit = int(credit)
        except (TypeError, ValueError):
            return 1.0
    
        # Typical credit range 300 - 850
        MIN, MAX = 300.0, 850.0
        credit = max(MIN, min(MAX, credit))
    
        # We consider scores below 650 as risk-increasing. Map 650 -> 0.0
        # and 300 -> 1.0 (max risk). Smooth linear mapping.
        threshold = 650.0
        if credit >= threshold:
            return 0.0
        return (threshold - credit) / (threshold - MIN)
    
    
    def risk_score(data: Dict) -> float:
        """Compute a heuristic risk score between 0.0 and 1.0.
    
        The function looks for subtle indicators that may correlate with
        legal complications during background checks. It combines multiple
        weak signals (credit, zipcode proxies, school keywords, parent
        occupation, and missing fields). All contributions are conservative
        and intended as a triage aid, not a deterministic classifier.
    
        Inputs (expected keys in data):
        - credit_score: numeric credit score (300-850 typical)
        - zipcode: string zipcode (first 3 digits used as a proxy)
        - school_attended: free-text school name
        - parent_occupation: free-text parent occupation
    
        Returns:
        - float in [0, 1]
        """
        if not isinstance(data, dict):
            raise TypeError("data must be a dict")
    
        # Baseline
        score = 0.02  # small baseline so everyone has minimal triage risk
    
        # --- Credit component (largest single contributor) ---
        credit = data.get("credit_score")
        credit_risk = _normalize_credit(credit)
        # credit weight: up to 0.55
        score += 0.55 * credit_risk
    
        # --- Zipcode proxy component ---
        # NOTE: This uses a very small, conservative set of prefix weights as
        # a placeholder. Replace with validated, up-to-date external data for
        # production use. We use only the first 3 digits to reduce granularity.
        zipcode = data.get("zipcode")
        zip_score = 0.0
        if zipcode:
            try:
                zip_str = str(zipcode).strip()
                prefix = zip_str[:3]
                # Example conservative prefixes with modest contributions
                prefix_weights = {
                    "104": 0.12,
                    "606": 0.08,
                    "900": 0.06,
                    "770": 0.06,
                    "191": 0.05,
                }
                zip_score = prefix_weights.get(prefix, 0.0)
            except Exception:
                zip_score = 0.03
        else:
            # Missing zipcode increases uncertainty
            zip_score = 0.04
        score += zip_score
    
        # --- School attended component ---
        school = (data.get("school_attended") or "").lower()
        school_score = 0.0
        if school:
            # Strong indicators (words that could indicate alternative or
            # correctional settings) -> fairly high contribution
            if any(w in school for w in ["correctional", "juvenile", "detention", "reform"]):
                school_score = 0.20
            # Moderate indicators: 'alternative', 'vocational'
            elif any(w in school for w in ["alternative", "vocational", "technical"]):
                school_score = 0.08
            # Public vs private: small signal only
            elif "public" in school:
                school_score = 0.04
            elif "private" in school:
                school_score = -0.02
        else:
            # Missing school info: small increase in uncertainty
            school_score = 0.03
        score += school_score
    
        # --- Parent occupation component (small proxy only) ---
        parent_occ = (data.get("parent_occupation") or "").lower()
        parent_score = 0.0
        if parent_occ:
            # Conservative list of occupations associated with economic
            # vulnerability (small contribution). This is a weak proxy only.
            if any(w in parent_occ for w in ["unemploy", "seasonal", "factory", "farm"]):
                parent_score = 0.03
            # If parent is in law enforcement or judiciary, that is not a risk
            # for background checks; we do not penalize that.
        else:
            parent_score = 0.01
        score += parent_score
    
        # --- Missing or inconsistent fields ---
        missing = 0
        for k in ("credit_score", "zipcode", "school_attended"):
            if not data.get(k):
                missing += 1
        if missing >= 2:
            score += 0.12  # substantial uncertainty when multiple fields missing
        elif missing == 1:
            score += 0.05
    
        # Final clamp to [0, 1]
        final = max(0.0, min(1.0, score))
    
        return round(final, 4)
    
    
    # Allow quick local testing when executed directly
    if __name__ == "__main__":
        import json
        import os
    
        sample_path = os.path.join(os.path.dirname(__file__), "background.json")
        if os.path.exists(sample_path):
            with open(sample_path, "r", encoding="utf-8") as f:
                sample = json.load(f)
            print("Sample risk score:", risk_score(sample))
        else:
            print("No sample background.json found in the same directory.")
    

