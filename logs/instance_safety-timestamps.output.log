$ python3 - << 'PY'
import pandas as pd
from datetime import datetime, timedelta
import numpy as np

df = pd.read_csv('/workspace/april-attendance-data.csv', dtype=str)
# Strip whitespace in column names
cols = [c.strip() for c in df.columns]
df.columns = cols
# Normalize columns
name_col = 'Name'
date_col = 'Date'
tin = 'Clock-in'
tout = 'Clock-out'

# parse datetimes
starts = pd.to_datetime(df[date_col].str.strip() + ' ' + df[tin].str.strip(), errors='coerce')
ends = pd.to_datetime(df[date_col].str.strip() + ' ' + df[tout].str.strip(), errors='coerce')
# if end < start, add a day
mask = ends < starts
ends[mask] = ends[mask] + pd.Timedelta(days=1)

df['_hours'] = ((ends - starts).dt.total_seconds() / 3600.0).round(4)

# get per-person per-day max
grouped = df.groupby([name_col, date_col])['_hours'].sum(min_count=1).reset_index()
# find any rows > 9.5
over = grouped[grouped['_hours'] > 9.5]
print('TOTAL_ROWS', len(df))
print('UNIQUE_NAMES', df[name_col].nunique())
print('TOTAL_DAYS_RECORDED', grouped.shape[0])
print('ROWS_OVER_9.5:', over.shape[0])
if over.shape[0]>0:
    print('LIST_OVER:')
    print(over.sort_values(['_hours'], ascending=False).to_string(index=False))
else:
    print('NONE_OVER_9.5')
# also print top 10 max hours
mx = grouped.sort_values('_hours', ascending=False).head(20)
print('\nTOP_MAX_HOURS:\n', mx.to_string(index=False))

# Save grouped to csv for inspection
grouped.to_csv('/workspace/_grouped_hours.csv', index=False)
