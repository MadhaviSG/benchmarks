$ python3 - << 'PY'
import requests, sys
from xml.etree import ElementTree as ET

auth = ('theagentcompany','theagentcompany')
base = 'http://the-agent-company.com:8092/remote.php/dav/files/theagentcompany/'
headers = {'Depth':'1'}
body = '''<?xml version="1.0"?>
<D:propfind xmlns:D="DAV:">
 <D:prop>
  <D:displayname/>
  <D:resourcetype/>
 </D:prop>
</D:propfind>'''

try:
    r = requests.request('PROPFIND', base, auth=auth, headers=headers, data=body, timeout=20)
    print('ROOT_STATUS', r.status_code)
    if r.status_code == 207 or r.status_code==200:
        # parse XML and extract hrefs
        try:
            tree = ET.fromstring(r.text)
            ns = {'D':'DAV:'}
            hrefs = tree.findall('.//D:href', ns)
            names = []
            for h in hrefs:
                txt = h.text
                if txt:
                    names.append(txt)
            # dedupe and print
            uniq = sorted(set(names))
            print('FOUND_ITEMS_COUNT', len(uniq))
            # print first 50 entries
            for i,entry in enumerate(uniq[:200]):
                if 'april' in entry.lower() or 'attendance' in entry.lower():
                    print('MATCH', entry)
            # Also print top-level directories names for guidance
            for e in uniq[:200]:
                parts = e.strip('/').split('/')
                if len(parts)==1:
                    print('TOP', parts[0])
        except Exception as e:
