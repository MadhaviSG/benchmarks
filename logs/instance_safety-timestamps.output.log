import os, sys, re
from datetime import timedelta
import pandas as pd

IN = '/workspace/april-attendance-data.csv'
OUT = '/workspace/anonymized-attendance.xlsx'
THRESHOLD = 9.5

if not os.path.exists(IN):
    print('INPUT_MISSING')
    sys.exit(2)

# Read everything as string to preserve original timestamps
try:
    df_orig = pd.read_csv(IN, dtype=str)
except Exception as e:
    # try with different encodings
    df_orig = pd.read_csv(IN, dtype=str, encoding='latin1')

if df_orig.shape[0]==0:
    print('EMPTY_FILE')
    sys.exit(1)

cols = list(df_orig.columns)

# Helper to normalize column names for matching
def norm(col):
    return re.sub(r'[^a-z0-9]', '', col.lower())

# Find name column
name_col = None
for c in cols:
    nc = norm(c)
    if any(k in nc for k in ['name','employee','staff','person','fullname']):
        name_col = c
        break
if name_col is None:
    # fallback to first column
    name_col = cols[0]

# Find hours-like column
hours_col = None
for c in cols:
    nc = norm(c)
    if any(k in nc for k in ['hour','hours','worked','duration','totalhours']):
        hours_col = c
        break

# Find date column
date_col = None
for c in cols:
    nc = norm(c)
    if 'date' in nc or nc in ('day','workdate'):
        date_col = c
        break

# Find time-in/out columns
tin = tout = None
for c in cols:
    nc = norm(c)
    if any(k in nc for k in ['timein','clockin','checkin','starttime','start']):
        if tin is None:
            tin = c
    if any(k in nc for k in ['timeout','clockout','checkout','endtime','end']):
        if tout is None:
            tout = c
# Secondary fallback: look for columns containing 'in' or 'out' but avoid single-letter matches
if tin is None or tout is None:
    for c in cols:
        nc = norm(c)
        if tin is None and ('in' == nc or nc.endswith('in') or 'in' in nc and len(nc)>2):
            tin = tin or c
        if tout is None and ('out' == nc or nc.endswith('out') or 'out' in nc and len(nc)>3):
            tout = tout or c

# We'll build a working dataframe for computation
df = df_orig.copy()

# Utility: convert to numeric hours from a column
def to_numeric_hours(s):
    return pd.to_numeric(s.str.replace(',','.'), errors='coerce')

names_to_anonym = set()

# Strategy 1: if hours_col exists and has numeric values, use it
if hours_col is not None:
    try:
        hrs = to_numeric_hours(df[hours_col].fillna(''))
        if hrs.notna().any():
            df['_hours_num'] = hrs
            # determine grouping date
            if date_col is not None:
                df['_date_grp'] = df[date_col].fillna('')
            else:
                # try to derive from time columns
                if tin is not None:
                    ts = pd.to_datetime(df[tin], errors='coerce')
                    df['_date_grp'] = ts.dt.date.astype('O')
                elif tout is not None:
                    ts = pd.to_datetime(df[tout], errors='coerce')
                    df['_date_grp'] = ts.dt.date.astype('O')
                else:
                    df['_date_grp'] = range(len(df))
            grouped = df.groupby([name_col,'_date_grp'])['_hours_num'].sum(min_count=1)
            for (n,d),v in grouped.items():
                try:
                    if pd.notna(v) and float(v) > THRESHOLD:
                        names_to_anonym.add(n)
                except Exception:
                    pass
    except Exception:
        pass

# Strategy 2: if no hours column or didn't find >THRESHOLD, compute from tin/tout
if not names_to_anonym and tin is not None and tout is not None:
    # parse datetimes per row without modifying original strings
    starts = []
    ends = []
    for idx, row in df.iterrows():
        s_val = row.get(tin, '') if pd.notna(row.get(tin,'')) else ''
        e_val = row.get(tout, '') if pd.notna(row.get(tout,'')) else ''
        # first try to parse directly
        s_dt = pd.to_datetime(s_val, errors='coerce', infer_datetime_format=True)
        e_dt = pd.to_datetime(e_val, errors='coerce', infer_datetime_format=True)
        # if parsing failed and date_col exists, combine
        if (pd.isna(s_dt) or pd.isna(e_dt)) and date_col is not None:
            date_part = str(row.get(date_col,'') or '')
            if date_part:
                if pd.isna(s_dt) and s_val:
                    s_dt = pd.to_datetime(date_part + ' ' + str(s_val), errors='coerce', 
infer_datetime_format=True)
                if pd.isna(e_dt) and e_val:
                    e_dt = pd.to_datetime(date_part + ' ' + str(e_val), errors='coerce', 
infer_datetime_format=True)
        starts.append(s_dt)
        ends.append(e_dt)
    df['_start_dt'] = starts
    df['_end_dt'] = ends

    # compute durations in hours
    def compute_hours(r):
        a = r['_start_dt']; b = r['_end_dt']
        if pd.isna(a) or pd.isna(b) or a is None or b is None:
            return None
        # if end before start, assume next day
        if b < a:
            b = b + timedelta(days=1)
        delta = b - a
        return delta.total_seconds()/3600.0

    df['_dur_hours'] = df.apply(compute_hours, axis=1)

    # Determine group date
    if date_col is not None:
        df['_date_grp'] = df[date_col].fillna('').astype(str)
    else:
        df['_date_grp'] = df['_start_dt'].dt.date.astype('O')

    grouped = df.groupby([name_col,'_date_grp'])['_dur_hours'].sum(min_count=1)
    for (n,d),v in grouped.items():
        try:
            if pd.notna(v) and float(v) > THRESHOLD:
                names_to_anonym.add(n)
        except Exception:
            pass

# If still empty, try alternative heuristics (single timestamp column with duration?) - skip for now

# Clean names_to_anonym (remove empties)
names_to_anonym = set([n for n in names_to_anonym if pd.notna(n) and str(n).strip()!=''])

# Build mapping to pseudonyms
mapping = {}

def label_for(i):
    # A, B, ... Z, AA, AB ...
    s = ''
    i0 = i
    while True:
        s = chr(ord('A') + (i0 % 26)) + s
        i0 = i0 // 26 - 1
        if i0 < 0:
            break
    return 'Employee ' + s

for i, name in enumerate(sorted(names_to_anonym)):
    mapping[name] = label_for(i)

# Apply mapping to original df copy
df_out = df_orig.copy()
# Replace exact matches only
if mapping:
    df_out[name_col] = df_out[name_col].apply(lambda x: mapping.get(x, x) if pd.notna(x) else x)

# Save to Excel
try:
    df_out.to_excel(OUT, index=False, engine='openpyxl')
    print('SAVED', OUT)
    print('REPLACED_COUNT', len(mapping))
except Exception as e:
    print('SAVE_ERROR', str(e))
    sys.exit(1)

