m/'
headers = {'Depth':'1'}
body = '''<?xml version="1.0"?>
<D:propfind xmlns:D="DAV:">
 <D:prop>
  <D:displayname/>
  <D:resourcetype/>
 </D:prop>
</D:propfind>'''

