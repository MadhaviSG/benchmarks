        for resp in responses:
            href = resp.find('D:href', ns)
            display = resp.find('.//D:displayname', ns)
            href_txt = href.text if href is not None else ''
            disp_txt = display.text if display is not None else ''
            print('ITEM', href_txt, 'DISPLAY', disp_txt)
    else:
        print('UNEXPECTED', r.status_code)
except Exception as e:
    print('ERR', e)
    sys.exit(1)
