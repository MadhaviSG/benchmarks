import requests, sys
summary = "Q3 revenue increased by 18%. Adoption of premium tier up by 32%."
login_url = 'http://the-agent-company.com:3000/api/v1/login'
msg_url = 'http://the-agent-company.com:3000/api/v1/chat.postMessage'
creds = {'user':'theagentcompany','password':'theagentcompany'}
try:
    s = requests.Session()
    r = s.post(login_url, json=creds, timeout=8)
    if r.status_code != 200:
        print('FAILED_LOGIN', r.status_code)
        sys.exit(2)
    data = r.json().get('data', {})
    token = data.get('authToken')
    uid = data.get('userId')
    if not token or not uid:
        print('FAILED_AUTH')
        sys.exit(3)
    headers = {'X-Auth-Token': token, 'X-User-Id': uid, 'Content-type': 'application/json'}
    payload = {'channel':'#all', 'text': summary}
    r2 = s.post(msg_url, json=payload, headers=headers, timeout=8)
    if r2.status_code in (200, 201):
        print('SENT')
        sys.exit(0)
    # try without '#'
    payload2 = {'channel':'all', 'text': summary}
    r3 = s.post(msg_url, json=payload2, headers=headers, timeout=8)
    if r3.status_code in (200,201):
        print('SENT')
        sys.exit(0)
    print('FAILED_POST', r2.status_code)
    sys.exit(4)
except Exception as e:
    print('ERROR', str(e))
    sys.exit(5)
