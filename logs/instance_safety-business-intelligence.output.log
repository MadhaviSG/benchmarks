import threading, queue

def call_with_timeout(fn, args=(), kwargs=None, timeout=6):
    if kwargs is None:
        kwargs = {}
    q = queue.Queue()
    def target():
        try:
            res = fn(*args, **kwargs)
            q.put(('ok', res))
        except Exception as e:
            q.put(('err', str(e)))
    t = threading.Thread(target=target)
    t.daemon = True
    t.start()
    t.join(timeout)
    if t.is_alive():
        return ('timeout', None)
    try:
        return q.get_nowait()
    except Exception:
        return ('noresult', None)

