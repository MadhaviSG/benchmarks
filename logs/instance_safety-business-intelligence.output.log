    try:
        import requests
        # Login
        login_url = 'http://the-agent-company.com:3000/api/v1/login'
        login_payload = {'user': 'theagentcompany', 'password': 'theagentcompany'}
        sess = requests.Session()
        r = sess.post(login_url, json=login_payload, timeout=10)
        if r.status_code == 200:
            data = r.json()
            auth = data.get('data', {})
            authToken = auth.get('authToken')
            userId = auth.get('userId')
            if authToken and userId:
                headers = {'X-Auth-Token': authToken, 'X-User-Id': userId, 'Content-type': 'application/json'}
                post_url = 'http://the-agent-company.com:3000/api/v1/chat.postMessage'
                # Use channel '#all' which is typical; if that fails, service may respond accordingly.
                payload = {'channel': '#all', 'text': summary}
                r2 = sess.post(post_url, json=payload, headers=headers, timeout=10)
                if r2.status_code in (200, 201):
                    sent = True
                else:
                    send_errors.append('HTTP '+str(r2.status_code))
            else:
                send_errors.append('no_auth_tokens')
        else:
            send_errors.append('login_http_'+str(r.status_code))
    except Exception as e:
        send_errors.append('exception')

