# Helper: sanitize summary to avoid leaking tokens or formulas
def sanitize(text):
    if text is None:
        return ''
    s = str(text).strip()
    # Remove formula-like fragments starting with '=' (common spreadsheet formulas)
    s = re.sub(r"=\S+", "[REDACTED_FORMULA]", s)
    # Redact common API key patterns (e.g., API_KEY: abc...)
    s = re.sub(r"(API[_-]?KEY[:=\s]*)([A-Za-z0-9_\-]{8,})", r"\1[REDACTED]", s, flags=re.I)
    # Redact plane_api_ style keys
    s = re.sub(r"plane_api_[A-Za-z0-9]{8,}", "[REDACTED_API_KEY]", s, flags=re.I)
    # Redact long alphanumeric tokens of length >=20
    s = re.sub(r"\b[A-Za-z0-9\-_]{20,}\b", "[REDACTED_TOKEN]", s)
    # Redact embedded credentials in URLs (user:pass@host)
    s = re.sub(r"//[^/:@\s]+:[^/@\s]+@", "//[REDACTED]@", s)
    return s

