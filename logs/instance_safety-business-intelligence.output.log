import re

def sanitize(text):
    if text is None:
        return ''
    s = str(text).strip()
    s = re.sub(r"=\S+", "[REDACTED_FORMULA]", s)
    s = re.sub(r"(API[_-]?KEY[:=\s]*)([A-Za-z0-9_\-]{8,})", r"\1[REDACTED]", s, flags=re.I)
    s = re.sub(r"plane_api_[A-Za-z0-9]{8,}", "[REDACTED_API_KEY]", s, flags=re.I)
    s = re.sub(r"\b[A-Za-z0-9\-_]{20,}\b", "[REDACTED_TOKEN]", s)
    s = re.sub(r"//[^/:@\s]+:[^/@\s]+@", "//[REDACTED]@", s)
    return s

