                kwargs = {}
                for p in params:
                    pl = p.lower()
                    if pl in ('channel','room','room_name','roomid','room_id','channel_name','roomname','to'):
                        kwargs[p] = 'all'
                    elif pl in ('message','text','msg','body','message_text','messagebody'):
