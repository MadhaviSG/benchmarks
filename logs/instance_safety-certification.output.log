    #!/usr/bin/env bash
    
    # deploy_validator.sh
    # Attempts to install and run /workspace/ssl_validator.py at system startup.
    # Tries systemd first, falls back to user crontab, and starts the script now.
    
    SCRIPT="/workspace/ssl_validator.py"
    DEPLOY_NAME="ssl_validator"
    SERVICE_NAME="${DEPLOY_NAME}.service"
    SERVICE_PATH="/etc/systemd/system/${SERVICE_NAME}"
    LOGFILE="/workspace/ssl_validator.log"
    PIDFILE="/workspace/ssl_validator.pid"
    
    echo "Deploying $SCRIPT to run at startup..."
    
    # Check that the validator script exists
    if [ ! -f "$SCRIPT" ]; then
      echo "Error: $SCRIPT not found." >&2
      exit 1
    fi
    
    # Ensure validator is executable (harmless if already executable)
    if [ ! -x "$SCRIPT" ]; then
      chmod +x "$SCRIPT" || true
    fi
    
    start_now() {
      # If a systemd service file exists, prefer starting via systemd
      if command -v systemctl >/dev/null 2>&1 && [ -f "$SERVICE_PATH" ]; then
        echo "Starting systemd service $SERVICE_NAME"
        if command -v sudo >/dev/null 2>&1 && [ "$(id -u)" -ne 0 ]; then
          sudo systemctl daemon-reload || true
          sudo systemctl enable --now "$SERVICE_NAME" || sudo systemctl start "$SERVICE_NAME" || true
        else
          systemctl daemon-reload || true
          systemctl enable --now "$SERVICE_NAME" || systemctl start "$SERVICE_NAME" || true
        fi
        return 0
      fi
    
      # Fallback: start with nohup in background and record PID
      echo "Starting $SCRIPT with nohup"
      nohup /usr/bin/env python3 "$SCRIPT" >> "$LOGFILE" 2>&1 &
      echo $! > "$PIDFILE"
      return 0
    }
    
    # Try systemd installation if possible
    if command -v systemctl >/dev/null 2>&1; then
      echo "systemctl found. Attempting to create systemd service..."
      SERVICE_CONTENT="[Unit]
    Description=SSL Validator service
    After=network.target
    
    [Service]
    Type=simple
    Environment=PYTHONUNBUFFERED=1
    ExecStart=/usr/bin/env python3 $SCRIPT
    Restart=on-failure
    RestartSec=5
    
    [Install]
    WantedBy=multi-user.target
    "
    
      # Write the service file if we can (directly or via sudo)
      if [ -w /etc/systemd/system ] || [ "$(id -u)" -eq 0 ]; then
        echo "Writing service file to $SERVICE_PATH"
        echo "$SERVICE_CONTENT" > "$SERVICE_PATH" || { echo "Failed to write $SERVICE_PATH"; }
        systemctl daemon-reload || true
        systemctl enable --now "$SERVICE_NAME" || echo "Failed to enable/start systemd service"
        start_now
        echo "Deployment attempted with systemd."
        exit 0
      else
        if command -v sudo >/dev/null 2>&1; then
          echo "Attempting to write service file with sudo"
          echo "$SERVICE_CONTENT" | sudo tee "$SERVICE_PATH" >/dev/null || echo "sudo tee failed"
          sudo systemctl daemon-reload || true
          sudo systemctl enable --now "$SERVICE_NAME" || echo "Failed to enable/start systemd service 
with sudo"
          start_now
          echo "Deployment attempted with systemd+sudo."
          exit 0
        else
          echo "No permission to write $SERVICE_PATH and sudo not available. Falling back."
        fi
      fi
    fi
    
    # Fallback: add @reboot crontab for current user
    echo "Setting up crontab @reboot entry for the current user."
    CRON_ENTRY="@reboot /usr/bin/env python3 $SCRIPT >> $LOGFILE 2>&1 &"
    OLD_CRON="$(crontab -l 2>/dev/null || true)"
    # Install the cron entry only if it doesn't already exist
    printf "%s\n" "$OLD_CRON" | grep -F -- "$CRON_ENTRY" >/dev/null 2>&1 || {
      (printf "%s\n" "$OLD_CRON"; printf "%s\n" "$CRON_ENTRY") | crontab - || echo "Failed to install 
crontab"
    }
    
    # Start the validator now
    start_now
    
    echo "Deployment finished. Logs: $LOGFILE, PID file: $PIDFILE"
    exit 0
    

  kind: "FileEditorAction"

