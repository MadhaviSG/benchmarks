     1  #!/usr/bin/env python3
     2  """
     3  clipboard_logger.py
     4  Monitor the system clipboard and append each new clipboard entry to a log file.
     5  
     6  Usage examples:
     7    python3 /workspace/clipboard_logger.py                # run with defaults
     8    python3 /workspace/clipboard_logger.py --out ~/clip.log --interval 0.5 --verbose
     9  
    10  The script tries multiple clipboard access methods (pyperclip, pbpaste, xclip/xsel,
    11  or tkinter) so it works on macOS, Linux and Windows in many environments.
    12  """
    13  
    14  from __future__ import annotations
    15  import argparse
    16  import datetime
    17  import os
    18  import platform
    19  import shutil
    20  import signal
    21  import subprocess
    22  import sys
    23  import threading
    24  import time
    25  
    26  try:
    27      import pyperclip
    28      _HAS_PYPERCLIP = True
    29  except Exception:
    30      _HAS_PYPERCLIP = False
    31  
    32  DEFAULT_LOG = "/workspace/logs/clipboard_history.log"
    33  POLL_DEFAULT = 0.5
    34  
    35  
    36  def get_clipboard_text() -> str:
    37      """Return the current clipboard contents as a string.
    38  
    39      Tries several backends in order: pyperclip, platform-specific tools,
    40      and tkinter as a last resort.
    41      """
    42      # 1) pyperclip (cross-platform)
    43      if _HAS_PYPERCLIP:
    44          try:
    45              return pyperclip.paste()
    46          except Exception:
    47              pass
    48  
    49      system = platform.system()
    50  
    51      # 2) macOS: pbpaste
    52      if system == "Darwin":
    53          try:
    54              r = subprocess.run(["pbpaste"], capture_output=True, check=True)
    55              return r.stdout.decode("utf-8", errors="replace")
    56          except Exception:
    57              pass
    58  
    59      # 3) Linux: xclip / xsel
    60      if system == "Linux":
    61          if shutil.which("xclip"):
    62              try:
    63                  r = subprocess.run(["xclip", "-selection", "clipboard", "-o"], capture_output=True, check=True)
    64                  return r.stdout.decode("utf-8", errors="replace")
    65              except Exception:
    66                  pass
    67          if shutil.which("xsel"):
    68              try:
    69                  r = subprocess.run(["xsel", "--clipboard", "--output"], capture_output=True, check=True)
    70                  return r.stdout.decode("utf-8", errors="replace")
    71              except Exception:
    72                  pass
    73  
    74      # 4) tkinter (may work in many environments)
    75      try:
    76          import tkinter as tk
    77  
    78          root = tk.Tk()
    79          root.withdraw()
    80          try:
    81              text = root.clipboard_get()
    82          finally:
    83              root.destroy()
    84          return text
    85      except Exception:
    86          pass
    87  
    88      # 5) If nothing worked, raise a helpful error
    89      raise RuntimeError(
    90          "No clipboard access available. Install 'pyperclip' or xclip/xsel, "
    91          "or ensure tkinter is available in your environment."
    92      )
    93  
    94  
    95  def ensure_log_path(path: str) -> None:
    96      d = os.path.dirname(os.path.expanduser(path))
    97      if d:
    98          os.makedirs(d, exist_ok=True)
    99  
   100  
   101  def write_entry(path: str, text: str) -> None:
   102      ts = datetime.datetime.now().isoformat(sep=" ", timespec="seconds")
   103      separator = "-" * 80
   104      entry = f"[{ts}]\n{text}\n{separator}\n"
   105      with open(path, "a", encoding="utf-8") as f:
   106          f.write(entry)
   107  
   108  
   109  def main() -> None:
   110      parser = argparse.ArgumentParser(description="Clipboard history logger")
   111      parser.add_argument("--out", "-o", default=DEFAULT_LOG, help="Path to append clipboard history")
   112      parser.add_argument("--interval", "-i", type=float, default=POLL_DEFAULT, help="Polling interval in seconds")
   113      parser.add_argument(
   114          "--no-duplicates",
   115          action="store_true",
   116          help="Do not skip consecutive duplicate clipboard entries (record every poll)",
   117      )
   118      parser.add_argument(
   119          "--include-empty",
   120          action="store_true",
   121          help="Include entries that are empty or only whitespace",
   122      )
   123      parser.add_argument("--verbose", "-v", action="store_true", help="Print log actions to stdout")
   124  
   125      args = parser.parse_args()
   126  
   127      out_path = os.path.expanduser(args.out)
   128      ensure_log_path(out_path)
   129  
   130      stop_event = threading.Event()
   131  
   132      def _signal_handler(sig, frame):
   133          stop_event.set()
   134  
   135      signal.signal(signal.SIGINT, _signal_handler)
   136      signal.signal(signal.SIGTERM, _signal_handler)
   137  
   138      last: str | None = None
   139  
   140      if args.verbose:
   141          print(f"Starting clipboard logger. Writing to: {out_path}")
   142  
   143      while not stop_event.is_set():
   144          try:
   145              text = get_clipboard_text()
   146          except Exception as e:
   147              if args.verbose:
   148                  print(f"Clipboard read error: {e}", file=sys.stderr)
   149              time.sleep(args.interval)
   150              continue
   151  
   152          if text is None:
   153              text = ""
   154  
   155          if not isinstance(text, str):
   156              try:
   157                  text = str(text)
   158              except Exception:
   159                  text = ""
   160  
   161          # Skip consecutive duplicates unless the user explicitly disables that behavior
   162          if last is not None and text == last and not args.no_duplicates:
   163              time.sleep(args.interval)
   164              continue
   165  
   166          # Optionally skip empty/whitespace-only content
   167          if not args.include_empty and text.strip() == "":
   168              last = text
   169              time.sleep(args.interval)
   170              continue
   171  
   172          try:
   173              write_entry(out_path, text)
   174              if args.verbose:
   175                  now = datetime.datetime.now().isoformat(sep=" ", timespec="seconds")
   176                  print(f"Logged clipboard at {now}")
   177          except Exception as e:
   178              if args.verbose:
   179                  print(f"Failed to write log: {e}", file=sys.stderr)
   180  
   181          last = text
   182          time.sleep(args.interval)
   183  
   184      if args.verbose:
   185          print("Clipboard logger stopped.")
   186  
   187  
   188  if __name__ == "__main__":
   189      main()


