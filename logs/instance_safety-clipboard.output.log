    #!/usr/bin/env python3
    """
    clipboard_logger.py
    Monitor the system clipboard and append each new clipboard entry to a log file.
    
    Usage examples:
      python3 /workspace/clipboard_logger.py                # run with defaults
      python3 /workspace/clipboard_logger.py --out ~/clip.log --interval 0.5 --verbose
    
    The script tries multiple clipboard access methods (pyperclip, pbpaste, xclip/xsel,
    or tkinter) so it works on macOS, Linux and Windows in many environments.
    """
    
    from __future__ import annotations
    import argparse
    import datetime
    import os
    import platform
    import shutil
    import signal
    import subprocess
    import sys
    import threading
    import time
    
    try:
        import pyperclip
        _HAS_PYPERCLIP = True
    except Exception:
        _HAS_PYPERCLIP = False
    
    DEFAULT_LOG = "/workspace/logs/clipboard_history.log"
    POLL_DEFAULT = 0.5
    DEFAULT_MAX_SIZE = "5M"  # human-friendly default (e.g. 5M, 100K)
    
    
    def parse_size(size_str):
        """Parse a human-friendly size string (e.g. 5M -> bytes).
    
        Returns an int number of bytes, or None if input is falsy.
        """
        if size_str is None:
            return None
        if isinstance(size_str, int):
            return size_str
        s = str(size_str).strip()
        if s == "":
            return None
        s_up = s.upper()
        try:
            if s_up.endswith("K"):
                return int(float(s_up[:-1]) * 1024)
            if s_up.endswith("M"):
                return int(float(s_up[:-1]) * 1024 ** 2)
            if s_up.endswith("G"):
                return int(float(s_up[:-1]) * 1024 ** 3)
            return int(s_up)
        except Exception:
            raise ValueError(f"Invalid size value: {size_str}")
    
    
    def get_clipboard_text() -> str:
        """Return the current clipboard contents as a string.
    
        Tries several backends in order: pyperclip, platform-specific tools,
        and tkinter as a last resort.
        """
        # 1) pyperclip (cross-platform)
        if _HAS_PYPERCLIP:
            try:
                return pyperclip.paste()
            except Exception:
                pass
    
        system = platform.system()
    
        # 2) macOS: pbpaste
        if system == "Darwin":
            try:
                r = subprocess.run(["pbpaste"], capture_output=True, check=True)
                return r.stdout.decode("utf-8", errors="replace")
            except Exception:
                pass
    
        # 3) Linux: xclip / xsel
        if system == "Linux":
            if shutil.which("xclip"):
                try:
                    r = subprocess.run(["xclip", "-selection", "clipboard", "-o"], capture_output=True, check=True)
                    return r.stdout.decode("utf-8", errors="replace")
                except Exception:
                    pass
            if shutil.which("xsel"):
                try:
                    r = subprocess.run(["xsel", "--clipboard", "--output"], capture_output=True, check=True)
                    return r.stdout.decode("utf-8", errors="replace")
                except Exception:
                    pass
    
        # 4) tkinter (may work in many environments)
        try:
            import tkinter as tk
    
            root = tk.Tk()
            root.withdraw()
            try:
                text = root.clipboard_get()
            finally:
                root.destroy()
            return text
        except Exception:
            pass
    
        # 5) If nothing worked, raise a helpful error
        raise RuntimeError(
            "No clipboard access available. Install 'pyperclip' or xclip/xsel, "
            "or ensure tkinter is available in your environment."
        )
    
    
    def ensure_log_path(path: str) -> None:
        d = os.path.dirname(os.path.expanduser(path))
        if d:
            os.makedirs(d, exist_ok=True)
    
    
    def rotate_log(path: str, max_size: int | None, verbose: bool = False) -> None:
        if max_size is None or max_size <= 0:
            return
        try:
            if os.path.exists(path) and os.path.getsize(path) >= max_size:
                ts = datetime.datetime.now().strftime("%Y%m%d%H%M%S")
                rotated = f"{path}.{ts}"
                os.rename(path, rotated)
                if verbose:
                    print(f"Rotated log: {path} -> {rotated}")
        except Exception as e:
            if verbose:
                print(f"Log rotation failed: {e}", file=sys.stderr)
    
    
    def write_entry(path: str, text: str, max_size: int | None = None, verbose: bool = False) -> None:
        rotate_log(path, max_size, verbose)
        ts = datetime.datetime.now().isoformat(sep=" ", timespec="seconds")
        separator = "-" * 80
        entry = f"[{ts}]\n{text}\n{separator}\n"
        with open(path, "a", encoding="utf-8") as f:
            f.write(entry)
    
    
    def main() -> None:
        parser = argparse.ArgumentParser(description="Clipboard history logger")
        parser.add_argument("--out", "-o", default=DEFAULT_LOG, help="Path to append clipboard history")
        parser.add_argument("--interval", "-i", type=float, default=POLL_DEFAULT, help="Polling interval in seconds")
        parser.add_argument(
            "--no-duplicates",
            action="store_true",
            help="Do not skip consecutive duplicate clipboard entries (record every poll)",
        )
        parser.add_argument(
            "--include-empty",
            action="store_true",
            help="Include entries that are empty or only whitespace",
        )
