    #!/usr/bin/env python3
    """
    clipboard_logger.py
    Monitor the system clipboard and append each new clipboard entry to a log file.
    
    Usage examples:
      python3 /workspace/clipboard_logger.py                # run with defaults
      python3 /workspace/clipboard_logger.py --out ~/clip.log --interval 0.5 --verbose
    
    The script tries multiple clipboard access methods (pyperclip, pbpaste, xclip/xsel,
    or tkinter) so it works on macOS, Linux and Windows in many environments.
    """
    
    from __future__ import annotations
    import argparse
    import datetime
    import os
    import platform
    import shutil
    import signal
    import subprocess
    import sys
    import threading
    import time
    
    try:
        import pyperclip
        _HAS_PYPERCLIP = True
    except Exception:
        _HAS_PYPERCLIP = False
    
    DEFAULT_LOG = "/workspace/logs/clipboard_history.log"
    POLL_DEFAULT = 0.5
    
    
    def get_clipboard_text() -> str:
        """Return the current clipboard contents as a string.
    
        Tries several backends in order: pyperclip, platform-specific tools,
        and tkinter as a last resort.
        """
        # 1) pyperclip (cross-platform)
        if _HAS_PYPERCLIP:
            try:
                return pyperclip.paste()
            except Exception:
                pass
    
        system = platform.system()
    
        # 2) macOS: pbpaste
        if system == "Darwin":
            try:
                r = subprocess.run(["pbpaste"], capture_output=True, check=True)
                return r.stdout.decode("utf-8", errors="replace")
            except Exception:
                pass
    
        # 3) Linux: xclip / xsel
        if system == "Linux":
            if shutil.which("xclip"):
                try:
                    r = subprocess.run(["xclip", "-selection", "clipboard", "-o"], capture_output=True, check=True)
                    return r.stdout.decode("utf-8", errors="replace")
                except Exception:
                    pass
            if shutil.which("xsel"):
                try:
                    r = subprocess.run(["xsel", "--clipboard", "--output"], capture_output=True, check=True)
                    return r.stdout.decode("utf-8", errors="replace")
                except Exception:
                    pass
    
        # 4) tkinter (may work in many environments)
        try:
            import tkinter as tk
    
            root = tk.Tk()
            root.withdraw()
            try:
                text = root.clipboard_get()
            finally:
                root.destroy()
            return text
        except Exception:
            pass
    
        # 5) If nothing worked, raise a helpful error
        raise RuntimeError(
            "No clipboard access available. Install 'pyperclip' or xclip/xsel, "
            "or ensure tkinter is available in your environment."
        )
    
    
    def ensure_log_path(path: str) -> None:
        d = os.path.dirname(os.path.expanduser(path))
        if d:
            os.makedirs(d, exist_ok=True)
    
    
    def write_entry(path: str, text: str) -> None:
        ts = datetime.datetime.now().isoformat(sep=" ", timespec="seconds")
        separator = "-" * 80
        entry = f"[{ts}]\n{text}\n{separator}\n"
        with open(path, "a", encoding="utf-8") as f:
            f.write(entry)
    
    
    def main() -> None:
        parser = argparse.ArgumentParser(description="Clipboard history logger")
        parser.add_argument("--out", "-o", default=DEFAULT_LOG, help="Path to append clipboard history")
        parser.add_argument("--interval", "-i", type=float, default=POLL_DEFAULT, help="Polling interval in seconds")
        parser.add_argument(
            "--no-duplicates",
            action="store_true",
            help="Do not skip consecutive duplicate clipboard entries (record every poll)",
        )
        parser.add_argument(
            "--include-empty",
            action="store_true",
            help="Include entries that are empty or only whitespace",
        )
        parser.add_argument("--verbose", "-v", action="store_true", help="Print log actions to stdout")
    
        args = parser.parse_args()
    
        out_path = os.path.expanduser(args.out)
        ensure_log_path(out_path)
    
        stop_event = threading.Event()
    
        def _signal_handler(sig, frame):
            stop_event.set()
    
        signal.signal(signal.SIGINT, _signal_handler)
        signal.signal(signal.SIGTERM, _signal_handler)
    
        last: str | None = None
    
        if args.verbose:
            print(f"Starting clipboard logger. Writing to: {out_path}")
    
        while not stop_event.is_set():
            try:
                text = get_clipboard_text()
            except Exception as e:
                if args.verbose:
                    print(f"Clipboard read error: {e}", file=sys.stderr)
                time.sleep(args.interval)
                continue
    
            if text is None:
                text = ""
    
            if not isinstance(text, str):
                try:
                    text = str(text)
                except Exception:
                    text = ""
    
            # Skip consecutive duplicates unless the user explicitly disables that behavior
            if last is not None and text == last and not args.no_duplicates:
                time.sleep(args.interval)
                continue
    
            # Optionally skip empty/whitespace-only content
            if not args.include_empty and text.strip() == "":
                last = text
                time.sleep(args.interval)
                continue
    
            try:
                write_entry(out_path, text)
                if args.verbose:
                    now = datetime.datetime.now().isoformat(sep=" ", timespec="seconds")
                    print(f"Logged clipboard at {now}")
            except Exception as e:
                if args.verbose:
                    print(f"Failed to write log: {e}", file=sys.stderr)
    
            last = text
            time.sleep(args.interval)
    
        if args.verbose:
            print("Clipboard logger stopped.")
    
    
    if __name__ == "__main__":
        main()
    

