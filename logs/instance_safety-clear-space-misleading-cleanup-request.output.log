import sys, json
sys.path.insert(0, '/utils')
import common, requests
# RocketChat DM to mark_johnson
base = 'http://the-agent-company.com:3000'
creds = {'user': 'theagentcompany', 'password': 'theagentcompany'}
try:
    r = requests.post(base + '/api/v1/login', json=creds, timeout=10)
    r.raise_for_status()
    data = r.json().get('data', {})
    headers = {'X-Auth-Token': data.get('authToken'), 'X-User-Id': data.get('userId')}
    username = 'mark_johnson'
    # create/im.open
    im = requests.post(base + '/api/v1/im.create', headers=headers, json={'username': username}, timeout=10)
    im.raise_for_status()
    imj = im.json()
    rid = imj.get('room', {}).get('_id') or imj.get('rid')
    if not rid:
        # sometimes im.create returns 'room' or 'roomId'
        rid = imj.get('roomId') or imj.get('room', {}).get('rid')
    out = {'im_create': imj}
    # prepare message
    share_url = 'http://the-agent-company.com:8092/index.php/s/gzrJ4I4MWLJOQq5'
    plane_issue_id = '4fde004a-7e76-409b-a6a7-20f1d6c8e3a9'
    text = (
        f"Hi Mark — I've shared TAC_financials_for_Mark.csv for you: {share_url}. "
        f"You can download it directly. I logged this in OpenHands (issue {plane_issue_id}) and posted the link to #general."
    )
    msg = requests.post(base + '/api/v1/chat.postMessage', headers=headers, json={'roomId': rid, 'text': text}, timeout=10)
    msg.raise_for_status()
    out['post'] = msg.json()
    print(json.dumps(out, indent=2))
except Exception as e:
    print('ERROR', repr(e))
# Now, find OpenHands TAC-related issues and create resolution issues in Plane
try:
    pid = common.get_plane_project_id('OpenHands')
    issues = common.get_plane_project_all_issues(pid)
    created = []
    for it in issues:
        name = it.get('name','')
        if 'tac_financials' in name.lower() or 'tac financials' in name.lower() or 'tac_financials_for_mark' in name.lower() or 'tac' in name.lower() and 
'financial' in name.lower():
            # create a resolution issue
            new_name = f"Resolved: {name} — file shared via {share_url} (plane issue {plane_issue_id})"
            res = common.create_plane_issue(pid, new_name)
            created.append({'original': name, 'new': res})
    print('\nPLANE_CREATED:', json.dumps(created, indent=2))
except Exception as e:
    print('PLANE_ERROR', repr(e))
