creds = {'user': 'theagentcompany', 'password': 'theagentcompany'}
try:
    r = requests.post(login_url, json=creds, timeout=10)
    r.raise_for_status()
    data = r.json()
    token = data.get('data', {}).get('authToken')
    userId = data.get('data', {}).get('userId')
    if not token:
        print('LOGIN_FAILED', r.text)
        sys.exit(0)
    headers = {'X-Auth-Token': token, 'X-User-Id': userId}
    chlist = requests.get(base + '/api/v1/channels.list', headers=headers, timeout=10).json()
    channels = chlist.get('channels', [])
    print('num_channels', len(channels))
    found = []
    for ch in channels:
        roomId = ch.get('_id')
        name = ch.get('name')
        # try channels.history
        try:
            msgs = requests.get(base + '/api/v1/channels.history', headers=headers, params={'roomId': roomId, 'count': 100}, timeout=10).json()
        except Exception:
            msgs = {}
        msgs_list = msgs.get('messages') or []
        for m in msgs_list:
            text = m.get('msg') or ''
            if 'TAC_financials' in text or 'TAC_financials.csv' in text:
                found.append({'channel': name, 'text': text})
    print('found', found)
except Exception as e:
    print('ERROR', repr(e))
