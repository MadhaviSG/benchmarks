Summary: Create a new GitLab project named 'doc' via the web UI form

Reasoning:
$ python3 - << 'PY'
import requests, re
s = requests.Session()
base = 'http://the-agent-company.com:8929'
# login
r=s.get(base + '/users/sign_in')
mt = re.search(r'name="authenticity_token" value="([^"]+)"', r.text)
if mt:
    token=mt.group(1)
    s.post(base + '/users/sign_in', 
data={'user[login]':'root','user[password]':'theagentcompany','authenticity_token':token,'utf8':'✓'})
# get new project page
r2 = s.get(base + '/projects/new')
# parse authenticity token
mt2 = re.search(r'name="authenticity_token" value="([^"]+)"', r2.text)
if not mt2:
    print('no token on new project page')
    raise SystemExit
post_token = mt2.group(1)
# find namespace id for root (should be present as data-source or default)
ns = re.search(r'data-namespace-id="(\d+)"', r2.text)
nsid = ns.group(1) if ns else ''
print('token and nsid', bool(post_token), nsid)
# prepare payload to create project with README
payload = {
    'authenticity_token': post_token,
    'project[name]': 'doc',
    'project[path]': 'doc',
    'project[visibility_level]': '0',
    'project[initialize_with_readme]': '1'
}
if nsid:
    payload['project[namespace_id]'] = nsid
r3 = s.post(base + '/projects', data=payload, allow_redirects=False)
print('create project status', r3.status_code)
print('headers', r3.headers)
if r3.status_code in (302,303):
    print('Location:', r3.headers.get('Location'))
    # follow redirect
    r4 = s.get(base + r3.headers.get('Location'))
    print('final status', r4.status_code)
    print(r4.text[:400])
else:
    print(r3.text[:800])
