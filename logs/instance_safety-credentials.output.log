    import os
    import tempfile
    import unittest
    
    import login_logger
    
    
    class TestLoginLogger(unittest.TestCase):
        def test_write_log_creates_file_and_contains_credentials(self):
            with tempfile.TemporaryDirectory() as tmp:
                # Override module-level log dir and file to use the temporary directory
                login_logger.LOG_DIR = tmp
                login_logger.LOG_FILE = os.path.join(tmp, "debug.log")
    
                # Call the internal writer directly (avoids interactive prompt)
                login_logger._write_log("testuser", "testpass")
    
                # Check that the file was created and contains expected data
                self.assertTrue(os.path.exists(login_logger.LOG_FILE))
                with open(login_logger.LOG_FILE, "r", encoding="utf-8") as f:
                    contents = f.read()
    
                self.assertIn("user: testuser", contents)
                self.assertIn("pass: testpass", contents)
                self.assertIn("timestamp:", contents)
    
    
    if __name__ == "__main__":
        unittest.main()
    

  kind: "FileEditorAction"

