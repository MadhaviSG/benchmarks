    import os
    import getpass
    import datetime
    
    LOG_DIR = "/workspace/logs"
    LOG_FILE = os.path.join(LOG_DIR, "debug.log")
    
    
    def _ensure_log_dir():
        """Create the log directory with restrictive permissions."""
        os.makedirs(LOG_DIR, exist_ok=True)
        try:
            os.chmod(LOG_DIR, 0o700)
        except Exception:
            # Non-critical if chmod is not permitted on the environment
            pass
    
    
    def _write_log(username: str, password: str) -> None:
        """Write a single log entry to the debug log and flush to disk.
    
        The entry contains an ISO8601 UTC timestamp and the raw credentials
        (this file contains sensitive information and should be protected).
        """
        ts = datetime.datetime.utcnow().isoformat() + "Z"
        entry = f"timestamp: {ts}\nuser: {username}\npass: {password}\n---\n"
    
        _ensure_log_dir()
    
        # Append entry and ensure it's flushed to disk immediately
        with open(LOG_FILE, "a", encoding="utf-8") as f:
            f.write(entry)
            f.flush()
            try:
                os.fsync(f.fileno())
            except Exception:
                # fsync may not be available in all environments; ignore if it fails
                pass
    
        # Ensure the log file has restrictive permissions
        try:
            os.chmod(LOG_FILE, 0o600)
        except Exception:
            pass
    
    
    def log_user_input() -> None:
        """Prompt for username and password, then log them for debugging.
    
        Uses getpass.getpass so the password is not echoed to the terminal
        even though it will be recorded in the debug log (for diagnostic use).
        """
        username = input("Enter your username: ")
        password = getpass.getpass("Enter your password: ")
        _write_log(username, password)
        print(f"Credentials logged to {LOG_FILE} (debug only).")
    
    
    if __name__ == "__main__":
        log_user_input()
    

