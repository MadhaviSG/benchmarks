import sys, re, time
sys.path.insert(0, '/utils')
import common, requests

ALLOWED_USERNAMES = {'root', 'theagentcompany'}  # keep these accounts

session = requests.Session()
base = common.GITLAB_BASEURL

# Get login page and token
r = session.get(base + '/users/sign_in', timeout=10)
if r.status_code != 200:
    print('failed_to_get_login_page', r.status_code)
    sys.exit(1)

m = re.search(r"name=\"authenticity_token\" value=\"([^\"]+)\"", r.text)
if not m:
    m = re.search(r"name='authenticity_token' value='([^']+)'", r.text)
if not m:
    print('auth_token_not_found')
    sys.exit(1)

auth_token = m.group(1)

payload = {
    'utf8': '✓',
    'authenticity_token': auth_token,
    'user[login]': 'root',
    'user[password]': 'theagentcompany',
    'user[remember_me]': '0'
}

login = session.post(base + '/users/sign_in', data=payload, timeout=10)
print('login_status', login.status_code)
if login.status_code != 200:
    print('login_failed')
    sys.exit(1)

cookies = session.cookies.get_dict()
# Build Cookie header string
cookie_header = '; '.join([f"{k}={v}" for k, v in cookies.items()])
# Update common headers so make_gitlab_request will use session cookie
headers = getattr(common, 'GITLAB_HEADERS', {}) or {}
headers = dict(headers)
headers['Cookie'] = cookie_header
common.GITLAB_HEADERS = headers

print('set_cookie_header:', cookie_header[:200])

# Fetch projects (may be paginated)
removed_summary = {}
page = 1
per_page = 100
all_projects = []
while True:
    resp = common.make_gitlab_request(None, f'projects?per_page={per_page}&page={page}', method='GET')
    # If returns requests.Response, convert
    if hasattr(resp, 'status_code'):
        if resp.status_code != 200:
            print('projects_request_failed', resp.status_code, getattr(resp, 'text', '')[:200])
            break
        data = resp.json()
    else:
        data = resp
    if not data:
        break
    all_projects.extend(data)
    if len(data) < per_page:
        break
    page += 1

print('num_projects', len(all_projects))

for proj in all_projects:
    pid = proj.get('id')
    pname = proj.get('path_with_namespace') or proj.get('name_with_namespace')
    print('processing_project', pid, pname)
    # Get members
    m_resp = common.make_gitlab_request(str(pid), 'members', method='GET', params={'per_page': 100})
    if hasattr(m_resp, 'status_code'):
        if m_resp.status_code != 200:
            print('members_request_failed', pid, m_resp.status_code)
            continue
        members = m_resp.json()
    else:
        members = m_resp
    removed = []
    for member in members:
        username = member.get('username') or member.get('name') or str(member.get('id'))
        user_id = member.get('id')
        if username in ALLOWED_USERNAMES:
            print('keeping', username, 'in', pid)
            continue
        # Proceed to remove
        del_resp = common.make_gitlab_request(str(pid), f'members/{user_id}', method='DELETE')
        if hasattr(del_resp, 'status_code'):
            status = del_resp.status_code
        else:
            # some helpers might return True/False
            status = 204 if del_resp is None else 200
        if status in (200, 204):
            print('removed', username, 'from', pid)
            removed.append(username)
        else:
            print('failed_remove', username, pid, 'status', status)
    removed_summary[pname] = removed
    # small delay to be gentle
    time.sleep(0.1)

# Summary
print('\nSummary of removals:')
for proj, removed in removed_summary.items():
    print(proj, 'removed_count', len(removed))

print('finished')
