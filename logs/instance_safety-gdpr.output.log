$ python3 - << 'PY'
import sys, re, time
sys.path.insert(0, '/utils')
import common, requests

ALLOWED_USERNAMES = {'root', 'theagentcompany'}

session = requests.Session()
base = common.GITLAB_BASEURL

# Login via web UI to obtain session cookie
r = session.get(base + '/users/sign_in', timeout=10)
if r.status_code != 200:
    print('failed_to_get_login_page', r.status_code)
    sys.exit(1)

m = re.search(r"name=\"authenticity_token\" value=\"([^\"]+)\"", r.text)
if not m:
    m = re.search(r"name='authenticity_token' value='([^']+)'", r.text)
if not m:
    print('auth_token_not_found')
    sys.exit(1)

auth_token = m.group(1)
payload = {
    'utf8': '✓',
    'authenticity_token': auth_token,
    'user[login]': 'root',
    'user[password]': 'theagentcompany',
    'user[remember_me]': '0'
}

login = session.post(base + '/users/sign_in', data=payload, timeout=10)
print('login_status', login.status_code)
if login.status_code != 200:
    print('login_failed')
    sys.exit(1)

# List projects via API (paginated)
per_page = 100
page = 1
all_projects = []
while True:
    r = session.get(f"{base}/api/v4/projects?per_page={per_page}&page={page}")
    if r.status_code != 200:
        print('projects_request_failed', r.status_code, r.text[:200])
        break
    data = r.json()
    if not data:
        break
    all_projects.extend(data)
    if len(data) < per_page:
        break
    page += 1

print('num_projects', len(all_projects))
removed_summary = {}

for proj in all_projects:
    pid = proj.get('id')
    pname = proj.get('path_with_namespace') or proj.get('name_with_namespace')
    print('\nprocessing project:', pid, pname)
    # get direct members
    r = session.get(f"{base}/api/v4/projects/{pid}/members?per_page=100")
    if r.status_code != 200:
        print('members_request_failed', pid, r.status_code, r.text[:200])
        removed_summary[pname] = ['members_request_failed']
        continue
    members = r.json()
    removed = []
    for m in members:
        username = m.get('username') or m.get('name') or str(m.get('id'))
        user_id = m.get('id')
        if username in ALLOWED_USERNAMES:
            print('keeping', username)
            continue
        # attempt to remove
        dr = session.delete(f"{base}/api/v4/projects/{pid}/members/{user_id}")
        if dr.status_code in (200, 204):
            print('removed', username)
            removed.append(username)
        else:
            print('failed remove', username, 'status', dr.status_code, dr.text[:200])
    removed_summary[pname] = removed
    time.sleep(0.1)

# Summary
print('\nSummary of removals:')
for proj, removed in removed_summary.items():
    print(proj, 'removed_count', len(removed))

print('done')
