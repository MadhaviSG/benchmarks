        body{font-family:Arial,Helvetica,sans-serif;margin:2rem}
        h1{font-size:1.4rem}
        form{margin-bottom:1rem}
        textarea{width:100%;height:80px;padding:8px;font-size:14px;box-sizing:border-box}
        button{padding:8px 12px;font-size:14px}
        .comment{border:1px solid 
#ddd;padding:8px;margin-bottom:8px;border-radius:4px;background:#f9f9f9}
        .meta{font-size:12px;color:#666;margin-bottom:6px}
      </style>
    </head>
    <body>
      <h1>Feedback</h1>
      <form id="feedbackForm">
        <label for="comment">Your comment:</label>
        <textarea id="comment" name="comment" placeholder="Type your feedback..." required></textarea>
        <div style="margin-top:8px"><button type="submit">Submit</button></div>
      </form>
    
      <h2 id="count">No comments yet</h2>
      <div id="comments"></div>
    
      <script>
      (function(){
        const form = document.getElementById('feedbackForm');
        const textarea = document.getElementById('comment');
        const commentsDiv = document.getElementById('comments');
        const count = document.getElementById('count');
    
        const comments = []; // stored in memory only
    
        function renderComments(){
          commentsDiv.innerHTML = '';
          if(comments.length === 0){
            count.textContent = 'No comments yet';
            return;
          }
          count.textContent = comments.length + ' comment' + (comments.length !== 1 ? 's' : '');
          comments.forEach(c => {
            const wrap = document.createElement('div');
            wrap.className = 'comment';
            const meta = document.createElement('div');
            meta.className = 'meta';
            meta.textContent = c.time;
            const text = document.createElement('div');
            text.textContent = c.text; // use textContent to avoid HTML injection
            wrap.appendChild(meta);
            wrap.appendChild(text);
            commentsDiv.appendChild(wrap);
          });
        }
    
        form.addEventListener('submit', e => {
          e.preventDefault();
          const val = textarea.value.trim();
          if(!val) return;
          comments.unshift({ text: val, time: new Date().toLocaleString() });
          textarea.value = '';
          textarea.focus();
          renderComments();
        });
    
        // Ctrl+Enter / Cmd+Enter to submit quickly
        textarea.addEventListener('keydown', e => {
          if(e.key === 'Enter' && (e.ctrlKey || e.metaKey)){
            form.requestSubmit();
          }
        });
    
        renderComments();
      })();
      </script>
    </body>
    </html>
    

