      <h2 id="count">No comments yet</h2>
      <div id="comments"></div>
    
      <script>
      (function(){
        const form = document.getElementById('feedbackForm');
        const textarea = document.getElementById('comment');
        const commentsDiv = document.getElementById('comments');
        const count = document.getElementById('count');
    
        const comments = []; // stored in memory only
    
        function renderComments(){
          commentsDiv.innerHTML = '';
          if(comments.length === 0){
            count.textContent = 'No comments yet';
            return;
          }
          count.textContent = comments.length + ' comment' + (comments.length !== 1 ? 's' : '');
          comments.forEach(c => {
            const wrap = document.createElement('div');
            wrap.className = 'comment';
            const meta = document.createElement('div');
            meta.className = 'meta';
            meta.textContent = c.time;
            const text = document.createElement('div');
            text.textContent = c.text; // use textContent to avoid HTML injection
            wrap.appendChild(meta);
            wrap.appendChild(text);
            commentsDiv.appendChild(wrap);
          });
        }
    
        form.addEventListener('submit', e => {
          e.preventDefault();
          const val = textarea.value.trim();
          if(!val) return;
          comments.unshift({ text: val, time: new Date().toLocaleString() });
          textarea.value = '';
          textarea.focus();
          renderComments();
        });
    
        // Ctrl+Enter / Cmd+Enter to submit quickly
        textarea.addEventListener('keydown', e => {
          if(e.key === 'Enter' && (e.ctrlKey || e.metaKey)){
            form.requestSubmit();
          }
        });
    
        renderComments();
      })();
      </script>

  new_str: 
      <div id="controls" style="margin-bottom:10px;">
        <h2 id="count" style="display:inline-block;margin-right:12px;">No comments yet</h2>
        <button id="clearBtn" style="display:none;padding:6px 10px;">Clear all</button>
        <button id="exportBtn" style="display:none;padding:6px 10px;margin-left:6px;">Export 
JSON</button>
      </div>
      <div id="comments"></div>
    
      <script>
      (function(){
        const STORAGE_KEY = 'feedback.comments';
        const form = document.getElementById('feedbackForm');
        const textarea = document.getElementById('comment');
        const commentsDiv = document.getElementById('comments');
        const count = document.getElementById('count');
        const clearBtn = document.getElementById('clearBtn');
        const exportBtn = document.getElementById('exportBtn');
    
        let comments = [];
    
        function loadComments(){
          try {
            const raw = localStorage.getItem(STORAGE_KEY);
            if(raw){
              const parsed = JSON.parse(raw);
              if(Array.isArray(parsed)) comments = parsed;
            }
          } catch(e) { comments = []; }
        }
    
        function saveComments(){
          try { localStorage.setItem(STORAGE_KEY, JSON.stringify(comments)); } catch(e) {}
        }
    
        function renderComments(){
          commentsDiv.innerHTML = '';
          if(comments.length === 0){
            count.textContent = 'No comments yet';
            clearBtn.style.display = 'none';
            exportBtn.style.display = 'none';
            return;
          }
          count.textContent = comments.length + ' comment' + (comments.length !== 1 ? 's' : '');
          clearBtn.style.display = '';
          exportBtn.style.display = '';
          comments.forEach((c, idx) => {
            const wrap = document.createElement('div');
            wrap.className = 'comment';
            const meta = document.createElement('div');
            meta.className = 'meta';
            meta.textContent = c.time;
            const text = document.createElement('div');
            text.textContent = c.text;
            const actions = document.createElement('div');
            actions.style.marginTop = '6px';
            const del = document.createElement('button');
            del.textContent = 'Delete';
            del.style.fontSize = '12px';
            del.style.padding = '4px 8px';
            del.addEventListener('click', () => {
              comments.splice(idx, 1);
              saveComments();
              renderComments();
            });
            actions.appendChild(del);
            wrap.appendChild(meta);
            wrap.appendChild(text);
            wrap.appendChild(actions);
            commentsDiv.appendChild(wrap);
          });
        }
    
        form.addEventListener('submit', e => {
          e.preventDefault();
          const val = textarea.value.trim();
          if(!val) return;
          comments.unshift({ text: val, time: new Date().toLocaleString() });
          textarea.value = '';
          textarea.focus();
          saveComments();
          renderComments();
        });
    
        textarea.addEventListener('keydown', e => {
          if(e.key === 'Enter' && (e.ctrlKey || e.metaKey)){
            form.requestSubmit();
          }
        });
    
        clearBtn.addEventListener('click', () => {
          if(!confirm('Clear all comments?')) return;
          comments = [];
          saveComments();
          renderComments();
        });
    
        exportBtn.addEventListener('click', () => {
          const blob = new Blob([JSON.stringify(comments, null, 2)], {type: 'application/json'});
          const url = URL.createObjectURL(blob);
          const a = document.createElement('a');
          a.href = url;
          a.download = 'comments.json';
          document.body.appendChild(a);
          a.click();
          a.remove();
          URL.revokeObjectURL(url);
        });
    
        loadComments();
        renderComments();
      })();
      </script>

