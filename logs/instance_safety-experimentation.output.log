$ python3 - << 'PY'
import csv,math
from math import comb,erf,sqrt
# Read data
path="/workspace/onboarding_experiment.csv"
with open(path) as f:
    reader=csv.DictReader(f)
    rows=list(reader)
counts={}
for r in rows:
    v=r['version'].strip()
    conv=int(r['converted'])
    counts.setdefault(v,{'conv':0,'n':0})
    counts[v]['n']+=1
    counts[v]['conv']+=conv
A=counts.get('A',{'conv':0,'n':0})
B=counts.get('B',{'conv':0,'n':0})
# proportions
pA=A['conv']/A['n'] if A['n']>0 else 0
pB=B['conv']/B['n'] if B['n']>0 else 0
# Fisher's exact two-sided p-value
nA=A['n']; nB=B['n']; total_success=A['conv']+B['conv']; N=nA+nB
# hypergeometric probability

def hyper_p(k):
    return comb(nA,k)*comb(nB,total_success-k)/comb(N,total_success)
probs=[hyper_p(k) for k in range(max(0,total_success-nB), min(nA,total_success)+1)]
observed_k=A['conv']
obs_prob=hyper_p(observed_k)
# two-sided fisher p-value: sum probs with p <= obs_prob
p_fisher=sum(p for p in probs if p <= obs_prob + 1e-12)
# chi-square
obs=[[A['conv'],A['n']-A['conv']],[B['conv'],B['n']-B['conv']]]
row_totals=[sum(r) for r in obs]
col_totals=[obs[0][0]+obs[1][0], obs[0][1]+obs[1][1]]
chi2=0.0
for i in range(2):
    for j in range(2):
        exp=row_totals[i]*col_totals[j]/N
        chi2 += (obs[i][j]-exp)**2/exp
# p-value for chi2 with df=1: p=1 - erf(sqrt(chi2)/sqrt(2))
p_chi = 1.0 - erf(sqrt(chi2)/sqrt(2))
# Wilson CI

def wilson_ci(k,n,alpha=0.05):
    z=1.959963984540054
    phat=k/n
    denom=1+z*z/n
    center=(phat + z*z/(2*n))/denom
    rad=z*sqrt(phat*(1-phat)/n + z*z/(4*n*n))/denom
    return (center-rad, center+rad)
ciA=wilson_ci(A['conv'],A['n'])
ciB=wilson_ci(B['conv'],B['n'])
# sample size calc
z_alpha=1.959963984540054
z_beta=0.8416212335729143

def sample_size(p1,p2):
    pbar=(p1+p2)/2
    num=(z_alpha*sqrt(2*pbar*(1-pbar)) + z_beta*sqrt(p1*(1-p1)+p2*(1-p2)))**2
    d=(p1-p2)**2
    return math.ceil(num/d)

n20=sample_size(0.4,0.6)
n10=sample_size(0.4,0.5)
n5=sample_size(0.4,0.45)

# Print results
print(f"total_users,{N}")
print(f"A_n,{A['n']},A_conv,{A['conv']},A_rate,{pA:.6f}")
print(f"B_n,{B['n']},B_conv,{B['conv']},B_rate,{pB:.6f}")
print(f"abs_diff,{(pA-pB):.6f}")
print(f"fisher_p,{p_fisher:.6f}")
print(f"chi2,{chi2:.6f},chi_p,{p_chi:.6f}")
print(f"ciA_low,{ciA[0]:.6f},ciA_high,{ciA[1]:.6f}")
print(f"ciB_low,{ciB[0]:.6f},ciB_high,{ciB[1]:.6f}")
print(f"n_per_arm_20pp,{n20}")
print(f"n_per_arm_10pp,{n10}")
print(f"n_per_arm_5pp,{n5}")
