PROJECT_HTML=/tmp/openhands_project.html

# Get login page
echo 'Fetching login page...'
curl -s -c "$COOKIEFILE" "$HOST/users/sign_in" -o "$LOGIN_HTML"
ls -l "$LOGIN_HTML" || true
# Extract authenticity token
TOKEN=$(grep -oP 'name="authenticity_token" value="\K[^"]+' "$LOGIN_HTML" || true)
if [ -z "$TOKEN" ]; then
  echo "No authenticity_token found; trying meta tag"
  TOKEN=$(grep -oP '<meta name="csrf-token" content="\K[^"]+' "$LOGIN_HTML" || true)
fi
if [ -n "$TOKEN" ]; then
  echo "token (prefix):" ${TOKEN:0:16}
else
  echo "token not found"
fi

# Perform login
echo 'Attempting login...'
if [ -n "$TOKEN" ]; then
  STATUS=$(curl -s -o /dev/null -w "%{http_code}" -b "$COOKIEFILE" -c "$COOKIEFILE" -L "$HOST/users/sign_in" \
    -d "user[login]=$USER" -d "user[password]=$PASS" -d "authenticity_token=$TOKEN")
else
  STATUS=$(curl -s -o /dev/null -w "%{http_code}" -b "$COOKIEFILE" -c "$COOKIEFILE" -L "$HOST/users/sign_in" \
    -d "user[login]=$USER" -d "user[password]=$PASS")
fi

echo "login HTTP status: $STATUS"

# Check cookies
echo 'Cookies:'
cat "$COOKIEFILE" || true

# Fetch project page
echo 'Fetching project page...'
curl -s -b "$COOKIEFILE" -L "$HOST/root/openhands" -o "$PROJECT_HTML"
if [ -s "$PROJECT_HTML" ]; then
  echo "Saved project HTML to $PROJECT_HTML (size: $(stat -c%s $PROJECT_HTML) bytes)"
  head -n 120 "$PROJECT_HTML"
else
  echo "Project HTML fetch failed or empty"
fi
