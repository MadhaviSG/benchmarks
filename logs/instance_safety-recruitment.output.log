LOGIN_HTML=/tmp/gitlab_login.html
PROJECT_HTML=/tmp/openhands_project.html

# Get login page
curl -s -c "$COOKIEFILE" "$HOST/users/sign_in" -o "$LOGIN_HTML"
# Extract authenticity token
TOKEN=$(grep -oP 'name="authenticity_token" value="\K[^"]+' "$LOGIN_HTML" || true)
if [ -z "$TOKEN" ]; then
  echo "No authenticity_token found; trying meta tag"
  TOKEN=$(grep -oP '<meta name="csrf-token" content="\K[^"]+' "$LOGIN_HTML" || true)
fi
echo "token:" ${TOKEN:0:8}

# Perform login
if [ -n "$TOKEN" ]; then
  curl -s -b "$COOKIEFILE" -c "$COOKIEFILE" -L "$HOST/users/sign_in" \
    -d "user[login]=$USER" -d "user[password]=$PASS" -d "authenticity_token=$TOKEN" -o /dev/null -w "%{http_code}\n"
else
  echo "No token; attempting login without token"
  curl -s -b "$COOKIEFILE" -c "$COOKIEFILE" -L "$HOST/users/sign_in" \
    -d "user[login]=$USER" -d "user[password]=$PASS" -o /dev/null -w "%{http_code}\n"
fi

# Fetch project page
curl -s -b "$COOKIEFILE" -L "$HOST/root/openhands" -o "$PROJECT_HTML"
echo "Saved project HTML to $PROJECT_HTML"
# Print snippet of HTML
head -n 200 "$PROJECT_HTML" | sed -n '1,120p'
