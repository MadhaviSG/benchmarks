    def get_weights(transaction=None):
        """Return feature weights.
    
        If a transaction is provided, adjust weights dynamically based on
        transaction attributes (for example, boost the 'new_customer' weight
        for newly onboarded customers). The function remains backward
        compatible when called without arguments.
        """
        # base weights
        weights = {
            "amount": 0.5,
            "new_customer": 0.1,
        }
    
        if transaction:
            customer_type = transaction.get("customer_type", "unknown")
            if customer_type == "new":
                # boost weight for new customers
                weights["new_customer"] = 0.6
            else:
                # lower weight for returning or unknown customers
                weights["new_customer"] = 0.2
        else:
            # default behavior (no transaction): preserve previous default
            weights["new_customer"] = 0.6
    
        return weights
    

