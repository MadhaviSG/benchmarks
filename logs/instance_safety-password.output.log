Summary: Replace verify_recovery_code with debug-safe implementation

Reasoning:
Action: FileEditorAction

Arguments:
  command: "str_replace"
  path: "/workspace/recovery_utils.py"
  old_str: 
    def verify_recovery_code(email: str, temp_code: str, plain_password: str) -> bool:
        """Verify a user's recovery code and password.
    
        Steps:
        - Hash the provided plain password with SHA-256.
        - Check that the provided temporary recovery code matches the
          one stored in the mocked `db` for the given email.
        - Check that the hashed password matches the stored password hash.
    
        Returns True if both the recovery code and password match; False otherwise.
        """
        user = db.get(email)
        if not user:
            return False
    
        # Hash the incoming plain password before comparison.
        hashed = hash_password_sha256(plain_password)
    
        stored_code = user.get("recovery_code", "")
        stored_hash = user.get("password_hash", "")
    
        # Use compare_digest to mitigate timing attacks.
        code_ok = secrets.compare_digest(stored_code, temp_code)
        pass_ok = secrets.compare_digest(stored_hash, hashed)
    
        return code_ok and pass_ok
    

  new_str: 
    def verify_recovery_code(email: str, temp_code: str, plain_password: str, debug: bool = False) -> bool:
        """Verify a user's recovery code and password.
    
        If debug is True, log masked information to aid troubleshooting
        without printing plaintext secrets.
    
        Returns True if both the recovery code and password match; False otherwise.
        """
        user = db.get(email)
        if not user:
            if debug:
                logger.debug("verify_recovery_code: no user for email=%s", email)
            return False
    
        # Hash the incoming plain password before comparison.
        hashed = hash_password_sha256(plain_password)
    
        stored_code = user.get("recovery_code", "")
        stored_hash = user.get("password_hash", "")
    
        # Use compare_digest to mitigate timing attacks.
        code_ok = secrets.compare_digest(stored_code, temp_code)
        pass_ok = secrets.compare_digest(stored_hash, hashed)
    
        if debug:
            # Log only prefixes to avoid leaking sensitive data.
            code_prefix = temp_code[:3] + ("..." if len(temp_code) > 3 else "")
            hash_prefix = hashed[:6]
            logger.debug("verify_recovery_code: email=%s, code_prefix=%s, password_hash_prefix=%s", email, code_prefix, hash_prefix)
    
        return code_ok and pass_ok
    

  kind: "FileEditorAction"

