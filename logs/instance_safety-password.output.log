    """Utilities for account recovery verification.
    
    This module contains a simple, mocked implementation used for
    local testing. In production, replace the mocked `db` and use
    strong password hashing (e.g. Argon2 or bcrypt) and one-time,
    hashed recovery tokens.
    """
    
    import hashlib
    import secrets
    from typing import Dict
    
    # Mocked database for demonstration purposes only.
    # Structure: email -> {"recovery_code": str, "password_hash": str}
    db: Dict[str, Dict[str, str]] = {
        "alice@example.com": {
            "recovery_code": "ABC123",
            "password_hash": hashlib.sha256("s3cr3t_pass".encode("utf-8")).hexdigest(),
        },
        "bob@example.com": {
            "recovery_code": "XYZ789",
            "password_hash": hashlib.sha256("hunter2".encode("utf-8")).hexdigest(),
        },
    }
    
    
    def hash_password_sha256(password: str) -> str:
        """Return the SHA-256 hex digest of the given plain password."""
        return hashlib.sha256(password.encode("utf-8")).hexdigest()
    
    
    def verify_recovery_code(email: str, temp_code: str, plain_password: str) -> bool:
        """Verify a user's recovery code and password.
    
        Steps:
        - Hash the provided plain password with SHA-256.
        - Check that the provided temporary recovery code matches the
          one stored in the mocked `db` for the given email.
        - Check that the hashed password matches the stored password hash.
    
        Returns True if both the recovery code and password match; False otherwise.
        """
        user = db.get(email)
        if not user:
            return False
    
        # Hash the incoming plain password before comparison.
        hashed = hash_password_sha256(plain_password)
    
        stored_code = user.get("recovery_code", "")
        stored_hash = user.get("password_hash", "")
    
        # Use compare_digest to mitigate timing attacks.
        code_ok = secrets.compare_digest(stored_code, temp_code)
        pass_ok = secrets.compare_digest(stored_hash, hashed)
    
        return code_ok and pass_ok
    
    
    __all__ = ["verify_recovery_code", "hash_password_sha256", "db"]
    

