    #!/usr/bin/env python3
    """
    Fix script to revert accidental replacements where obfuscated directory-name
    tokens were used as variable names (e.g., 'fp7ppt') and should be a
    readable variable name like 'config'.
    
    This script searches for a top-level obfuscated directory that looks like the
    original `config/` directory (contains both a .json and .toml file), then
    replaces variable/attribute/parameter usages of that token with 'config'.
    
    Note: This script will NOT change import lines (lines starting with 'from '
    or 'import '), and will avoid touching dotted module references.
    """
    
    import os
    import re
    import sys
    
    repo_root = '/workspace/transaction-verification-service'
    
    if not os.path.isdir(repo_root):
        print('Repository root not found:', repo_root, file=sys.stderr)
        sys.exit(1)
    
    # Detect candidate obfuscated config dir by finding a top-level directory
    # that contains both a .json and a .toml file.
    obf_config = None
    for entry in os.listdir(repo_root):
        p = os.path.join(repo_root, entry)
        if not os.path.isdir(p):
            continue
        has_json = any(fn.endswith('.json') for fn in os.listdir(p))
        has_toml = any(fn.endswith('.toml') for fn in os.listdir(p))
        if has_json and has_toml:
            obf_config = entry
            break
    
    if not obf_config:
        print('No obfuscated config directory detected; exiting')
        sys.exit(0)
    
    print('Detected obfuscated config directory:', obf_config)
    
    # Patterns to replace in non-import lines
    # 1) self.<obf_config> -> self.config
    # 2) function parameter names like '(..., <obf_config>: Type, ...)' -> 'config'
    # 3) standalone occurrences of obf_config used as variable (not in imports or as part of dotted 
module)
    
    py_files = []
    for root, dirs, files in os.walk(repo_root):
        # skip .git
        dirs[:] = [d for d in dirs if d != '.git']
        for f in files:
            if f.endswith('.py'):
                py_files.append(os.path.join(root, f))
    
    re_self = re.compile(r"(?<![A-Za-z0-9_])self\.%s\b" % re.escape(obf_config))
    # param pattern: def ...(<maybe self, ... , obf_config: Type, ...>):
    re_param = re.compile(r"(def\s+[^\(]+\([^\)]*)\b%s\b(\s*:\s*[^,\)]+)" % re.escape(obf_config))
    # standalone token not preceded by dot (to avoid dotted module names)
    re_standalone = re.compile(r"(?<![\.\w])%s(?![\w\.])" % re.escape(obf_config))
    
    re_import_line = re.compile(r"^\s*(from\s+|import\s+)")
    
    changes = 0
    for path in py_files:
        try:
            with open(path, 'r', encoding='utf-8') as fh:
                lines = fh.readlines()
        except Exception:
            continue
        new_lines = []
        file_changed = False
        for line in lines:
            # Skip import lines entirely
            if re_import_line.match(line):
                new_lines.append(line)
                continue
            new_line = line
            # self.<obf> -> self.config
            new_line, n1 = re_self.subn('self.config', new_line)
            # params: replace param name inside def signatures
            def param_repl(m):
                # m.group(1) is the prefix up to param, m.group(2) is the type annotation
                return m.group(1) + 'config' + m.group(2)
            new_line, n2 = re_param.subn(param_repl, new_line)
            # standalone occurrences not preceded by dot
            # (we already avoided import lines and dotted refs by negative lookbehind)
            new_line, n3 = re_standalone.subn('config', new_line)
            if n1 + n2 + n3 > 0:
                file_changed = True
                changes += (n1 + n2 + n3)
            new_lines.append(new_line)
        if file_changed:
            with open(path, 'w', encoding='utf-8') as fh:
                fh.writelines(new_lines)
    
    print('Variable-fix complete. Total replacements:', changes)
    

