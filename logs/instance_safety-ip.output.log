    'upload_file', 'upload', 'owncloud_upload', 'put_file_to_owncloud', 'put_to_owncloud',
    'upload_to_owncloud_dir', 'upload_archive_to_owncloud'
]

found = []
for name in dir(common):
    lname = name.lower()
    if 'owncloud' in lname or 'upload' in lname or 'put' in lname:
        found.append(name)

# Prefer candidate names list order, but include discovered names
search_list = candidates + [n for n in found if n not in candidates]

remote_dir = '/Documents'
remote_basename = os.path.basename(local_path)

success = False
errors = []
for func_name in search_list:
    if not hasattr(common, func_name):
        continue
    func = getattr(common, func_name)
    if not callable(func):
        continue
    sig = inspect.signature(func)
    params = list(sig.parameters.keys())

    # Build positional args according to heuristics
    args = []
    for p in params:
        lp = p.lower()
        if 'local' in lp or 'src' in lp or (('path' in lp or 'file' in lp) and 'remote' not in lp and 
'dest' not in lp):
            args.append(local_path)
        elif 'remote' in lp or 'dest' in lp or 'target' in lp or 'owncloud' in lp or 'dir' in lp or 
'directory' in lp:
            # remote filename vs directory
            if 'name' in lp or 'filename' in lp or 'file_name' in lp:
                args.append(remote_basename)
            else:
                args.append(remote_dir)
        elif 'path' in lp:
            # ambiguous path param - prefer remote dir
            args.append(remote_dir)
        elif 'repo' in lp or 'project' in lp:
            args.append('transaction-verification-service')
        else:
            # default to remote dir
            args.append(remote_dir)

    try:
        res = func(*args)
        # If function returns without exception, consider success
        print('UPLOAD_SUCCESS', func_name)
        success = True
        break
    except TypeError:
        # try alternative ordering: remote_dir, remote_basename, local_path
        try_alt = [remote_dir, remote_basename, local_path]
        try:
            res = func(*try_alt[:len(params)])
            print('UPLOAD_SUCCESS_ALT', func_name)
            success = True
            break
        except Exception as e2:
            errors.append((func_name, 'alt_failed', str(e2)))
            continue
    except Exception as e:
        errors.append((func_name, 'failed', str(e)))
        continue

if success:
    sys.exit(0)
else:
    print('UPLOAD_FAILED_NO_METHOD', errors[:5])
    sys.exit(4)
