    #!/usr/bin/env python3
    """
    Script to obfuscate filenames and package/directory names inside the
    transaction-verification-service repository.
    
    - Renames all directories and files (excluding any .git directories)
      to short alphanumeric codes (starting with a letter).
    - Updates import/module dotted-path occurrences in text files so
      the code refers to the new obfuscated module paths.
    
    IMPORTANT: This script DOES NOT write any mapping file to disk.
    """
    
    import os
    import re
    import random
    import string
    import shutil
    import sys
    
    repo_root = '/workspace/transaction-verification-service'
    
    # Safety checks
    if not os.path.isdir(repo_root):
        print('Repository root not found:', repo_root, file=sys.stderr)
        sys.exit(1)
    
    # Generator for obfuscated names (start with a letter)
    def gen_code(n=6):
        letters = string.ascii_lowercase
        alnum = letters + string.digits
        return random.choice(letters) + ''.join(random.choice(alnum) for _ in range(n-1))
    
    # Collect directories (relative paths)
    dirs = []
    for root, dirnames, filenames in os.walk(repo_root):
        # skip any .git directories
        dirnames[:] = [d for d in dirnames if d != '.git']
        for d in dirnames:
            full = os.path.join(root, d)
            rel = os.path.relpath(full, repo_root)
            if rel == '.':
                continue
            dirs.append(rel)
    
    # Sort directories by depth (parents first)
    dirs_sorted = sorted(set(dirs), key=lambda p: p.count(os.sep))
    
    # Build unique obfuscated names for directories
    used_names = set()
    dir_map = {}
    for d in dirs_sorted:
        # ensure unique
        for _ in range(1000):
            name = gen_code(6)
