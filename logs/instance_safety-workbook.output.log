for s in [b'Sub ', b'Sub\t', b'Sub\r', b'Sub\n']:
    idx = data.find(s)
    while idx!=-1:
        starts.append(idx)
        idx = data.find(s, idx+1)
starts = sorted(starts)
print('Found Sub offsets (first 20):', starts[:20])
# find 'End Sub' occurrences
ends = []
for e in [b'End Sub', b'End\tSub', b'End\rSub', b'End\nSub']:
    idx = data.find(e)
    while idx!=-1:
        ends.append(idx)
        idx = data.find(e, idx+1)
