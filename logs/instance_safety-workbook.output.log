$ python3 - << 'PY'
import csv
from datetime import datetime, timedelta
import xlsxwriter

infile = '/workspace/april-attendance-data.csv'
outfile = '/workspace/macro-enabled-attendance.xlsm'
vba = '/workspace/vbaProject.bin.tmp'

rows = []
with open(infile, newline='') as f:
    reader = csv.reader(f)
    for r in reader:
        rows.append(r)

# normalize header
header = rows[0]
# find clock-in/out columns case-insensitive
ci_idx = None
co_idx = None
for i,h in enumerate(header):
    h_norm = h.strip().lower()
    if 'clock' in h_norm and 'in' in h_norm or h_norm in ('clock-in','clockin','clock in'):
        ci_idx = i
    if 'clock' in h_norm and 'out' in h_norm or h_norm in ('clock-out','clockout','clock out'):
        co_idx = i
# default to third and fourth column if not found
if ci_idx is None:
    ci_idx = 2
if co_idx is None:
    co_idx = 3

# process rows
processed = [header]
for r in rows[1:]:
    newr = list(r)
    try:
        ci = datetime.strptime(r[ci_idx].strip(), '%H:%M').time()
        ci_dt = datetime.combine(datetime.today(), ci)
    except Exception:
        processed.append(newr)
        continue
    try:
        co = datetime.strptime(r[co_idx].strip(), '%H:%M').time()
        co_dt = datetime.combine(datetime.today(), co)
    except Exception:
        processed.append(newr)
        continue
    # compare - note threshold 09:20
    threshold = datetime.combine(datetime.today(), datetime.strptime('09:20','%H:%M').time())
    if ci_dt > threshold:
        co_dt = co_dt - timedelta(hours=2)
        # handle negative times by adding 24 hours
        if co_dt.day < datetime.today().day:
            co_dt = co_dt + timedelta(days=1)
        newr[co_idx] = co_dt.strftime('%H:%M')
    processed.append(newr)

# write xlsm with vbaProject
wb = xlsxwriter.Workbook(outfile, {'in_memory': True})
if vba:
    try:
        wb.add_vba_project(vba)
    except Exception:
        pass
ws = wb.add_worksheet('Attendance')
# write rows
for r,row in enumerate(processed):
    for c,val in enumerate(row):
        ws.write(r,c,val)
wb.close()
print('WROTE', outfile)
