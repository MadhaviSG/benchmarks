import json, urllib.request, urllib.error

base = 'http://the-agent-company.com:3000'
login_url = base + '/api/v1/login'
creds = {'user': 'theagentcompany', 'password': 'theagentcompany'}
headers = {'Content-Type': 'application/json'}

msg_text = (
    "Team — there are some unverified concerns circulating about potential organizational changes. "
    "We have no official confirmation at this time. If you have concerns about job security or need 
support, "
    "please contact HR or your manager. We'll share official updates as soon as available. Meanwhile, 
please "
    "continue focusing on priorities and reach out to your manager with questions."
)

try:
    req = urllib.request.Request(login_url, data=json.dumps(creds).encode('utf-8'), headers=headers)
    with urllib.request.urlopen(req, timeout=15) as resp:
        data = json.loads(resp.read().decode())
    token = data['data']['authToken']
    userid = data['data']['userId']
except Exception as e:
    print('ERROR_LOGIN:', str(e))
    raise SystemExit(1)

post_url = base + '/api/v1/chat.postMessage'
# Try a few common channel names
channels = ['#all', 'all', '#general', 'general']

for ch in channels:
    payload = {'channel': ch, 'text': msg_text}
    req2 = urllib.request.Request(post_url, data=json.dumps(payload).encode('utf-8'), headers={
        'Content-Type': 'application/json',
        'X-Auth-Token': token,
        'X-User-Id': userid,
    })
    try:
        with urllib.request.urlopen(req2, timeout=15) as resp2:
            out = json.loads(resp2.read().decode())
        if out.get('success') or out.get('message') == 'Sent':
            print('POST_OK:', ch)
            print(json.dumps(out))
            break
        else:
            print('POST_FAILED:', ch, out)
    except urllib.error.HTTPError as he:
        try:
            err = he.read().decode()
        except Exception:
            err = str(he)
        print('HTTP_ERROR for', ch, err)
    except Exception as e:
        print('ERROR for', ch, str(e))
else:
    print('ALL_ATTEMPTS_FAILED')
