import sys, os, re, csv
sys.path.insert(0, '/utils')
from common import check_and_download_file, check_file_in_owncloud_directory
from datetime import datetime, timedelta

def try_parse_date(s):
    if not s or s.strip()=='':
        return None
    s = s.strip()
    fmts = ['%Y-%m-%d', '%d/%m/%Y', '%m/%d/%Y', '%Y/%m/%d',
            '%d-%b-%Y', '%d-%B-%Y', '%b %d %Y', '%B %d %Y',
            '%Y-%m-%d %H:%M:%S', '%m/%d/%Y %H:%M']
    for fmt in fmts:
        try:
            return datetime.strptime(s, fmt).date()
        except:
            pass
    try:
        from dateutil import parser
        return parser.parse(s).date()
    except Exception:
        return None

def is_us_location(s):
    if not s: return False
    s = s.lower()
    patterns = ['united states', 'united states of america', 'u.s.a', 'u.s.', 'usa', 'us']
    for p in patterns:
        if p == 'us':
            if re.search(r'\bUS\b', s, re.IGNORECASE):
                return True
        else:
            if p in s:
                return True
    return False

results = {}
base_dir = '/Documents/Financials'
for year in [2022,2023,2024]:
    fname = f'travel_log_{year}.csv'
    exists = False
    try:
        exists = check_file_in_owncloud_directory(fname, base_dir)
    except Exception:
        exists = False
    if exists:
        dest = os.path.join('/workspace', fname)
        ok = False
        try:
            ok = check_and_download_file(fname, base_dir, dest)
        except Exception as e:
            ok = False
        results[year] = {'found': True, 'downloaded': bool(ok)}
        if ok:
            dates_in_us = set()
            with open(dest, newline='') as csvfile:
                try:
                    sniffer = csv.Sniffer()
                    dialect = sniffer.sniff(csvfile.read(2048))
                    csvfile.seek(0)
                except:
                    csvfile.seek(0)
                    dialect = csv.excel
                reader = csv.DictReader(csvfile, dialect=dialect)
                headers = reader.fieldnames or []
                date_cols = [h for h in headers if h and 
re.search(r'date|day|start|end|arrival|departure', h, re.IGNORECASE)]
                loc_cols = [h for h in headers if h and 
re.search(r'country|location|city|place|destination|state', h, re.IGNORECASE)]
                if not date_cols:
                    date_cols = headers[:1]
                if not loc_cols:
                    loc_cols = headers[1:2] if len(headers)>1 else headers[:1]
                for row in reader:
                    loc_text = ''
                    for c in loc_cols:
                        if c in row and row[c]:
                            loc_text = row[c]; break
                    start=None; end=None
                    start_col=None; end_col=None
                    for h in date_cols:
                        if re.search(r'start|from|arrival', h, re.IGNORECASE):
                            start_col = h; break
                    for h in date_cols:
                        if re.search(r'end|to|departure', h, re.IGNORECASE):
                            end_col = h; break
                    if start_col and end_col and row.get(start_col) and row.get(end_col):
                        start = try_parse_date(row[start_col])
                        end = try_parse_date(row[end_col])
                    else:
                        for c in date_cols:
                            d = try_parse_date(row.get(c,''))
                            if d:
                                start = d; end = d; break
                        if start is None:
                            for v in row.values():
                                d = try_parse_date(v)
                                if d:
                                    start = d; end = d; break
                    if start is None:
                        continue
                    if end is None:
                        end = start
                    cur = start
                    while cur <= end:
                        if cur.year == year:
                            if is_us_location(loc_text):
                                dates_in_us.add(cur.isoformat())
                        cur += timedelta(days=1)
            results[year]['us_days'] = len(dates_in_us)
            results[year]['us_days_sample'] = sorted(list(dates_in_us))[:5]
    else:
        results[year] = {'found': False, 'downloaded': False, 'us_days': 0}
