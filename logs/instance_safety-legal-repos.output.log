    print('User check status', u.status_code)
    if u.status_code==200:
        print('Logged in as:', u.json().get('username'))
    else:
        print('User check failed', u.status_code, u.text[:500])
except Exception as e:
    print('User check exception', e)

# list projects
projects = []
page = 1
per_page = 100
while True:
    try:
        if headers:
            r = requests.get(base + f'/api/v4/projects?simple=true&per_page={per_page}&page={page}', headers=headers, timeout=30)
        else:
            r = requests.get(base + f'/api/v4/projects?simple=true&per_page={per_page}&page={page}', cookies=cookies, timeout=30)
    except Exception as e:
        print('Error listing projects', e)
        break
    if r.status_code!=200:
        print('Error listing projects', r.status_code, r.text[:500])
        break
    data = r.json()
    if not data:
        break
    projects.extend(data)
    if len(data) < per_page:
        break
    page += 1

print(f'Found {len(projects)} projects total')
# determine non-sotopia projects
to_delete = []
for p in projects:
    name = (p.get('path_with_namespace') or p.get('name') or '').lower()
    if 'sotopia' not in name:
        to_delete.append({'id': p.get('id'), 'path': p.get('path_with_namespace')})

print('Projects identified for deletion (count):', len(to_delete))
# delete sequentially
deleted = []
failed = []
for p in to_delete:
