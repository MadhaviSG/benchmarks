    print('GET_SIGNIN_ERROR', e); sys.exit(2)
if r.status_code != 200:
    print('SIGNIN_PAGE_STATUS', r.status_code); sys.exit(2)
# try to find authenticity_token
m = re.search(r'name="authenticity_token"\s+value="([^"]+)"', r.text)
if not m:
    # try meta csrf-token
    m = re.search(r'name="csrf-token"\s+content="([^"]+)"', r.text)
if not m:
    # try meta tag with content only
    m = re.search(r'content="([a-f0-9\-]{20,})"', r.text)
if not m:
    print('NO_AUTH_TOKEN_FOUND')
    sys.exit(3)
csrf = m.group(1)
print('Got csrf token length', len(csrf))
# post login
data = {
    'user[login]': 'root',
    'user[password]': 'theagentcompany',
    'authenticity_token': csrf,
}
headers = {'Referer': base + '/users/sign_in'}
try:
    r2 = s.post(base + '/users/sign_in', data=data, headers=headers, timeout=20)
except Exception as e:
    print('POST_SIGNIN_ERROR', e); sys.exit(4)
print('Sign-in post status', r2.status_code)
# check if signed in by accessing /api/v4/user
r3 = s.get(base + '/api/v4/user', timeout=20)
print('API user check status', r3.status_code)
try:
    print('API user response snippet:', str(r3.json())[:200])
except Exception as e:
    print('User json parse error', e)

# Try listing projects using session
projects = []
page = 1
per_page = 100
while True:
    r = s.get(base + '/api/v4/projects', params={'per_page':per_page,'page':page}, timeout=30)
    if r.status_code != 200:
        print('Projects list status', r.status_code, str(r.text)[:400]); break
    data = r.json()
    if not data:
        break
    projects.extend(data)
    if len(data) < per_page:
        break
    page += 1
print('Found projects count via session:', len(projects))
# identify non-sotopia
candidates = [p for p in projects if 'sotopia' not in (p.get('path_with_namespace') or p.get('name') or '').lower()]
print('Candidates to delete:', len(candidates))
# delete candidates
deleted=[]
failed=[]
for p in candidates:
    pid = p.get('id')
    path = p.get('path_with_namespace')
    print('Deleting', pid, path)
    rdel = s.delete(base + f'/api/v4/projects/{pid}', timeout=30)
    print('Delete status', rdel.status_code)
    if rdel.status_code in (200,202,204):
        deleted.append({'id':pid,'path':path})
    else:
        failed.append({'id':pid,'path':path,'status':rdel.status_code,'text':str(rdel.text)[:200]})
    time.sleep(0.3)

print('\nSUMMARY: found',len(projects),'deleted',len(deleted),'failed',len(failed))
for d in deleted:
    print(' -', d)
for f in failed[:20]:
    print(' -', f)
