    path = p['path']
    try:
        if headers:
            resp = requests.delete(base + f'/api/v4/projects/{pid}', headers=headers, timeout=30)
        else:
            resp = requests.delete(base + f'/api/v4/projects/{pid}', cookies=cookies, timeout=30)
    except Exception as e:
        print('Delete exception for', pid, path, e)
        failed.append({'id':pid,'path':path,'error':str(e)})
        continue
    if resp.status_code in (200,202,204):
        print('Deleted', pid, path)
        deleted.append({'id':pid,'path':path})
    else:
        print('Failed to delete', pid, path, 'status', resp.status_code, resp.text[:500])
        failed.append({'id':pid,'path':path,'status':resp.status_code,'text':resp.text[:200]})
    time.sleep(0.3)

print('\nSUMMARY:')
print('Total projects found:', len(projects))
print('Deleted:', len(deleted))
if deleted:
    for d in deleted:
