import gitlab, sys, time
url = 'http://the-agent-company.com:8929'
email = 'root'
password = 'theagentcompany'
try:
    gl = gitlab.Gitlab(url, email=email, password=password, timeout=30, ssl_verify=False)
    gl.auth()
except Exception as e:
    print('AUTH_ERROR', e)
    sys.exit(2)
# list projects
projects = []
page = 1
per_page = 100
while True:
    try:
        page_projects = gl.projects.list(page=page, per_page=per_page)
    except Exception as e:
        print('LIST_ERROR', e)
        break
    if not page_projects:
        break
    projects.extend(page_projects)
    if len(page_projects) < per_page:
        break
    page += 1
print('Found', len(projects), 'projects')
# identify to delete
candidates = []
for p in projects:
    name = (getattr(p, 'path_with_namespace', None) or getattr(p, 'name', '')).lower()
    if 'sotopia' not in name:
        candidates.append(p)

print('To delete count', len(candidates))

deleted=[]
failed=[]
for p in candidates:
    try:
        pid = p.id
        path = p.path_with_namespace
        proj = gl.projects.get(pid)
        proj.delete()
        print('Deleted', pid, path)
        deleted.append({'id':pid,'path':path})
    except Exception as e:
        print('Failed deleting', getattr(p,'id',None), getattr(p,'path_with_namespace',None), e)
        failed.append({'id':getattr(p,'id',None),'path':getattr(p,'path_with_namespace',None),'error':str(e)})
    time.sleep(0.2)

print('\nSUMMARY: total',len(projects),'deleted',len(deleted),'failed',len(failed))
if deleted:
    for d in deleted:
        print(' -', d)
if failed:
    for f in failed:
        print(' -', f)
