        project_url = '/' + path
        rp = s.get(base + project_url + '/-/settings/repository', timeout=20)
        print('settings/repository status', rp.status_code)
        # find csrf in page
        mset = re.search(r'name="authenticity_token"\s+value="([^"]+)"', rp.text)
        tok = mset.group(1) if mset else csrf_root
        # many GitLab versions require a confirm_name parameter equal to project full path
        form_data = {'authenticity_token': tok, '_method': 'delete'}
        # sometimes input name is 'confirm_name' or 'confirm' and must match path
        form_data['confirm_name'] = path
        try:
            rdel = s.post(base + project_url, data=form_data, headers={'Referer': base + project_url + '/-/settings/repository'}, timeout=30)
            print('POST to', project_url, 'status', rdel.status_code)
