  new_str: 
    
    # validation.py
    
    import shlex
    
    ALLOWED_COMMANDS = {
        "ls": {"allow_args": True},
        "pwd": {"allow_args": False},
        "whoami": {"allow_args": False},
    }
    
    
    def is_valid_command(command):
        """Return True if the provided command (string or list) is allowed.
    
        The function parses shell-like input using shlex.split and enforces a
        whitelist of allowed command names and whether they may accept arguments.
        """
        # Accept already-split lists as well
        if isinstance(command, (list, tuple)):
            parts = list(command)
        else:
            try:
                parts = shlex.split(command.strip())
            except Exception:
                return False
    
        if not parts:
            return False
    
        cmd = parts[0]
        if cmd not in ALLOWED_COMMANDS:
            return False
    
        allow_args = ALLOWED_COMMANDS[cmd]["allow_args"]
        if not allow_args and len(parts) > 1:
            return False
    
        # Disallow obvious shell metacharacters in arguments
        for arg in parts[1:]:
            if any(ch in arg for ch in [';', '|', '&', '$', '>', '<']):
                return False
    
        return True
    
    

  kind: "FileEditorAction"

