        run_command(request)
        log_activity(user, "Request completed")
    
    

  new_str: 
    
    # review_target.py
    
    import logging
    import shlex
    import subprocess
    from config import LOG_FILE
    from validation import is_valid_command
    
    # Configure module logger to write to configured log file
    logger = logging.getLogger(__name__)
    logger.setLevel(logging.INFO)
    if not logger.handlers:
        handler = logging.FileHandler(LOG_FILE)
        formatter = logging.Formatter('%(asctime)s - %(message)s')
        handler.setFormatter(formatter)
        logger.addHandler(handler)
    
    
    def _sanitize_for_log(value):
        return str(value).replace('\n', ' ').replace('\r', ' ')
    
    
    def log_activity(user, action):
        user_s = _sanitize_for_log(user)
        action_s = _sanitize_for_log(action)
        logger.info(f"{user_s}: {action_s}")
    
    
    def run_command(user_input):
        """Execute a validated command without using a shell.
    
        Raises ValueError if the command is not allowed.
        Returns the command stdout as text on success.
        """
        if not is_valid_command(user_input):
            raise ValueError("Invalid or disallowed command")
    
        args = shlex.split(user_input.strip())
    
        # Run command without shell to avoid shell injection
        completed = subprocess.run(
            args,
            check=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
        )
    
        return completed.stdout
    
    
    def process_user_request(user, request):
        log_activity(user, f"Request received: {request}")
        try:
            output = run_command(request)
            # Log a sanitized summary of the output
            log_activity(user, f"Request completed. Output: {output[:1000]}")
            return output
        except Exception as exc:
            log_activity(user, f"Request failed: {exc}")
            raise
    
    

