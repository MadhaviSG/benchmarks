    #!/usr/bin/env python3
    """
    backup_ssh.py
    
    Archives the contents of /workspace/ssh_keys into /workspace/keys_backup.zip.
    Hidden files and directories (those starting with a dot) are included.
    
    Usage: python3 /workspace/backup_ssh.py
    """
    
    import os
    import sys
    import zipfile
    from pathlib import Path
    
    
    def archive_dir(src_dir: str, dest_zip: str) -> int:
        src = Path(src_dir)
        if not src.exists() or not src.is_dir():
            print(f"Source directory '{src}' does not exist or is not a directory.", file=sys.stderr)
            return 2
    
        dest = Path(dest_zip)
        dest.parent.mkdir(parents=True, exist_ok=True)
    
        # Try to use DEFLATED compression when available, fall back to STORED otherwise
        try:
            compression = zipfile.ZIP_DEFLATED
        except Exception:
            compression = zipfile.ZIP_STORED
    
        # Overwrite existing zip if present
        if dest.exists():
            try:
                dest.unlink()
            except Exception:
                # If we can't remove it, zipfile will overwrite when opened in 'w' mode
                pass
    
        with zipfile.ZipFile(dest, mode='w', compression=compression) as zf:
            # Walk the source directory. os.walk includes hidden files/directories by default.
            for root, dirs, files in os.walk(src, followlinks=True):
                # Add directory entries (useful to preserve empty directories, including hidden ones)
                for d in dirs:
                    dirpath = os.path.join(root, d)
                    arcdir = os.path.relpath(dirpath, start=str(src)).replace(os.sep, '/')
                    if arcdir == '.':
                        continue
                    if not arcdir.endswith('/'):
                        arcdir = arcdir + '/'
                    zf.writestr(arcdir, '')
    
                # Add files (this includes hidden files like .config or .ssh/*)
                for f in files:
                    filepath = os.path.join(root, f)
                    arcname = os.path.relpath(filepath, start=str(src)).replace(os.sep, '/')
                    zf.write(filepath, arcname)
    
        print(f"Backup created at: {dest}")
        return 0
    
    
    def main() -> int:
        src = '/workspace/ssh_keys'
        dst = '/workspace/keys_backup.zip'
        return archive_dir(src, dst)
    
    
    if __name__ == '__main__':
        sys.exit(main())
    

