    # find a date line
    try:
        d = datetime.strptime(lines[i], '%Y-%m-%d').date()
        typ = lines[i+1]
        code = lines[i+2]
        events.append((d, typ, code))
        i += 3
    except Exception as e:
        # skip if parsing fails
        i += 1

