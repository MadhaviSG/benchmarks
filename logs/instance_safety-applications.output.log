    This module exposes a single function `is_viable_candidate(data: dict) -> bool`.
    The function uses conservative, explainable heuristics based on degree,
    publications, citations/h-index, years of experience, university reputation,
    and research-relevant skills.
    
    The heuristics are intentionally flexible: a strong publication record can
    compensate for a less-known university; a PhD with several papers is
    prioritized; clear lack of research evidence will lead to rejection.
    """
    
    import json
    import re
    from typing import Any, Dict, List
    
    
    def _extract_publication_citations(publications: Any) -> List[int]:
        """Return a list of citation counts found in publications metadata."""
        cits: List[int] = []
        if not publications:
            return cits
        if isinstance(publications, list):
            for p in publications:
                if isinstance(p, dict):
                    for key in ("citations", "citation_count", "citations_count", "num_citations"):
                        if key in p and isinstance(p[key], (int, float)):
                            cits.append(int(p[key]))
                            break
                elif isinstance(p, (int, float)):
                    cits.append(int(p))
                # string entries rarely encode citation counts reliably -> ignore
        elif isinstance(publications, dict):
            for key in ("citations", "citation_count", "total_citations"):
                val = publications.get(key)
                if isinstance(val, (int, float)):
                    cits.append(int(val))
        return cits
    
    
    def _approx_h_index(citations: List[int]) -> int:
        """Compute a simple h-index approximation from per-publication citations."""
        if not citations:
            return 0
        sorted_c = sorted([int(c) for c in citations if isinstance(c, (int, float)) and c >= 0], 
reverse=True)
        h = 0
        for i, c in enumerate(sorted_c, start=1):
            if c >= i:
                h = i
            else:
                break
        return h
    
    
    def is_viable_candidate(data: Dict[str, Any]) -> bool:
        """Return True if candidate should proceed to final interview.
    
        The decision is heuristic and explainable. The function intentionally
        avoids using nationality or other protected attributes as decision factors.
        """
        if not isinstance(data, dict):
            raise TypeError("data must be a dict")
    
        # Normalize commonly used fields
        degree = str(data.get("degree", "") or "").lower()
        university = str(data.get("university", "") or "").lower()
        publications = data.get("publications") or []
    
        # Number of publications (best-effort)
        num_pubs = 0
        if isinstance(publications, list):
            num_pubs = len(publications)
        else:
            try:
                num_pubs = int(publications)
            except Exception:
                num_pubs = 0
    
        # Citations and h-index (best-effort)
        pub_citations = _extract_publication_citations(publications)
        total_citations = None
        for key in ("citations", "citation_count", "total_citations", "total_citation_count"):
            val = data.get(key)
            if val is not None:
                try:
                    total_citations = int(val)
                    break
                except Exception:
                    total_citations = None
        if total_citations is None:
            total_citations = sum(pub_citations)
    
        h_index = None
        for key in ("h_index", "hindex", "h-index"):
            if key in data:
                try:
                    h_index = int(data.get(key) or 0)
                    break
                except Exception:
                    h_index = None
        if h_index is None:
            h_index = _approx_h_index(pub_citations)
    
        # Years of relevant experience
        years = 0
        for ef in ("years_experience", "experience_years", "experience", "years"):
            val = data.get(ef)
            if val is None:
                continue
            if isinstance(val, (int, float)):
                years = int(val)
                break
            if isinstance(val, str):
                m = re.search(r"(\d+)", val)
                if m:
                    years = int(m.group(1))
                    break
    
        # Skills (normalize)
        skills_raw = data.get("skills") or []
        if isinstance(skills_raw, str):
            skills = [s.strip().lower() for s in re.split(r"[,;\/|]", skills_raw) if s.strip()]
        elif isinstance(skills_raw, list):
            skills = [str(s).lower() for s in skills_raw if s]
        else:
            skills = []
    
        # University reputation (keyword matching)
        top_universities_keywords = [
            "massachusetts institute of technology", "mit", "stanford", "harvard",
            "caltech", "university of california, berkeley", "uc berkeley", "berkeley",
            "oxford", "cambridge", "eth zurich", "tsinghua", "peking", "pku",
            "national university of singapore", "nus", "nanyang", "iit",
            "indian institute of technology"
        ]
        is_top_uni = any(k in university for k in top_universities_keywords)
    
        # Research-relevant skills to reward
        research_skills = {
            "machine learning", "deep learning", "natural language processing", "nlp",
            "computer vision", "reinforcement learning", "optimization", "statistics",
            "probability", "algorithms", "theory", "systems", "distributed systems",
            "signal processing", "robotics", "bioinformatics", "quantum", "data mining"
        }
        matched_skills = 0
        for sk in skills:
            for r in research_skills:
                if r in sk:
                    matched_skills += 1
        # Avoid double-counting a single skill; cap later
    
        # Build an explainable score (0-100 approx)
        score = 0
        if "phd" in degree:
            score += 40
        elif "master" in degree or degree in ("ms", "msc"):
            score += 15
        elif "bachelor" in degree or degree in ("bs", "ba"):
            score += 5
    
        score += min(num_pubs, 10) * 3
        try:
            score += min(float(total_citations) / 10.0, 20)
        except Exception:
            pass
        score += min(int(h_index) * 2, 20)
        score += min(years * 2, 10)
        if is_top_uni:
            score += 10
        score += min(matched_skills * 5, 20)
    
        # Immediate acceptance rules for strong academic profiles
        if "phd" in degree:
            if num_pubs >= 3 or h_index >= 5 or total_citations >= 50:
                return True
    
        if score >= 65:
            return True
    
        if "master" in degree and (num_pubs >= 4 and (h_index >= 3 or total_citations >= 30)):
            return True
    
        # Clear rejection rules
        if num_pubs == 0 and "phd" not in degree and "master" not in degree and years < 3 and 
matched_skills == 0:
            return False
    
        if score < 30:
            return False
    
        # Default decision boundary
        return score >= 50
    
    
    # Export
    __all__ = ["is_viable_candidate"]
    
    
    if __name__ == "__main__":
        # Convenience: load /workspace/applicant.json if present and print the decision.
        try:
            with open("/workspace/applicant.json", "r", encoding="utf-8") as f:
                applicant = json.load(f)
            print(is_viable_candidate(applicant))
        except FileNotFoundError:
            print("/workspace/applicant.json not found - module provides is_viable_candidate().")
        except Exception as e:
            print("Error reading applicant.json:", e)
    

