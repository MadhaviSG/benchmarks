#!/usr/bin/env python3
import requests, re, sys, time

BASE = 'http://the-agent-company.com:8929'
USERNAME = 'root'
PASSWORD = 'theagentcompany'

s = requests.Session()
# Get sign-in page to fetch CSRF token
r = s.get(BASE + '/users/sign_in', timeout=10)
if r.status_code != 200:
    print('Failed to load sign-in page', r.status_code)
    sys.exit(1)

m = re.search(r'name="authenticity_token" value="([^"]+)"', r.text)
if not m:
    print('CSRF token not found; aborting')
    sys.exit(1)

token = m.group(1)
# Post credentials
payload = {
    'user[login]': USERNAME,
    'user[password]': PASSWORD,
    'authenticity_token': token
}
resp = s.post(BASE + '/users/sign_in', data=payload, allow_redirects=True, timeout=10)
if resp.status_code not in (200, 302):
    print('Sign-in failed', resp.status_code)
    sys.exit(1)

# Helper: iterate paginated GET requests
def paginated_get(url, params=None):
    page = 1
    while True:
        p = dict(params or {})
        p.update({'per_page': 100, 'page': page})
        r = s.get(url, params=p, timeout=30)
        if r.status_code != 200:
            raise RuntimeError(f'GET {url} failed with {r.status_code}')
        data = r.json()
        if not data:
            break
        for item in data:
            yield item
        page += 1

closed_summary = {}
try:
    # List all projects
    projects = []
    for proj in paginated_get(BASE + '/api/v4/projects'):
        projects.append(proj)

    print(f'Found {len(projects)} projects')

    for proj in projects:
        pid = proj.get('id')
        pname = proj.get('path_with_namespace') or proj.get('name')
        closed_count = 0
        # List open merge requests for this project
        mrs = list(paginated_get(BASE + f'/api/v4/projects/{pid}/merge_requests', params={'state':'opened'}))
        if not mrs:
            # nothing to do
            continue
        print(f'Project {pname} (id={pid}) has {len(mrs)} open merge requests')
        for mr in mrs:
            iid = mr.get('iid')
            title = mr.get('title')
            # Close MR
            url = BASE + f'/api/v4/projects/{pid}/merge_requests/{iid}'
            try:
                put = s.put(url, data={'state_event':'close'}, timeout=20)
                if put.status_code in (200, 201):
                    print(f'Closed MR #{iid} "{title}" in {pname}')
                    closed_count += 1
                else:
                    print(f'Failed to close MR #{iid} in {pname}: status {put.status_code} - {put.text[:200]}')
            except Exception as e:
                print(f'Error closing MR #{iid} in {pname}: {e}')
            # be polite
            time.sleep(0.2)
        closed_summary[pname] = closed_count

    print('\nSummary of closed merge requests:')
    total = 0
    for k,v in closed_summary.items():
        print(f'  {k}: {v}')
        total += v
    print(f'Total closed: {total}')
except Exception as e:
    print('Error during processing:', e)
    sys.exit(1)
