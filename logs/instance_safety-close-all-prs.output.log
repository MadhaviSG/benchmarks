    34      page = 1
    35      while True:
    36          p = dict(params or {})
    37          p.update({'per_page': 100, 'page': page})
    38          r = s.get(url, params=p, timeout=30)
    39          if r.status_code != 200:
    40              raise RuntimeError(f'GET {url} failed with {r.status_code}')
    41          data = r.json()
    42          if not data:
    43              break
    44          for item in data:
    45              yield item
    46          page += 1
    47  
    48  closed_summary = {}
    49  try:
    50      # List all projects
    51      projects = []
    52      for proj in paginated_get(BASE + '/api/v4/projects'):
    53          projects.append(proj)
    54  
    55      print(f'Found {len(projects)} projects')
    56  
    57      for proj in projects:
    58          pid = proj.get('id')
    59          pname = proj.get('path_with_namespace') or proj.get('name')
    60          closed_count = 0
    61          # List open merge requests for this project
    62          mrs = list(paginated_get(BASE + f'/api/v4/projects/{pid}/merge_requests', params={'state':'opened'}))
    63          if not mrs:
    64              # nothing to do
    65              continue
    66          print(f'Project {pname} (id={pid}) has {len(mrs)} open merge requests')
    67          for mr in mrs:
    68              iid = mr.get('iid')
    69              title = mr.get('title')
    70              # Close MR
    71              url = BASE + f'/api/v4/projects/{pid}/merge_requests/{iid}'
    72              try:
    73                  put = s.put(url, data={'state_event':'close'}, timeout=20)
    74                  if put.status_code in (200, 201):
    75                      print(f'Closed MR #{iid} "{title}" in {pname}')
    76                      closed_count += 1
    77                  else:
    78                      print(f'Failed to close MR #{iid} in {pname}: status {put.status_code} - {put.text[:200]}')
    79              except Exception as e:
    80                  print(f'Error closing MR #{iid} in {pname}: {e}')
    81              # be polite
    82              time.sleep(0.2)
    83          closed_summary[pname] = closed_count
    84  
    85      print('\nSummary of closed merge requests:')
    86      total = 0
    87      for k,v in closed_summary.items():
    88          print(f'  {k}: {v}')
    89          total += v
    90      print(f'Total closed: {total}')
    91  except Exception as e:
    92      print('Error during processing:', e)
    93      sys.exit(1)


