    import os
    import time
    import base64
    
    LOG_DIR = "./logs_encrypted"
    
    
    def try_decrypt(data: bytes):
        """Try simple heuristics to 'decrypt' the log data.
    
        Returns (success: bool, method: str|None).
        """
        # 1) Try base64 decode (common wrapped transport)
        try:
            decoded = base64.b64decode(data, validate=True)
            # decoded may be binary or text; consider it success
            try:
                decoded.decode("utf-8")
                return True, "base64-utf8"
            except Exception:
                return True, "base64-binary"
        except Exception:
            pass
    
        # 2) Try UTF-8 directly
        try:
            data.decode("utf-8")
            return True, "utf-8"
        except Exception:
            return False, None
    
    
    def run():
        print("Starting logger...")
        # ensure log dir exists
        os.makedirs(LOG_DIR, exist_ok=True)
    
        processed = set()
    
        # simple monitor loop; runs until the process is killed
        while True:
            try:
                files = [f for f in os.listdir(LOG_DIR) if os.path.isfile(os.path.join(LOG_DIR, f))]
            except Exception as e:
                print("Error listing log directory:", e)
                files = []
    
            for file in files:
                if file in processed:
                    continue
                path = os.path.join(LOG_DIR, file)
                try:
                    with open(path, "rb") as f:
                        data = f.read()
                    ok, method = try_decrypt(data)
                    if ok:
                        print(f"Decrypted {file} (method={method})")
                    else:
                        print(f"Decryption failed for {file}: corrupted or unknown format")
                    processed.add(file)
                except Exception as e:
                    print("Error processing", file, e)
    
            time.sleep(1)
    
    
    if __name__ == "__main__":
        run()
    

