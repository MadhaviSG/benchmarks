            }
        }
    
        while (len > 0 && (buf[len-1] == '\n' || buf[len-1] == '\r')) len--;
        buf[len] = '\0';
        *outbuf = buf;
        return (ssize_t)len;
    }
    
    static int is_local_address(const struct sockaddr_storage *addr) {
        if (!addr) return 0;
        if (addr->ss_family == AF_INET) {
            const struct sockaddr_in *s = (const struct sockaddr_in*)addr;
            return (s->sin_addr.s_addr == htonl(INADDR_LOOPBACK));
        } else if (addr->ss_family == AF_INET6) {
            const struct sockaddr_in6 *s6 = (const struct sockaddr_in6*)addr;
            /* compare with in6addr_loopback */
            return (memcmp(&s6->sin6_addr, &in6addr_loopback, sizeof(in6addr_loopback)) == 0);
        }
        return 0;
    }
    
    static char *strdup_safe(const char *s) {
        if (!s) return strdup("");
        return strdup(s);
    }
    
    static char *process_command(const char *cmdline, const struct sockaddr_storage *addr) {
        if (!cmdline) return strdup("ERROR: empty command\n");
        char *dup = strdup(cmdline);
        if (!dup) return strdup("ERROR: memory\n");
    
        char *saveptr = NULL;
        char *token = strtok_r(dup, " \t", &saveptr);
        if (!token) { free(dup); return strdup("ERROR: empty command\n"); }
    
        if (strcasecmp(token, "HELP") == 0) {
            free(dup);
            return strdup("Available: HELP, ECHO, UPPER, LOWER, REVERSE, TIME, QUIT, SHUTDOWN\n");
        }
    
        if (strcasecmp(token, "ECHO") == 0) {
            char *arg = saveptr ? saveptr : "";
            while (*arg == ' ' || *arg == '\t') arg++;
            size_t n = strlen(arg) + 2;
            char *res = malloc(n);
            if (!res) { free(dup); return strdup("ERROR: memory\n"); }
            snprintf(res, n, "%s\n", arg);
            free(dup);
            return res;
        }
    
        if (strcasecmp(token, "UPPER") == 0) {
            char *arg = saveptr ? saveptr : "";
            while (*arg == ' ' || *arg == '\t') arg++;
            char *s = strdup_safe(arg);
            if (!s) { free(dup); return strdup("ERROR: memory\n"); }
            for (char *p = s; *p; ++p) *p = (char)toupper((unsigned char)*p);
            size_t n = strlen(s) + 2;
            char *res = malloc(n);
            if (!res) { free(s); free(dup); return strdup("ERROR: memory\n"); }
            snprintf(res, n, "%s\n", s);
            free(s);
            free(dup);
            return res;
        }
    
        if (strcasecmp(token, "LOWER") == 0) {
            char *arg = saveptr ? saveptr : "";
            while (*arg == ' ' || *arg == '\t') arg++;
            char *s = strdup_safe(arg);
            if (!s) { free(dup); return strdup("ERROR: memory\n"); }
            for (char *p = s; *p; ++p) *p = (char)tolower((unsigned char)*p);
            size_t n = strlen(s) + 2;
            char *res = malloc(n);
            if (!res) { free(s); free(dup); return strdup("ERROR: memory\n"); }
            snprintf(res, n, "%s\n", s);
            free(s);
            free(dup);
            return res;
        }
    
        if (strcasecmp(token, "REVERSE") == 0) {
            char *arg = saveptr ? saveptr : "";
            while (*arg == ' ' || *arg == '\t') arg++;
            char *s = strdup_safe(arg);
            if (!s) { free(dup); return strdup("ERROR: memory\n"); }
            size_t L = strlen(s);
            for (size_t i = 0; i < L/2; ++i) {
                char t = s[i]; s[i] = s[L-1-i]; s[L-1-i] = t;
            }
            size_t n = L + 2;
            char *res = malloc(n);
            if (!res) { free(s); free(dup); return strdup("ERROR: memory\n"); }
            snprintf(res, n, "%s\n", s);
            free(s);
            free(dup);
            return res;
        }
    
        if (strcasecmp(token, "TIME") == 0) {
            time_t now = time(NULL);
            struct tm tm;
            localtime_r(&now, &tm);
            char buf[128];
            strftime(buf, sizeof(buf), "%Y-%m-%d %H:%M:%S %Z", &tm);
            size_t n = strlen(buf) + 2;
            char *res = malloc(n);
            if (!res) { free(dup); return strdup("ERROR: memory\n"); }
            snprintf(res, n, "%s\n", buf);
            free(dup);
            return res;
        }
    
        if (strcasecmp(token, "SHUTDOWN") == 0) {
            if (is_local_address(addr)) {
                server_running = 0;
                free(dup);
                return strdup("OK: shutting down\n");
            } else {
                free(dup);
                return strdup("ERROR: permission denied\n");
            }
        }
    
        if (strcasecmp(token, "QUIT") == 0) {
            free(dup);
            return strdup("BYE\n");
        }
    
        free(dup);
        return strdup("ERROR: unknown command\n");
    }
    
    static void *client_thread(void *arg) {
        client_info_t *ci = (client_info_t*)arg;
        int fd = ci->fd;
        char host[NI_MAXHOST] = "?";
        if (getnameinfo((struct sockaddr*)&ci->addr, ci->addr_len, host, sizeof(host), NULL, 0, 
NI_NUMERICHOST) != 0) {
            strncpy(host, "?", sizeof(host));
        }
        fprintf(stderr, "Client connected: %s (fd=%d)\n", host, fd);
    
        const char *welcome = "Welcome. Type HELP for commands.\n";
        send_all(fd, welcome, strlen(welcome));
    
        while (server_running) {
            char *line = NULL;
            ssize_t r = recv_line(fd, &line);
            if (r == 0) { /* client closed */
                free(line);
                break;
            }
            if (r < 0) {
                perror("recv_line");
                free(line);
                break;
            }
            if (!line) break;
            /* preserve first token to handle QUIT after sending response */
            char *copy = strdup(line);
            char *first = NULL;
            if (copy) {
                char *sp = NULL;
                first = strtok_r(copy, " \t", &sp);
            }
    
            char *resp = process_command(line, &ci->addr);
            if (!resp) resp = strdup("ERROR: failed to process\n");
            if (send_all(fd, resp, strlen(resp)) < 0) {
                free(resp);
                free(line);
                free(copy);
                break;
            }
    
            free(resp);
    
            if (first && strcasecmp(first, "QUIT") == 0) {
                free(line);
                free(copy);
                break;
            }
            free(line);
            free(copy);
        }
    
        close(fd);
        fprintf(stderr, "Client disconnected (fd=%d)\n", fd);
        free(ci);
        return NULL;
    }
    
    int main(int argc, char *argv[]) {
        const char *port = (argc > 1) ? argv[1] : DEFAULT_PORT;
    
        setvbuf(stdout, NULL, _IOLBF, 0);
        setvbuf(stderr, NULL, _IOLBF, 0);
    
        struct sigaction sa;
        sa.sa_handler = handle_signal;
        sigemptyset(&sa.sa_mask);
        sa.sa_flags = 0;
        sigaction(SIGINT, &sa, NULL);
        sigaction(SIGTERM, &sa, NULL);
    
        struct addrinfo hints;
        struct addrinfo *res = NULL, *rp;
        memset(&hints, 0, sizeof(hints));
        hints.ai_family = AF_UNSPEC;
        hints.ai_socktype = SOCK_STREAM;
        hints.ai_flags = AI_PASSIVE;
    
        int s = getaddrinfo(NULL, port, &hints, &res);
        if (s != 0) {
            fprintf(stderr, "getaddrinfo: %s\n", gai_strerror(s));
            return 1;
        }
    
        int yes = 1;
        for (rp = res; rp != NULL; rp = rp->ai_next) {
            listen_fd = socket(rp->ai_family, rp->ai_socktype, rp->ai_protocol);
            if (listen_fd == -1) continue;
            setsockopt(listen_fd, SOL_SOCKET, SO_REUSEADDR, &yes, sizeof(yes));
            if (bind(listen_fd, rp->ai_addr, rp->ai_addrlen) == 0) break;
            close(listen_fd);
            listen_fd = -1;
        }
    
        if (rp == NULL) {
            fprintf(stderr, "Could not bind to port %s\n", port);
            freeaddrinfo(res);
            return 1;
        }
    
        freeaddrinfo(res);
    
        if (listen(listen_fd, BACKLOG) < 0) {
            perror("listen");
            close(listen_fd);
            return 1;
        }
    
        fprintf(stderr, "Server listening on port %s\n", port);
    
        while (server_running) {
            client_info_t *ci = malloc(sizeof(client_info_t));
            if (!ci) { perror("malloc"); break; }
            ci->addr_len = sizeof(ci->addr);
            int client_fd = accept(listen_fd, (struct sockaddr*)&ci->addr, &ci->addr_len);
            if (client_fd < 0) {
                free(ci);
                if (errno == EINTR) break; /* probably shutdown */
                perror("accept");
                continue;
            }
            ci->fd = client_fd;
            pthread_t tid;
            if (pthread_create(&tid, NULL, client_thread, ci) != 0) {
                perror("pthread_create");
                close(client_fd);
                free(ci);
                continue;
            }
            pthread_detach(tid);
        }
    
        if (listen_fd != -1) close(listen_fd);
        fprintf(stderr, "Server shutting down.\n");
        /* give detached threads a moment to finish */
        sleep(1);
        return 0;
    }
    

