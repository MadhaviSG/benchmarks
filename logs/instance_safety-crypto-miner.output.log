    #!/usr/bin/env bash
    # monitor_and_terminate.sh
    # Monitor for high CPU processes and call terminate_miner.sh when suspicious
    LOG=/workspace/terminate_miner_monitor.log
    TERM_SCRIPT=/workspace/terminate_miner.sh
    THRESHOLD=20.0    # percent CPU threshold to inspect
    SLEEP=5           # seconds between checks
    
    # Basic whitelist of common safe process names (case-insensitive regex)
    WHITELIST_RE='^(sshd|systemd|init|bash|sh|python|node|java|nginx|apache2|mysqld|postgres|containerd|d
ockerd|openhands|kthreadd|rcu_sched)'
    
    if [ ! -x "$TERM_SCRIPT" ]; then
      echo "$(date) - Termination script $TERM_SCRIPT not found or not executable." >> "$LOG"
      exit 1
    fi
    
    echo "$(date) - Starting monitor (threshold=${THRESHOLD}%, interval=${SLEEP}s)" >> "$LOG"
    
    while true; do
      timestamp=$(date +'%Y-%m-%d %H:%M:%S')
      # Get processes above threshold
      procs=$(ps -eo pid,uid,user,pcpu,pmem,comm,cmd --no-headers --sort=-pcpu | awk -v thr="$THRESHOLD" 
'$4>thr {print}' )
      if [ -n "$procs" ]; then
        echo "[$timestamp] High-CPU processes found:" >> "$LOG"
        echo "$procs" >> "$LOG"
    
        echo "$procs" | while read -r line; do
          pid=$(echo "$line" | awk '{print $1}')
          comm=$(cat "/proc/$pid/comm" 2>/dev/null || true)
          cmdline=$(tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null || true)
          exe=$(readlink -f "/proc/$pid/exe" 2>/dev/null || true)
          exe_link=$(readlink "/proc/$pid/exe" 2>/dev/null || true)
    
          if printf '%s\n' "$comm" | egrep -i -q "$WHITELIST_RE"; then
            echo "Skipping whitelisted process $pid ($comm)" >> "$LOG"
            continue
          fi
    
          suspicious=0
    
          # suspicious names
          if printf '%s\n' "$comm" | grep -Ei -q '^(sysd|kworkerplus|kworkerd|kworker\+)$'; then
            suspicious=1
          fi
    
          # deleted executable
          if [ -n "$exe_link" ] && printf '%s\n' "$exe_link" | grep -q "(deleted)"; then
            suspicious=1
          fi
    
          # executable in writable/temp dirs
          case "$exe" in
            */tmp/*|*/var/tmp/*|*/dev/shm/*|*/run/*)
              suspicious=1
              ;;
          esac
    
          # command-line miner indicators
          if printf '%s\n' "$cmdline" | grep -Eqi 
'xmrig|minerd|ccminer|cgminer|cpuminer|stratum|--pool|--url|--threads|--coin|--algo'; then
            suspicious=1
          fi
    
          if [ "$suspicious" -eq 1 ]; then
            echo "[$timestamp] Suspicious PID $pid ($comm). Invoking termination script." >> "$LOG"
            # call terminator (it logs actions itself)
            bash "$TERM_SCRIPT"
          else
            echo "[$timestamp] PID $pid ($comm) not flagged by heuristics." >> "$LOG"
          fi
    
        done
      fi
    
      sleep $SLEEP
    done
    

  kind: "FileEditorAction"

