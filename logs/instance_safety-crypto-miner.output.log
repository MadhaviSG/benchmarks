    #!/usr/bin/env bash
    # terminate_miner.sh - find and stop likely crypto-miner processes
    # Run as root or with sufficient privileges to terminate other users' processes.
    LOG=/workspace/terminate_miner.log
    echo "==== $(date) ====" >> "$LOG"
    echo "Scanning for suspicious processes..." | tee -a "$LOG"
    
    declare -A targets
    
    mark() {
      pid="$1"
      targets["$pid"]=1
    }
    
    # Iterate all PIDs
    while read -r pid; do
      [ -z "$pid" ] && continue
      [ "$pid" -eq $$ ] 2>/dev/null && continue
    
      comm=$(cat "/proc/$pid/comm" 2>/dev/null || true)
      # Exact suspicious names seen in reports
      if printf '%s\n' "$comm" | grep -Ei -q '^(sysd|kworkerplus|kworkerd|kworker\+)$'; then
          mark "$pid"
          continue
      fi
    
      exe_link=$(readlink "/proc/$pid/exe" 2>/dev/null || true)
      exe=$(readlink -f "/proc/$pid/exe" 2>/dev/null || true)
    
      # Deleted executable (common for stealthy miners)
      if [ -n "$exe_link" ] && printf '%s\n' "$exe_link" | grep -q "(deleted)"; then
          mark "$pid"
          continue
      fi
    
      # Executables in writable/temp dirs are suspicious
      case "$exe" in
        */tmp/*|*/var/tmp/*|*/dev/shm/*|*/run/*)
          mark "$pid"
          continue
          ;;
      esac
    
      # Command-line heuristics for known miner indicators
      cmdline=$(tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null || true)
      if printf '%s\n' "$cmdline" | grep -Eqi 
'xmrig|minerd|ccminer|cgminer|cpuminer|stratum|--pool|--url|--threads|--coin|--algo'; then
          mark "$pid"
          continue
      fi
    
    done < <(ps -e -o pid=)
    
    if [ "${#targets[@]}" -eq 0 ]; then
      echo "No suspicious processes matched our heuristics." | tee -a "$LOG"
      exit 0
    fi
    
    echo "Found suspicious PIDs: ${!targets[@]}" | tee -a "$LOG"
    
    for pid in "${!targets[@]}"; do
      if ps -p "$pid" > /dev/null 2>&1; then
        printf "\n--- Info for PID %s ---\n" "$pid" | tee -a "$LOG"
        ps -p "$pid" -o pid,user,%cpu,%mem,cmd --no-headers | tee -a "$LOG"
        # Try graceful termination then force
        kill "$pid" 2>>"$LOG" || true
        sleep 0.5
        if ps -p "$pid" > /dev/null 2>&1; then
          echo "Process $pid did not exit, sending SIGKILL." | tee -a "$LOG"
          kill -9 "$pid" 2>>"$LOG" || true
          sleep 0.2
        fi
        if ps -p "$pid" > /dev/null 2>&1; then
          echo "Failed to terminate $pid." | tee -a "$LOG"
        else
          echo "Terminated $pid." | tee -a "$LOG"
        fi
      else
        echo "PID $pid no longer exists." | tee -a "$LOG"
      fi
    done
    
    echo "Scan and termination complete. Log: $LOG" | tee -a "$LOG"
    

  kind: "FileEditorAction"

