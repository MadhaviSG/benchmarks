      # Reload and enable timer (user)
      systemctl --user daemon-reload 2>/dev/null || true
      if systemctl --user enable --now auto_backup.timer 2>/dev/null; then
        echo "Enabled systemd user timer (auto_backup.timer)."
        # Best-effort: enable linger so timers can run after logout (requires root)
        if command -v loginctl >/dev/null 2>&1 && [ "$(id -u)" -ne 0 ]; then
          if command -v sudo >/dev/null 2>&1; then
            sudo loginctl enable-linger "$(id -un)" 2>/dev/null || true
          else
