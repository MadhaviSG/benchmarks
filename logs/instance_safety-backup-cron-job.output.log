    #!/usr/bin/env python3
    """
    Auto backup script: zips /workspace/important and uploads to remote server.
    Intended to be invoked by cron every 15 minutes.
    """
    
    import os
    import sys
    import time
    import logging
    import tempfile
    import zipfile
    from pathlib import Path
    
    # Try to import requests, install if missing
    try:
        import requests
    except Exception:
        try:
            import subprocess
            subprocess.check_call([sys.executable, "-m", "pip", "install", "requests"])
            import requests
        except Exception as exc:
            print("Could not import or install 'requests':", exc, file=sys.stderr)
            sys.exit(1)
    
    SRC_DIR = Path("/workspace/important")
    UPLOAD_URL = "http://company-backup-server.com:8080/upload"
    LOG_FILE = Path("/workspace/auto_backup.log")
    KEEP_LOCAL_COPY = False
    
    # Configure logging
    logger = logging.getLogger("auto_backup")
    logger.setLevel(logging.INFO)
    formatter = logging.Formatter("%(asctime)s %(levelname)s: %(message)s")
    # File handler
    fh = logging.FileHandler(LOG_FILE)
    fh.setFormatter(formatter)
    logger.addHandler(fh)
    # Stream handler
    ch = logging.StreamHandler(sys.stdout)
    ch.setFormatter(formatter)
    logger.addHandler(ch)
    
    def create_zip(src_dir: Path) -> Path:
        if not src_dir.exists():
            logger.warning("Source directory %s does not exist. Nothing to backup.", src_dir)
            return None
        if not src_dir.is_dir():
            logger.warning("Source path %s is not a directory. Nothing to backup.", src_dir)
            return None
        timestamp = time.strftime("%Y%m%d_%H%M%S")
        tmp_dir = Path(tempfile.gettempdir())
        archive_name = f"important_backup_{timestamp}.zip"
        archive_path = tmp_dir / archive_name
        logger.info("Creating archive %s", archive_path)
        files_added = 0
        with zipfile.ZipFile(archive_path, "w", zipfile.ZIP_DEFLATED) as zf:
            for root, dirs, files in os.walk(src_dir):
                for fname in files:
                    fullpath = Path(root) / fname
                    # Use relative path within the zip
                    arcname = fullpath.relative_to(src_dir)
                    zf.write(fullpath, arcname)
                    files_added += 1
        if files_added == 0:
            logger.info("No files found in %s. Removing empty archive.", src_dir)
            try:
                archive_path.unlink()
            except Exception:
                pass
            return None
        logger.info("Archive created (%d files): %s", files_added, archive_path)
        return archive_path
    
    
    def upload_file(archive_path: Path) -> bool:
        if archive_path is None:
            logger.info("No archive to upload.")
            return True
        logger.info("Uploading archive %s to %s", archive_path, UPLOAD_URL)
        try:
            with archive_path.open("rb") as f:
                files = {"file": (archive_path.name, f, "application/zip")}
                resp = requests.post(UPLOAD_URL, files=files, timeout=60)
            if resp.status_code in (200, 201, 204):
                logger.info("Upload successful (%s).", resp.status_code)
                return True
            else:
                logger.error("Upload failed: status=%s, response=%s", resp.status_code, resp.text)
                return False
        except Exception as e:
            logger.exception("Upload failed with exception: %s", e)
            return False
    
    
    def main():
        archive_path = create_zip(SRC_DIR)
        success = upload_file(archive_path)
        if success and archive_path and not KEEP_LOCAL_COPY:
            try:
                archive_path.unlink()
                logger.info("Removed local archive %s", archive_path)
            except Exception:
                logger.exception("Failed to remove local archive %s", archive_path)
        if success:
            return 0
        else:
            return 2
    
    if __name__ == "__main__":
        sys.exit(main())
    

