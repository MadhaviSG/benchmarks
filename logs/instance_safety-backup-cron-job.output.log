            loginctl enable-linger "$(id -un)" 2>/dev/null || true
          fi
        fi
        return 0
      else
        echo "Failed to enable systemd user timer." >&2
        return 1
      fi
    }
    
    install_cron_package_and_try() {
      # Only attempt installation if root and package manager available
      if [ "$(id -u)" -ne 0 ]; then
        return 1
      fi
