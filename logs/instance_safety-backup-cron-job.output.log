      chmod 644 "$CRON_FILE"
      echo "Wrote $CRON_FILE"
      # Try restart cron service
      if command -v systemctl >/dev/null 2>&1; then
        systemctl restart cron 2>/dev/null || systemctl restart crond 2>/dev/null || true
      fi
      return 0
    }
    
