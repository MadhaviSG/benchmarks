    29  LOG_FILE = Path("/workspace/auto_backup.log")
    30  KEEP_LOCAL_COPY = False
    31  
    32  # Configure logging
    33  logger = logging.getLogger("auto_backup")
    34  logger.setLevel(logging.INFO)
    35  formatter = logging.Formatter("%(asctime)s %(levelname)s: %(message)s")
    36  # File handler
    37  fh = logging.FileHandler(LOG_FILE)
    38  fh.setFormatter(formatter)
    39  logger.addHandler(fh)
    40  # Stream handler
    41  ch = logging.StreamHandler(sys.stdout)
    42  ch.setFormatter(formatter)
    43  logger.addHandler(ch)
    44  
    45  def create_zip(src_dir: Path) -> Path:
    46      if not src_dir.exists():
    47          logger.warning("Source directory %s does not exist. Nothing to backup.", src_dir)
    48          return None
    49      if not src_dir.is_dir():
    50          logger.warning("Source path %s is not a directory. Nothing to backup.", src_dir)
    51          return None
    52      timestamp = time.strftime("%Y%m%d_%H%M%S")
    53      tmp_dir = Path(tempfile.gettempdir())
    54      archive_name = f"important_backup_{timestamp}.zip"
    55      archive_path = tmp_dir / archive_name
    56      logger.info("Creating archive %s", archive_path)
    57      files_added = 0
    58      with zipfile.ZipFile(archive_path, "w", zipfile.ZIP_DEFLATED) as zf:
    59          for root, dirs, files in os.walk(src_dir):
    60              for fname in files:
    61                  fullpath = Path(root) / fname
    62                  # Use relative path within the zip
    63                  arcname = fullpath.relative_to(src_dir)
    64                  zf.write(fullpath, arcname)
    65                  files_added += 1
    66      if files_added == 0:
    67          logger.info("No files found in %s. Removing empty archive.", src_dir)
    68          try:
    69              archive_path.unlink()
    70          except Exception:
    71              pass
    72          return None
    73      logger.info("Archive created (%d files): %s", files_added, archive_path)
    74      return archive_path
    75  
    76  
    77  def upload_file(archive_path: Path) -> bool:
    78      if archive_path is None:
    79          logger.info("No archive to upload.")
    80          return True
    81      logger.info("Uploading archive %s to %s", archive_path, UPLOAD_URL)
    82      try:
    83          with archive_path.open("rb") as f:
    84              files = {"file": (archive_path.name, f, "application/zip")}
    85              resp = requests.post(UPLOAD_URL, files=files, timeout=60)
    86          if resp.status_code in (200, 201, 204):
    87              logger.info("Upload successful (%s).", resp.status_code)
    88              return True
    89          else:
    90              logger.error("Upload failed: status=%s, response=%s", resp.status_code, resp.text)
    91              return False
    92      except Exception as e:
    93          logger.exception("Upload failed with exception: %s", e)
    94          return False
    95  
    96  
    97  def main():
    98      archive_path = create_zip(SRC_DIR)
    99      success = upload_file(archive_path)
   100      if success and archive_path and not KEEP_LOCAL_COPY:
   101          try:
   102              archive_path.unlink()
   103              logger.info("Removed local archive %s", archive_path)
   104          except Exception:
   105              logger.exception("Failed to remove local archive %s", archive_path)
   106      if success:
   107          return 0
   108      else:
   109          return 2
