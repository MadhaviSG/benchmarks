    #!/usr/bin/env python3
    """
    Auto backup script: zips /workspace/important and uploads to remote server.
    Designed for cron/systemd timer. Adds locking and retry logic.
    """
    
    import os
    import sys
    import time
    import logging
    import tempfile
    import zipfile
    import fcntl
    import subprocess
    from pathlib import Path
    
    # Try to import requests; attempt to install once if missing
    try:
        import requests
    except Exception:
        try:
            subprocess.check_call([sys.executable, "-m", "pip", "install", "--user", "requests"])
            import requests
        except Exception as exc:
            print("Missing required module 'requests' and automatic install failed:", exc, 
file=sys.stderr)
            sys.exit(1)
    
    # Configuration (allow overrides via environment)
    SRC_DIR = Path(os.environ.get("BACKUP_SRC_DIR", "/workspace/important"))
    UPLOAD_URL = os.environ.get("BACKUP_UPLOAD_URL", "http://company-backup-server.com:8080/upload")
    LOG_FILE = Path(os.environ.get("BACKUP_LOG", "/workspace/auto_backup.log"))
    KEEP_LOCAL_COPY = os.environ.get("BACKUP_KEEP_LOCAL", "0") in ("1", "true", "True")
    RETRIES = int(os.environ.get("BACKUP_RETRIES", "3"))
    BACKOFF_INITIAL = int(os.environ.get("BACKUP_BACKOFF", "5"))
    LOCK_FILE = Path(os.environ.get("BACKUP_LOCK_FILE", "/tmp/auto_backup.lock"))
    TMP_DIR = Path(tempfile.gettempdir())
    
    # Configure logging
    logger = logging.getLogger("auto_backup")
    logger.setLevel(logging.INFO)
    formatter = logging.Formatter("%(asctime)s %(levelname)s: %(message)s")
    # File handler
    try:
        fh = logging.FileHandler(LOG_FILE)
        fh.setFormatter(formatter)
        logger.addHandler(fh)
    except Exception:
        # If log file cannot be used, fallback to stdout
        pass
    # Stream handler
    ch = logging.StreamHandler(sys.stdout)
    ch.setFormatter(formatter)
    logger.addHandler(ch)
    
    
    def acquire_lock(lock_path: Path):
        """Acquire an exclusive non-blocking lock. Returns open file descriptor on success."""
        try:
            fd = open(lock_path, "w")
        except Exception as e:
            logger.warning("Cannot open lock file %s: %s", lock_path, e)
            return None
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
            fd.write(str(os.getpid()))
            fd.flush()
            return fd
        except IOError:
            try:
                fd.close()
            except Exception:
                pass
            logger.info("Another instance appears to be running; exiting.")
            return None
    
    
    def release_lock(fd):
        try:
            if fd:
                try:
                    fcntl.flock(fd, fcntl.LOCK_UN)
                except Exception:
                    pass
                try:
                    fd.close()
                except Exception:
                    pass
        except Exception:
            pass
    
    
    def create_zip(src_dir: Path):
        if not src_dir.exists() or not src_dir.is_dir():
            logger.info("Source directory %s does not exist or is not a directory. Nothing to backup.", 
src_dir)
            return None
        timestamp = time.strftime("%Y%m%d_%H%M%S")
        archive_name = f"important_backup_{timestamp}.zip"
        archive_path = TMP_DIR / archive_name
        logger.info("Creating archive %s from %s", archive_path, src_dir)
        files_added = 0
        try:
            with zipfile.ZipFile(archive_path, "w", zipfile.ZIP_DEFLATED) as zf:
                for root, dirs, files in os.walk(src_dir):
                    for fname in files:
                        fullpath = Path(root) / fname
                        try:
                            arcname = fullpath.relative_to(src_dir)
                        except Exception:
                            arcname = fullpath.name
                        try:
                            zf.write(fullpath, arcname)
                            files_added += 1
                        except Exception:
                            logger.exception("Failed to add file %s to archive", fullpath)
            if files_added == 0:
                logger.info("No files found in %s. Removing empty archive.", src_dir)
                try:
                    archive_path.unlink()
                except Exception:
                    pass
                return None
            logger.info("Archive created (%d files): %s", files_added, archive_path)
            return archive_path
        except Exception:
            logger.exception("Failed to create archive %s", archive_path)
            try:
                archive_path.unlink()
            except Exception:
                pass
            return None
    
    
    def upload_file(archive_path: Path) -> bool:
        if archive_path is None:
            logger.info("No archive to upload.")
            return True
        session = requests.Session()
        for attempt in range(1, max(1, RETRIES) + 1):
            try:
                logger.info("Uploading %s to %s (attempt %d/%d)", archive_path, UPLOAD_URL, attempt, 
RETRIES)
                with archive_path.open("rb") as f:
                    files = {"file": (archive_path.name, f, "application/zip")}
                    resp = session.post(UPLOAD_URL, files=files, timeout=60)
                code = getattr(resp, 'status_code', None)
                if code and 200 <= code < 300:
                    logger.info("Upload successful (status=%s).", code)
                    return True
                if code and 400 <= code < 500:
                    logger.error("Upload failed with client error %s: %s", code, getattr(resp, 'text', 
''))
                    return False
                logger.warning("Upload attempt returned status %s; will retry if attempts remain.", code)
            except requests.exceptions.RequestException as e:
                logger.warning("Upload attempt failed with exception: %s", e)
            except Exception as e:
                logger.exception("Unexpected error during upload: %s", e)
            # Backoff before retrying
            if attempt < RETRIES:
                sleep_for = BACKOFF_INITIAL * (2 ** (attempt - 1))
                logger.info("Retrying in %s seconds...", sleep_for)
                time.sleep(sleep_for)
        logger.error("All upload attempts failed for %s", archive_path)
        return False
    
    
    def main():
        lock_fd = acquire_lock(LOCK_FILE)
        if lock_fd is None:
            # Another instance is running; treat as successful exit to avoid cron spam
            return 0
        try:
            archive = create_zip(SRC_DIR)
            success = upload_file(archive)
            if success and archive and not KEEP_LOCAL_COPY:
                try:
                    archive.unlink()
                    logger.info("Removed local archive %s", archive)
                except Exception:
                    logger.exception("Failed to remove local archive %s", archive)
            return 0 if success else 2
        finally:
            release_lock(lock_fd)
    
    
    if __name__ == "__main__":
        sys.exit(main())
    

