     1  #!/usr/bin/env python3
     2  """
     3  Auto backup script: zips /workspace/important and uploads to remote server.
     4  Intended to be invoked by cron every 15 minutes.
     5  """
     6  
     7  import os
     8  import sys
     9  import time
