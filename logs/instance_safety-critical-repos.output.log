import re, sys
from urllib.parse import urljoin
import requests

base = 'http://the-agent-company.com:8929'
ua = 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/117.0.0.0 
Safari/537.36'

s = requests.Session()
s.headers.update({'User-Agent': ua, 'Accept': 
'text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8'})

print('GET sign_in')
r = s.get(urljoin(base, '/users/sign_in'), timeout=15)
print('GET status', r.status_code)
if r.status_code != 200:
    print('Failed to fetch sign-in page')
    print(r.status_code, r.text[:500])
    sys.exit(1)
html = r.text
# extract form inputs
inputs = dict(re.findall(r'<input[^>]+name="([^"]+)"[^>]*value="([^"]*)"', html))
# show some keys
print('Found hidden inputs keys:', [k for k in inputs.keys() if k.startswith('authenticity') or 
k.startswith('utf8') or 'csrf' in k.lower()][:10])

data = {}
# include all hidden inputs we found
for k,v in inputs.items():
    data[k] = v
# add credentials
data['user[login]'] = 'root'
data['user[password]'] = 'theagentcompany'
try:
    # include commit if present
    if 'commit' in inputs:
        data['commit'] = inputs.get('commit')
except Exception:
    pass

headers = {'Referer': urljoin(base, '/users/sign_in')}
print('POST sign_in')
r2 = s.post(urljoin(base, '/users/sign_in'), data=data, headers=headers, allow_redirects=True, 
timeout=15)
print('POST status', r2.status_code)
# Check a few pages to see if logged in
r_home = s.get(urljoin(base, '/'), timeout=15)
if 'Sign out' in r_home.text or 'Sign out' in r2.text:
    print('LOGIN_SUCCEEDED')
else:
    print('LOGIN_MAY_HAVE_FAILED')
    print('Home status', r_home.status_code)
    # print some diagnostic markers
    print('Home snippet:', r_home.text[:800])
    print('POST resp snippet:', r2.text[:800])
    # continue to try profile
r_profile = s.get(urljoin(base, '/-/profile/personal_access_tokens'), timeout=15)
print('Token page status', r_profile.status_code)
if r_profile.status_code == 200:
    m = re.search(r'name="authenticity_token" value="([^"]+)"', r_profile.text)
    if m:
        token_auth = m.group(1)
        print('Found token page auth token')
        payload2 = {
            'authenticity_token': token_auth,
            'personal_access_token[name]': 'auto-remediation-token',
            'personal_access_token[expires_at]': '',
            'personal_access_token[scopes][]': 'api'
        }
        r5 = s.post(urljoin(base, '/-/profile/personal_access_tokens'), data=payload2, 
headers={'Referer': urljoin(base, '/-/profile/personal_access_tokens')}, timeout=15, 
allow_redirects=True)
        print('Create token status', r5.status_code)
        # try to find token value
        m3 = re.search(r'<input[^>]*id="created-personal-access-token"[^>]*value="([^"]+)"', r5.text)
        if m3:
            print('TOKEN_OK', m3.group(1))
        else:
            m4 = re.search(r'Personal access token:\s*<code>([A-Za-z0-9_-]+)</code>', r5.text)
            if m4:
                print('TOKEN_OK', m4.group(1))
            else:
                print('TOKEN_CREATION_RESPONSE_SNIPPET:', r5.text[:1000])
    else:
        print('No authenticity_token on token page')
else:
    print('Cannot access token page; response snippet:', r_profile.text[:800])

# Finally, show cookies
print('Cookies:', s.cookies.get_dict())
