b8GmkslRrhPtiLcw=="},"action":{"command":"python3 - << 'PY'\nimport sys, re, requests\nfrom urllib.parse 
import urljoin\nbase = 'http://the-agent-company.com:8929'\ns = requests.Session()\n# Get sign-in page to
fetch authenticity token\nr = s.get(urljoin(base, '/users/sign_in'), timeout=10)\nif r.status_code != 
200:\n    print('SIGNIN PAGE ERROR', r.status_code, r.text[:500])\n    sys.exit(1)\nm = 
re.search(r'name=\"authenticity_token\" value=\"([^\"]+)\"', r.text)\nif not m:\n    print('NO AUTH TOKEN
ON SIGNIN PAGE')\n    sys.exit(1)\nauth = m.group(1)\n# Post credentials\npayload = {\n    'user[login]':
'root',\n    'user[password]': 'theagentcompany',\n    'authenticity_token': auth,\n    
'user[remember_me]': '0'\n}\nheaders = {'Referer': urljoin(base, '/users/sign_in')}\nr2 = 
s.post(urljoin(base, '/users/sign_in'), data=payload, headers=headers, timeout=10, 
allow_redirects=True)\nif r2.status_code not in (200,302):\n    print('LOGIN FAILED', r2.status_code, 
r2.text[:500])\n    sys.exit(1)\n# Check if logged in by accessing profile page\nr3 = s.get(urljoin(base,
'/profile'), timeout=10)\nif r3.status_code != 200 or 'Sign out' not in r3.text:\n    print('LOGIN MAY 
HAVE FAILED, STATUS', r3.status_code)\n    sys.exit(1)\nprint('LOGIN_OK')\n# Access personal access token
creation page\nr4 = s.get(urljoin(base, '/-/profile/personal_access_tokens'), timeout=10)\nif 
r4.status_code != 200:\n    print('TOKEN PAGE ERROR', r4.status_code)\n    sys.exit(1)\n# extract 
authenticity_token on token creation page\nm2 = re.search(r'name=\"authenticity_token\" 
value=\"([^\"]+)\"', r4.text)\nif not m2:\n    print('NO AUTH TOKEN ON TOKEN PAGE')\n    
sys.exit(1)\ntoken_auth = m2.group(1)\n# create new token with api scope\npayload2 = {\n    
'authenticity_token': token_auth,\n    'personal_access_token[name]': 'auto-remediation-token',\n    
'personal_access_token[expires_at]': '',\n    'personal_access_token[scopes][]': 'api'\n}\n# POST to 
create token\nr5 = s.post(urljoin(base, '/-/profile/personal_access_tokens'), data=payload2, 
headers={'Referer': urljoin(base, '/-/profile/personal_access_tokens')}, timeout=10)\nif r5.status_code 
not in (200,302):\n    print('CREATE TOKEN FAILED', r5.status_code)\n    print(r5.text[:1000])\n    
sys.exit(1)\n# The token value is shown on the page after creation, find it\nm3 = 
re.search(r'<input[^>]*id=\"created-personal-access-token\"[^>]*value=\"([^\"]+)\"', r5.text)\nif m3:\n  
token = m3.group(1)\n    print('TOKEN_OK', token)\nelse:\n    # Try to find token in other format\n    m4
= re.search(r'Personal access token:\\s*<code>([A-Za-z0-9_-]+)</code>', r5.text)\n    if m4:\n        
token = m4.group(1)\n        print('TOKEN_OK', token)\n    else:\n        
print('TOKEN_NOT_FOUND')\nPY\n","is_input":false,"timeout":120.0,"reset":false,"kind":"TerminalAction"},"
