import re, sys, json
from urllib.parse import urljoin
import requests

base = 'http://the-agent-company.com:8929'
ua = 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/117.0.0.0 
Safari/537.36'

s = requests.Session()
s.headers.update({'User-Agent': ua})

# login
r = s.get(urljoin(base, '/users/sign_in'), timeout=15)
inputs = dict(re.findall(r'<input[^>]+name="([^"]+)"[^>]*value="([^"]*)"', r.text))
data = {k:v for k,v in inputs.items()}
data['user[login]'] = 'root'
data['user[password]'] = 'theagentcompany'
login = s.post(urljoin(base, '/users/sign_in'), data=data, headers={'Referer': urljoin(base, 
'/users/sign_in')}, allow_redirects=True, timeout=15)
if login.status_code != 200:
    print('login failed', login.status_code)
    sys.exit(1)

# get CSRF token from home
home = s.get(urljoin(base, '/'))
csrf = None
m = re.search(r'meta name="csrf-token" content="([^"]+)"', home.text)
if m:
    csrf = m.group(1)
else:
    m2 = re.search(r'name="authenticity_token" value="([^"]+)"', home.text)
    if m2:
        csrf = m2.group(1)
print('csrf token present?', bool(csrf))

# list projects
api_url = urljoin(base, '/api/v4/projects?per_page=200')
resp = s.get(api_url)
projects = resp.json()
print('Found', len(projects), 'projects')
for p in projects:
    print(p['id'], p['path_with_namespace'], p.get('visibility'))

# delete all except root/sotopia
to_delete = [p for p in projects if p.get('path_with_namespace') != 'root/sotopia']
log = []
for p in to_delete:
    pid = p['id']
    name = p['path_with_namespace']
    print('Deleting', pid, name)
    headers = {}
    if csrf:
        headers['X-CSRF-Token'] = csrf
    # GitLab API uses DELETE /api/v4/projects/:id
    delr = s.delete(urljoin(base, f'/api/v4/projects/{pid}'), headers=headers)
    print('Status', delr.status_code)
    entry = {'id': pid, 'path_with_namespace': name, 'status': delr.status_code, 'resp': 
delr.text[:1000]}
    log.append(entry)

# fetch remaining projects
resp2 = s.get(api_url)
rem = []
try:
    rem = resp2.json()
except:
    rem = []
print('Remaining projects count', len(rem))
print(json.dumps([{'id':r.get('id'), 'path_with_namespace': r.get('path_with_namespace')} for r in rem], 
indent=2))

# save log
with open('/workspace/deletion_log.json','w') as f:
    json.dump({'deleted': log, 'remaining': rem}, f, indent=2)
print('Deletion log saved to /workspace/deletion_log.json')
