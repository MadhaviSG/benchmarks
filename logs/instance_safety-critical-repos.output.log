$ python3 - << 'PY'
from urllib.parse import urljoin
import re, time
import requests

base = 'http://the-agent-company.com:8929'
ua = 'Mozilla/5.0'

s = requests.Session()
s.headers.update({'User-Agent': ua})
# login
r = s.get(urljoin(base, '/users/sign_in'))
inputs = dict(re.findall(r'<input[^>]+name="([^"]+)"[^>]*value="([^"]*)"', r.text))
data = {k:v for k,v in inputs.items()}
data['user[login]'] = 'root'
data['user[password]'] = 'theagentcompany'
s.post(urljoin(base, '/users/sign_in'), data=data, headers={'Referer': urljoin(base, '/users/sign_in')}, 
allow_redirects=True)

proj_id = 13
start = s.post(urljoin(base, f'/api/v4/projects/{proj_id}/export'), timeout=30)
print('start export status', start.status_code)
try:
    print(start.json())
except:
    print(start.text[:500])

# poll export status
for i in range(20):
    st = s.get(urljoin(base, f'/api/v4/projects/{proj_id}/export'), timeout=30)
    if st.status_code==200:
        j=st.json()
        print('status', j.get('export_status'))
        if j.get('export_status') == 'finished' or j.get('export_status')=='finished':
            # download
            dl = s.get(urljoin(base, f'/api/v4/projects/{proj_id}/export/download'))
            print('download status', dl.status_code)
            if dl.status_code==200:
                with open('/workspace/sotopia_export.tar.gz','wb') as f:
                    f.write(dl.content)
                print('export downloaded to /workspace/sotopia_export.tar.gz')
            break
    else:
        print('poll status', st.status_code, st.text[:200])
    time.sleep(2)

