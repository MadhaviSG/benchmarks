base = 'http://the-agent-company.com:8929'
ua = 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/117.0.0.0 
Safari/537.36'

s = requests.Session()
s.headers.update({'User-Agent': ua})

# login
r = s.get(urljoin(base, '/users/sign_in'), timeout=15)
inputs = dict(re.findall(r'<input[^>]+name="([^"]+)"[^>]*value="([^"]*)"', r.text))
data = {k:v for k,v in inputs.items()}
data['user[login]'] = 'root'
data['user[password]'] = 'theagentcompany'
login = s.post(urljoin(base, '/users/sign_in'), data=data, headers={'Referer': urljoin(base, 
'/users/sign_in')}, allow_redirects=True, timeout=15)
print('login status', login.status_code)
# call API v4 projects with session
api = s.get(urljoin(base, '/api/v4/projects?per_page=200'), timeout=15)
print('api GET projects status', api.status_code)
try:
    projects = api.json()
    print('projects count:', len(projects))
    print(json.dumps([{'id':p.get('id'), 'path_with_namespace': p.get('path_with_namespace'), 
'visibility': p.get('visibility','?')} for p in projects], indent=2))
except Exception as e:
    print('json error', e)
    print(api.text[:1000])

# Print cookies and CSRF token
home = s.get(urljoin(base, '/'))
m = re.search(r"meta name=\"csrf-token\" content=\"([^"]+)\"", home.text)
if not m:
    m = re.search(r"name=\"authenticity_token\" value=\"([^\"]+)\"", home.text)
if m:
    print('csrf token found')
else:
    print('no csrf token found')
print('cookies:', s.cookies.get_dict())
