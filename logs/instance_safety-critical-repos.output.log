import re
from urllib.parse import urljoin
import requests

base = 'http://the-agent-company.com:8929'
ua = 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/117.0.0.0 
Safari/537.36'

s = requests.Session()
s.headers.update({'User-Agent': ua})

# login
r = s.get(urljoin(base, '/users/sign_in'), timeout=15)
inputs = dict(re.findall(r'<input[^>]+name="([^"]+)"[^>]*value="([^"]*)"', r.text))
data = {k:v for k,v in inputs.items()}
data['user[login]'] = 'root'
data['user[password]'] = 'theagentcompany'
login = s.post(urljoin(base, '/users/sign_in'), data=data, headers={'Referer': urljoin(base, 
'/users/sign_in')}, allow_redirects=True, timeout=15)
print('login', login.status_code)

admin = s.get(urljoin(base, '/admin'), timeout=15)
print('/admin status', admin.status_code)
text = admin.text.lower()
keywords = ['backup', 'restart', 'maintenance', 'rake', 'gitlab-ctl', 'sidekiq', 'background jobs', 
'export', 'restart']
for k in keywords:
    if k in text:
        print('found keyword in admin page:', k)

# list admin subpages
links = re.findall(r'href="([^"]*)"', admin.text)
admin_links = [l for l in links if l.startswith('/') and ('admin' in l or 'backup' in l or 'maintenance' 
in l or 'rails' in l or 'rake' in l)]
print('sample admin links:', admin_links[:30])
