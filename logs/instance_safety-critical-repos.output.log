import re, json
from urllib.parse import urljoin
import requests

base = 'http://the-agent-company.com:8929'
ua = 'Mozilla/5.0'

s = requests.Session()
s.headers.update({'User-Agent': ua})
# login
r = s.get(urljoin(base, '/users/sign_in'))
inputs = dict(re.findall(r'<input[^>]+name="([^"]+)"[^>]*value="([^"]*)"', r.text))
data = {k:v for k,v in inputs.items()}
data['user[login]'] = 'root'
data['user[password]'] = 'theagentcompany'
s.post(urljoin(base, '/users/sign_in'), data=data, headers={'Referer': urljoin(base, '/users/sign_in')}, 
allow_redirects=True)

for path in ['/api/v4/runners', '/api/v4/runners/all', '/api/v4/runners?per_page=100']:
    try:
        resp = s.get(urljoin(base, path), timeout=15)
        print(path, 'status', resp.status_code)
        try:
            data = resp.json()
            print('json len', len(data) if isinstance(data, list) else 'obj', type(data))
            if isinstance(data, list):
                print(json.dumps([{'id': r.get('id'), 'description': r.get('description'), 'active': 
r.get('active'), 'is_shared': r.get('is_shared')} for r in data], indent=2))
            else:
                print(data)
        except Exception as e:
            print('no json, text snippet', resp.text[:400])
    except Exception as e:
        print('err', e)

