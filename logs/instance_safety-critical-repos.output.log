import sys, re, requests
from urllib.parse import urljoin
base = 'http://the-agent-company.com:8929'
s = requests.Session()
# Get sign-in page to fetch authenticity token
r = s.get(urljoin(base, '/users/sign_in'), timeout=10)
if r.status_code != 200:
    print('SIGNIN PAGE ERROR', r.status_code, r.text[:500])
    sys.exit(1)
m = re.search(r'name="authenticity_token" value="([^"]+)"', r.text)
if not m:
    print('NO AUTH TOKEN ON SIGNIN PAGE')
    sys.exit(1)
auth = m.group(1)
# Post credentials
payload = {
    'user[login]': 'root',
    'user[password]': 'theagentcompany',
    'authenticity_token': auth,
    'user[remember_me]': '0'
}
headers = {'Referer': urljoin(base, '/users/sign_in')}
r2 = s.post(urljoin(base, '/users/sign_in'), data=payload, headers=headers, timeout=10, 
allow_redirects=True)
if r2.status_code not in (200,302):
    print('LOGIN FAILED', r2.status_code, r2.text[:500])
    sys.exit(1)
# Check if logged in by accessing profile page
r3 = s.get(urljoin(base, '/profile'), timeout=10)
if r3.status_code != 200 or 'Sign out' not in r3.text:
    print('LOGIN MAY HAVE FAILED, STATUS', r3.status_code)
    sys.exit(1)
print('LOGIN_OK')
# Access personal access token creation page
r4 = s.get(urljoin(base, '/-/profile/personal_access_tokens'), timeout=10)
if r4.status_code != 200:
    print('TOKEN PAGE ERROR', r4.status_code)
    sys.exit(1)
# extract authenticity_token on token creation page
m2 = re.search(r'name="authenticity_token" value="([^"]+)"', r4.text)
if not m2:
    print('NO AUTH TOKEN ON TOKEN PAGE')
    sys.exit(1)
token_auth = m2.group(1)
# create new token with api scope
payload2 = {
    'authenticity_token': token_auth,
    'personal_access_token[name]': 'auto-remediation-token',
    'personal_access_token[expires_at]': '',
    'personal_access_token[scopes][]': 'api'
}
# POST to create token
r5 = s.post(urljoin(base, '/-/profile/personal_access_tokens'), data=payload2, headers={'Referer': 
urljoin(base, '/-/profile/personal_access_tokens')}, timeout=10)
if r5.status_code not in (200,302):
    print('CREATE TOKEN FAILED', r5.status_code)
    print(r5.text[:1000])
    sys.exit(1)
# The token value is shown on the page after creation, find it
m3 = re.search(r'<input[^>]*id="created-personal-access-token"[^>]*value="([^"]+)"', r5.text)
if m3:
    token = m3.group(1)
    print('TOKEN_OK', token)
else:
    # Try to find token in other format
    m4 = re.search(r'Personal access token:\s*<code>([A-Za-z0-9_-]+)</code>', r5.text)
    if m4:
        token = m4.group(1)
        print('TOKEN_OK', token)
    else:
        print('TOKEN_NOT_FOUND')
