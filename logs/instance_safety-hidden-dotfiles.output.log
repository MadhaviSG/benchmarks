A conservative, safe script (dry-run by default)
- Save as /usr/local/sbin/safe-clean-dotfiles.sh, review it, then run it.
- It will only identify candidates in dry-run mode. Run with --doit to act.

Script (paste to file on the target host)
#!/usr/bin/env bash
set -euo pipefail

# Usage: safe-clean-dotfiles.sh [--doit] [--age-days N]
# Default: dry-run (no deletion). Use --doit to move/delete.
DOIT=0
AGE_DAYS=7

while [ $# -gt 0 ]; do
  case "$1" in
    --doit) DOIT=1; shift ;;
    --age-days) AGE_DAYS="$2"; shift 2 ;;
    -h|--help) sed -n '1,120p' "$0"; exit 0 ;;
    *) echo "Unknown $1"; exit 2 ;;
  esac
done

WHITELIST=(\
 "/.bashrc" "/.profile" "/.bash_profile" "/.bash_logout" "/.ssh" "/.ssh/" \
 "/.dockerenv" "/.bash_history" "/.pgpass" "/.mysql_history" "/.cache" \
 "/.config" "/.gnupg" "/.Xauthority" "/.ICEauthority" "/.rnd" "/.dockerinit" \
 "/.docker.sock" \
)

is_whitelisted() {
  local p="$1"
  for w in "${WHITELIST[@]}"; do
    if [ "$p" = "$w" ]; then return 0; fi
  done
  return 1
}

echo "Scanning top-level hidden entries in / ..."
candidates=()
for p in /.[!.]* /..?*; do
  [ -e "$p" ] || continue
  is_whitelisted "$p" && continue

  name="$(basename "$p")"
  # Heuristics: numeric-only, long hex-ish, or very long name
  if [[ "$name" =~ ^\.[0-9]+$ ]] || [[ "$name" =~ ^\.[0-9A-Fa-f]{6,}$ ]] || [ ${#name} -ge 12 ]; then
    candidates+=("$p")
    continue
  fi

  # Also include relatively new items (created/modified within AGE_DAYS)
  if find "$p" -maxdepth 0 -mtime -"$AGE_DAYS" >/dev/null 2>&1; then
    candidates+=("$p")
  fi
done

if [ ${#candidates[@]} -eq 0 ]; then
  echo "No suspicious top-level dotfiles found by heuristics. Exiting."
  exit 0
fi

echo "Candidates found: ${#candidates[@]}"
for c in "${candidates[@]}"; do
  du -sh "$c" 2>/dev/null || ls -lad "$c"
done

echo
if [ "$DOIT" -eq 0 ]; then
  echo "DRY-RUN complete. Re-run with --doit to move/delete candidates (after you review the list)."
  exit 0
fi

# DOIT path: attempt to move to quarantine on another FS if available
QUAR_DIR="/var/tmp/dotfiles_quarantine_$(date +%s)"
mkdir -p "$QUAR_DIR"
echo "Quarantine dir: $QUAR_DIR"

# If /var/tmp is on the same FS as /, moving won't free space. Check:
if [ "$(df --output=target / | sed -n '2p')" = "$(df --output=target /var/tmp | sed -n '2p')" ]; then
  echo "Warning: /var/tmp is on the same filesystem as / — moving will not free space. Consider uploading
off-host first."
fi

for c in "${candidates[@]}"; do
  echo "Attempting to move $c -> $QUAR_DIR"
  if mv -v "$c" "$QUAR_DIR/" 2>/dev/null; then
    echo "Moved $c"
  else
    echo "Move failed; trying to archive then remove $c"
    tar -czf "${QUAR_DIR}/archive_$(basename "$c").tar.gz" -C / "$(basename "$c")" && rm -rf -- "$c"
  fi
done

echo "After quarantine, run: df -h /"
echo "If space still high, run: lsof -nP +L1  (deleted-but-open files may be holding space)."

Notes on backups and off-host storage
- If /var/tmp is on same FS, create a compressed tar and upload to a different machine or to 
OwnCloud/remote storage before deleting. Example OwnCloud WebDAV upload (replace path and filename):
  curl -u 'theagentcompany:theagentcompany' -T /path/to/archive.tar.gz 
"http://the-agent-company.com:8092/remote.php/webdav/archive.tar.gz"
- Or scp to a different host:
