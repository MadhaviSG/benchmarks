    #!/usr/bin/env bash
    # safe-clean-dotfiles.sh
    # Dry-run by default. Use --doit to attempt quarantine/delete.
    
    DOIT=0
    AGE_DAYS=7
    
    while [ $# -gt 0 ]; do
      case "$1" in
        --doit) DOIT=1; shift ;;
        --age-days) AGE_DAYS="$2"; shift 2 ;;
        -h|--help) sed -n '1,200p' "$0"; exit 0 ;;
        *) echo "Unknown arg: $1"; exit 2 ;;
      esac
    done
    
    WHITELIST=(
      "/.bashrc" "/.profile" "/.bash_profile" "/.bash_logout" "/.ssh" "/.dockerenv"
      "/.bash_history" "/.cache" "/.config" "/.gnupg" "/.Xauthority" "/.ICEauthority"
    )
    
    is_whitelisted() {
      local p="$1"
      for w in "${WHITELIST[@]}"; do
        if [ "$p" = "$w" ] || [[ "$p" = "$w"* ]]; then
          return 0
        fi
      done
      return 1
    }
    
    echo "Scanning top-level hidden entries in / (dry-run unless --doit provided) ..."
    
    candidates=()
    for p in /.[!.]* /..?*; do
      [ -e "$p" ] || continue
      is_whitelisted "$p" && continue
      name="$(basename "$p")"
    
      # Heuristics for suspicious names: numeric-only, long hex-like, or very long
      if [[ "$name" =~ ^\.[0-9]+$ ]] || [[ "$name" =~ ^\.[0-9A-Fa-f]{6,}$ ]] || [ ${#name} -ge 12 ]; then
        candidates+=("$p")
        continue
      fi
    
      # Also include items modified within AGE_DAYS
      if [ "$AGE_DAYS" -gt 0 ] && find "$p" -maxdepth 0 -mtime -"$AGE_DAYS" >/dev/null 2>&1; then
        candidates+=("$p")
        continue
      fi
    done
    
    if [ ${#candidates[@]} -eq 0 ]; then
      echo "No suspicious top-level dotfiles found by heuristics."
      exit 0
    fi
    
    echo "Candidates found: ${#candidates[@]}"
    for c in "${candidates[@]}"; do
      du -sh "$c" 2>/dev/null || ls -lad "$c"
    done
    
    if [ "$DOIT" -eq 0 ]; then
      echo "\nDRY-RUN complete. Re-run with --doit to attempt quarantine/archive and removal."
      exit 0
    fi
    
    # DOIT: attempt to move to quarantine (prefer another filesystem)
    QUAR_DIR="/var/tmp/dotfiles_quarantine_$(date +%s)"
    mkdir -p "$QUAR_DIR"
    echo "Quarantine dir: $QUAR_DIR"
    
    ROOT_TGT=$(df --output=target / | sed -n '2p')
    TMP_TGT=$(df --output=target /var/tmp 2>/dev/null | sed -n '2p' || echo "$ROOT_TGT")
    if [ "$ROOT_TGT" = "$TMP_TGT" ]; then
      echo "Warning: /var/tmp appears to be on the same filesystem as /; moving won't free space. 
Consider uploading archives off-host."
    fi
    
    for c in "${candidates[@]}"; do
      echo "Processing $c"
      if mv -v -- "$c" "$QUAR_DIR/" 2>/dev/null; then
        echo "Moved $c to $QUAR_DIR"
      else
        base="$(basename "$c")"
        tar -czf "${QUAR_DIR}/archive_${base}.tar.gz" -C / "$base" && rm -rf -- "$c"
        echo "Archived and removed $c"
      fi
    done
    
    echo "Done. Run: df -h / ; if still high, check for deleted-but-open files: lsof -nP +L1"
    

