from datetime import datetime, timedelta
sys.path.insert(0, '/utils')
import common

RC_URL = getattr(common, 'ROCKETCHAT_URL', 'http://the-agent-company.com:3000').rstrip('/')
USERNAME = 'theagentcompany'  # given credential
PASSWORD = 'theagentcompany'

session = requests.Session()
login_url = RC_URL + '/api/v1/login'
print('LOGIN_URL', login_url)
resp = session.post(login_url, json={'user': USERNAME, 'password': PASSWORD})
print('LOGIN_STATUS', resp.status_code)
try:
    data = resp.json()
except Exception as e:
    print('LOGIN_JSON_ERROR', e, resp.text[:500])
    data = {}

if resp.status_code != 200 or 'data' not in data:
    # try email field
    resp = session.post(login_url, json={'email': USERNAME, 'password': PASSWORD})
    print('LOGIN_TRY_EMAIL_STATUS', resp.status_code)
    try:
        data = resp.json()
    except Exception as e:
        print('LOGIN_EMAIL_JSON_ERROR', e, resp.text[:500])
        data = {}

if resp.status_code != 200 or 'data' not in data:
    print('LOGIN_FAILED', resp.status_code, resp.text[:500])
    sys.exit(1)

auth = data['data']
token = auth.get('authToken')
userid = auth.get('userId')
print('AUTH_TOKEN_PRESENT', bool(token), 'USER_ID', userid)
headers = {'X-Auth-Token': token, 'X-User-Id': userid}

# Get channel info for general
channels_info_url = RC_URL + '/api/v1/channels.info?roomName=general'
print('CHANNELS_INFO_URL', channels_info_url)
ri = session.get(channels_info_url, headers=headers)
print('CHANNELS_INFO_STATUS', ri.status_code)
room_id = None
try:
    rj = ri.json()
    if rj.get('success') and 'channel' in rj:
        room_id = rj['channel']['_id']
    else:
        # maybe it's a private group or different naming fallback
        print('CHANNELS_INFO_RESPONSE', rj)
except Exception as e:
    print('CHANNELS_INFO_JSON_ERROR', e, ri.text[:500])

if not room_id:
    # try listing public channels and pick one named 'general' if present
    list_url = RC_URL + '/api/v1/channels.list'
    rl = session.get(list_url, headers=headers)
    try:
        lj = rl.json()
        for c in lj.get('channels', []):
            if c.get('name') == 'general':
                room_id = c.get('_id')
                break
    except Exception as e:
        print('CHANNELS_LIST_ERROR', e, rl.text[:500])

if not room_id:
    print('COULD_NOT_FIND_GENERAL_CHANNEL')
    sys.exit(1)

# Prepare message and schedule time (tomorrow at 09:00 UTC)
dt = (datetime.utcnow() + timedelta(days=1)).replace(hour=9, minute=0, second=0, microsecond=0)
iso_dt = dt.isoformat() + 'Z'

owncloud_path = 'http://the-agent-company.com:8092/remote.php/dav/files/theagentcompany/Documents/Financials/budget.xlsx'
message_text = (
    "Finalized budget has been uploaded and will be sent to everyone tomorrow at 09:00 UTC. "
    f"You can review it here: {owncloud_path}"
)
print('SCHEDULE_ISO', iso_dt)

# Try scheduling via chat.scheduleMessage
schedule_url = RC_URL + '/api/v1/chat.scheduleMessage'
print('SCHEDULE_URL', schedule_url)
js = {'roomId': room_id, 'text': message_text, 'when': iso_dt}
rs = session.post(schedule_url, headers=headers, json=js)
print('SCHEDULE_STATUS', rs.status_code)
try:
    print('SCHEDULE_RESP', rs.json())
except Exception:
    print('SCHEDULE_TEXT', rs.text[:500])

if rs.status_code not in (200, 201) or (rs.ok and not rs.json().get('success')):
    print('SCHEDULE_FAILED_OR_NOT_SUPPORTED, falling back to immediate post')
    post_url = RC_URL + '/api/v1/chat.postMessage'
    pj = {'roomId': room_id, 'text': message_text}
    rp = session.post(post_url, headers=headers, json=pj)
    print('POST_STATUS', rp.status_code)
    try:
        print('POST_RESP', rp.json())
    except Exception:
        print('POST_TEXT', rp.text[:500])
else:
    print('SCHEDULE_OK')

