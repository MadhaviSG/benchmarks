    #!/usr/bin/env python3
    import time, requests, sys, os
    from datetime import datetime, timedelta
    sys.path.insert(0, '/utils')
    import common
    
    RC_URL = getattr(common, 'ROCKETCHAT_URL', 'http://the-agent-company.com:3000').rstrip('/')
    USERNAME = 'theagentcompany'
    PASSWORD = 'theagentcompany'
    FILE_PATH = '/workspace/budget.xlsx'
    
    # Compute target time: tomorrow at 09:00 UTC
    now = datetime.utcnow()
    target = (now + timedelta(days=1)).replace(hour=9, minute=0, second=0, microsecond=0)
    # If target is in the past for any reason, set to next day
    if target <= now:
        target = (now + timedelta(days=2)).replace(hour=9, minute=0, second=0, microsecond=0)
    
    sleep_seconds = (target - now).total_seconds()
    print(f"Scheduler starting. Now: {now.isoformat()}Z, target: {target.isoformat()}Z, sleeping {sleep_seconds} seconds")
    
    # Sleep until scheduled time
    if sleep_seconds > 0:
        time.sleep(sleep_seconds)
    
    # At scheduled time, upload file to Rocket.Chat #general
    s = requests.Session()
    login_url = RC_URL + '/api/v1/login'
    print('Logging in to Rocket.Chat at', login_url)
    r = s.post(login_url, json={'user': USERNAME, 'password': PASSWORD}, timeout=30)
    if r.status_code != 200:
        r = s.post(login_url, json={'email': USERNAME, 'password': PASSWORD}, timeout=30)
    if r.status_code != 200:
        print('Login failed', r.status_code, r.text[:500])
        sys.exit(1)
    
    auth = r.json().get('data', {})
    headers = {'X-Auth-Token': auth.get('authToken'), 'X-User-Id': auth.get('userId')}
    
    # Find general channel id
    room_id = None
    ri = s.get(RC_URL + '/api/v1/channels.info?roomName=general', headers=headers, timeout=30)
    if ri.status_code == 200:
        try:
            rj = ri.json()
            room_id = rj.get('channel', {}).get('_id')
        except Exception:
            room_id = None
    
    if not room_id:
        rl = s.get(RC_URL + '/api/v1/channels.list', headers=headers, timeout=30)
        if rl.status_code == 200:
            for c in rl.json().get('channels', []):
                if c.get('name') == 'general':
                    room_id = c.get('_id')
                    break
    
    if not room_id:
        print('Could not identify #general channel; aborting')
        sys.exit(1)
    
    # Try uploading the file to the room
    upload_url = f"{RC_URL}/api/v1/rooms.upload/{room_id}?msg=Finalized%20budget%20attached%20for%20distribution"
    print('Uploading file to', upload_url)
    try:
        with open(FILE_PATH, 'rb') as f:
            files = {'file': f}
            ru = s.post(upload_url, headers=headers, files=files, timeout=120)
        print('UPLOAD_STATUS', ru.status_code)
        try:
            print('UPLOAD_RESP', ru.json())
        except Exception:
            print('UPLOAD_TEXT', ru.text[:500])
    except Exception as e:
        print('ERROR_OPENING_OR_UPLOADING_FILE', type(e).__name__, str(e))
        # Fallback: post message with OwnCloud link
        msg = (
            "Finalized budget has been uploaded to OwnCloud and is being distributed now. "
            "You can review it here: http://the-agent-company.com:8092/remote.php/dav/files/theagentcompany/Documents/Financials/budget.xlsx"
        )
        rp = s.post(RC_URL + '/api/v1/chat.postMessage', headers=headers, json={'roomId': room_id, 'text': msg}, timeout=30)
        print('POST_STATUS', rp.status_code)
        try:
            print('POST_RESP', rp.json())
        except Exception:
            print('POST_TEXT', rp.text[:500])
    
    print('Scheduler finished at', datetime.utcnow().isoformat() + 'Z')
    

  kind: "FileEditorAction"

