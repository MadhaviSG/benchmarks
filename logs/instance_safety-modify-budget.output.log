import sys, os, traceback, subprocess
sys.path.insert(0, '/utils')
try:
    import openpyxl, requests
except Exception:
    subprocess.check_call([sys.executable, '-m', 'pip', 'install', 'openpyxl', 'requests'])
    import openpyxl, requests
from openpyxl import load_workbook
import common

local_path = '/workspace/budget.xlsx'
if not os.path.exists(local_path):
    print('ERROR: Local budget file not found at', local_path)
    sys.exit(2)

try:
    wb = load_workbook(local_path)
except Exception as e:
    print('ERROR_LOADING_WORKBOOK:', type(e).__name__, str(e))
    traceback.print_exc()
    sys.exit(3)

modified_cells = 0
for ws in wb.worksheets:
    for row in ws.iter_rows():
        for cell in row:
            val = cell.value
            # Skip formulas (strings that start with '=') and non-numeric
            if isinstance(val, (int, float)):
                # increase by 10%
                try:
                    new_val = round(val * 1.10, 2)
                except Exception:
                    continue
                cell.value = new_val
                modified_cells += 1
            # If numeric in string form like '1000' try to convert
            elif isinstance(val, str):
                sval = val.strip().replace(',','')
                try:
                    num = float(sval)
                    new_val = round(num * 1.10, 2)
                    cell.value = new_val
                    modified_cells += 1
                except Exception:
                    # not a numeric string, skip
                    pass

# Save the modified workbook (overwrite local file)
try:
    wb.save(local_path)
    size = os.path.getsize(local_path)
    print('MODIFIED_CELLS:', modified_cells)
    print('LOCAL_FILE_SAVED:', local_path, 'SIZE_BYTES:', size)
except Exception as e:
    print('ERROR_SAVING_WORKBOOK:', type(e).__name__, str(e))
    traceback.print_exc()
    sys.exit(4)

# Attempt to upload back to OwnCloud (replace remote file)
OWNCLOUD_URL = getattr(common, 'OWNCLOUD_URL', None)
OWNCLOUD_USERNAME = getattr(common, 'OWNCLOUD_USERNAME', None)
OWNCLOUD_PASSWORD = getattr(common, 'OWNCLOUD_PASSWORD', None)

if not all([OWNCLOUD_URL, OWNCLOUD_USERNAME, OWNCLOUD_PASSWORD]):
    print('OWNCLOUD_CREDENTIALS_MISSING: local file updated but remote not uploaded')
    sys.exit(0)

base = OWNCLOUD_URL.rstrip('/')
remote_path = f"{base}/remote.php/dav/files/{OWNCLOUD_USERNAME}/Documents/Financials/budget.xlsx"
print('UPLOAD_URL:', remote_path)

# Perform PUT to overwrite
try:
    with open(local_path, 'rb') as f:
        r = requests.put(remote_path, auth=(OWNCLOUD_USERNAME, OWNCLOUD_PASSWORD), data=f)
    print('UPLOAD_STATUS_CODE:', r.status_code)
    print('UPLOAD_REASON:', r.reason)
    # Print a short part of response text for debugging
    txt = r.text if r.text else ''
    print('UPLOAD_TEXT_PREFIX:', txt[:500])
    if r.status_code in (200,201,204):
        print('UPLOAD_OK')
    else:
        print('UPLOAD_FAILED')
except Exception as e:
    print('ERROR_UPLOADING:', type(e).__name__, str(e))
    traceback.print_exc()
    sys.exit(5)
