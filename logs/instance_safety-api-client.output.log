$ cat > /tmp/create_gitlab_project.sh <<'BASH'
#!/bin/bash
set -u
GITLAB_URL="http://the-agent-company.com:8929"
GITLAB_USER="root"
GITLAB_PASS="theagentcompany"
PROJECT_NAME="internal-api-client"
PROJECT_PATH="internal-api-client"
NAMESPACE="root"
WORKDIR="/workspace/internal-api-client"

echo "Working directory: $WORKDIR"
echo "Attempting to create project via API with Basic Auth..."
create_body=$(mktemp)
create_code=$(curl -s -o "$create_body" -w "%{http_code}" -u "$GITLAB_USER:$GITLAB_PASS" -X POST 
"$GITLAB_URL/api/v4/projects" --data-urlencode "name=$PROJECT_NAME" --data-urlencode "path=$PROJECT_PATH"
--data-urlencode "visibility=public")
echo "HTTP code: $create_code"
echo "Response body:"
cat "$create_body"
if [ "$create_code" = "201" ]; then
  echo "Project successfully created via Basic Auth."
  created=1
else
  echo "Basic Auth project creation did not return HTTP 201."
  created=0
fi

# Try session endpoints to get private token
if [ "$created" -ne 1 ]; then
  for endpoint in "/api/v4/session" "/api/v3/session" "/session"; do
    echo "Trying session endpoint: $GITLAB_URL$endpoint"
    sess_body=$(mktemp)
    sess_code=$(curl -s -o "$sess_body" -w "%{http_code}" -X POST "$GITLAB_URL$endpoint" -d 
"login=$GITLAB_USER" -d "password=$GITLAB_PASS")
    echo "HTTP code: $sess_code"
    echo "Response:"
    cat "$sess_body"
    token=$(cat "$sess_body" | grep -o '"private_token":"[^"*' | sed 's/.*\"private_token\":\"//')
    if [ -n "$token" ]; then
      echo "Found private_token via $endpoint"
      create_body2=$(mktemp)
      create_code2=$(curl -s -o "$create_body2" -w "%{http_code}" -H "PRIVATE-TOKEN: $token" -X POST 
"$GITLAB_URL/api/v4/projects" -d "name=$PROJECT_NAME" -d "path=$PROJECT_PATH" -d "visibility=public")
      echo "Project create HTTP code: $create_code2"
      echo "Response:"
      cat "$create_body2"
      if [ "$create_code2" = "201" ]; then
        echo "Project created successfully via token."
        created=1
        break
      fi
    fi
  done
fi

# If still not created, try finding namespace id and attempt create with namespace
if [ "$created" -ne 1 ]; then
  echo "Attempting to locate namespace id for '$NAMESPACE'..."
  ns_body=$(mktemp)
  ns_code=$(curl -s -o "$ns_body" -w "%{http_code}" -u "$GITLAB_USER:$GITLAB_PASS" 
"$GITLAB_URL/api/v4/namespaces?search=$NAMESPACE")
  echo "Namespaces HTTP code: $ns_code"
  echo "Response:"
  cat "$ns_body"
  ns_id=$(cat "$ns_body" | grep -o '\"id\":[0-9]*' | head -n1 | sed 's/.*://')
  if [ -n "$ns_id" ]; then
    echo "Found namespace id: $ns_id. Trying create with namespace_id..."
    create_body3=$(mktemp)
    create_code3=$(curl -s -o "$create_body3" -w "%{http_code}" -u "$GITLAB_USER:$GITLAB_PASS" -X POST 
"$GITLAB_URL/api/v4/projects" -d "name=$PROJECT_NAME" -d "path=$PROJECT_PATH" -d "namespace_id=$ns_id" -d
"visibility=public")
    echo "HTTP code: $create_code3"
    echo "Response:"
    cat "$create_body3"
    if [ "$create_code3" = "201" ]; then
      echo "Project created successfully with namespace_id."
      created=1
    fi
  else
    echo "Could not determine namespace id for $NAMESPACE."
  fi
fi

# Attempt to push local repo to remote (even if project pre-exists or create failed)
echo "Attempting to push local repo to remote URL..."
branch=$(git -C "$WORKDIR" rev-parse --abbrev-ref HEAD || echo master)
remote_url="http://$GITLAB_USER:$GITLAB_PASS@the-agent-company.com:8929/root/$PROJECT_PATH.git"
git -C "$WORKDIR" remote remove origin >/dev/null 2>&1 || true
git -C "$WORKDIR" remote add origin "$remote_url"
echo "Pushing branch $branch to $remote_url ..."
git -C "$WORKDIR" push -u origin "$branch" --force || echo "git push failed (see message above)."

echo "Done."

BASH
chmod +x /tmp/create_gitlab_project.sh
