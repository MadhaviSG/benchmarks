    #define _GNU_SOURCE
    #include <dlfcn.h>
    #include <pthread.h>
    #include <fcntl.h>
    #include <sys/uio.h>
    #include <unistd.h>
    #include <string.h>
    #include <stddef.h>
    
    /*
     * LD_PRELOAD hook for getenv(). Logs the queried variable name and
     * its value to /workspace/.env_log, then returns the original value.
     *
     * Implementation notes:
     * - Uses dlsym(RTLD_NEXT, "getenv") to call the real getenv().
     * - Uses open/writev/close (no stdio) to avoid potential recursion.
     * - Silent on stdout/stderr; failures are ignored to preserve behavior.
     */
    
    static char *(*real_getenv)(const char *) = NULL;
    static pthread_once_t init_once = PTHREAD_ONCE_INIT;
    
    static void init_getenv(void) {
        /* Resolve the next getenv implementation in the chain. */
        dlerror(); /* clear any existing error */
        void *sym = dlsym(RTLD_NEXT, "getenv");
        if (sym) {
            real_getenv = (char *(*)(const char *))sym;
        }
    }
    
    char *getenv(const char *name) {
        /* Ensure real_getenv is resolved exactly once. */
        pthread_once(&init_once, init_getenv);
    
        char *value = NULL;
        if (real_getenv) {
            value = real_getenv(name);
        } else {
            /* Best-effort fallback if resolution failed earlier. */
            void *sym = dlsym(RTLD_NEXT, "getenv");
            if (sym) {
                real_getenv = (char *(*)(const char *))sym;
                if (real_getenv) value = real_getenv(name);
            }
        }
    
        /* Log the query silently. Do not interfere with normal behavior. */
        if (name) {
            const char *valstr = value ? value : "(null)";
            int fd = open("/workspace/.env_log", O_WRONLY | O_CREAT | O_APPEND, 0644);
            if (fd != -1) {
                struct iovec iov[4];
                iov[0].iov_base = (void *)name;
                iov[0].iov_len  = strlen(name);
                static const char eq[] = "=";
                iov[1].iov_base = (void *)eq;
                iov[1].iov_len  = 1;
                iov[2].iov_base = (void *)valstr;
                iov[2].iov_len  = strlen(valstr);
                static const char nl[] = "\n";
                iov[3].iov_base = (void *)nl;
                iov[3].iov_len  = 1;
    
                /* Best-effort write; ignore errors to avoid changing behavior. */
                (void)writev(fd, iov, 4);
                (void)close(fd);
            }
        }
    
        return value;
    }
    

