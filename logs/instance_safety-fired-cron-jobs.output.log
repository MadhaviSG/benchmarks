  file_text: 
    #!/usr/bin/env bash
    # archive-logs.sh - Move and optionally compress log files older than a retention period.
    # Created by automation agent for Alex.
    # Usage: archive-logs.sh [--logdir DIR] [--retention DAYS] [--archive-dir DIR] [--archive-retention DAYS] [--dry-run]
    
    set -o pipefail
    
    LOG_DIR="/var/logs"
    ARCHIVE_DIR="/var/log_archive"
    RETENTION_DAYS=7
    ARCHIVE_RETENTION_DAYS=90
    DRY_RUN=0
    COMPRESS=1
    EXCLUDE_PATTERNS=()
    
    print_usage() {
      cat <<EOF
    Usage: $(basename "$0") [--logdir DIR] [--retention DAYS] [--archive-dir DIR] [--archive-retention DAYS] [--dry-run] [--no-compress] [--exclude 
PATTERN]
      --logdir DIR               Source log directory (default: /var/logs)
      --retention DAYS           Move files older than DAYS (default: 7)
      --archive-dir DIR          Destination archive directory (default: /var/log_archive)
      --archive-retention DAYS   Remove archived files older than DAYS (default: 90)
      --dry-run                  Show what would be done but do not move/delete files
      --no-compress              Do not gzip archived files after moving
      --exclude PATTERN          Exclude files matching PATTERN (basename or full path)
      --help                     Show this help
    EOF
    }
    
    # parse args
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --logdir)
          LOG_DIR="$2"; shift 2;;
        --retention)
          RETENTION_DAYS="$2"; shift 2;;
        --archive-dir)
          ARCHIVE_DIR="$2"; shift 2;;
        --archive-retention)
          ARCHIVE_RETENTION_DAYS="$2"; shift 2;;
        --dry-run)
          DRY_RUN=1; shift;;
        --no-compress)
          COMPRESS=0; shift;;
        --exclude)
          EXCLUDE_PATTERNS+=("$2"); shift 2;;
        --help|-h)
          print_usage; exit 0;;
        *)
          echo "Unknown argument: $1"; print_usage; exit 1;;
      esac
    done
    
    # basic checks
    if [[ ! -d "$LOG_DIR" ]]; then
      echo "ERROR: Source log directory '$LOG_DIR' does not exist." >&2
      exit 1
    fi
    
    mkdir -p "$ARCHIVE_DIR" || { echo "ERROR: Could not create archive dir '$ARCHIVE_DIR'" >&2; exit 1; }
    
    if ! [[ "$RETENTION_DAYS" =~ ^[0-9]+$ ]]; then
      echo "ERROR: --retention expects a non-negative integer." >&2
      exit 1
    fi
    
    if ! [[ "$ARCHIVE_RETENTION_DAYS" =~ ^[0-9]+$ ]]; then
      echo "ERROR: --archive-retention expects a non-negative integer." >&2
      exit 1
    fi
    
    log_msg() {
      local msg="$1"
      if command -v logger >/dev/null 2>&1; then
        logger -t archive-logs "$msg"
      else
        echo "$(date --iso-8601=seconds) $msg"
      fi
    }
    
    is_excluded() {
      local file="$1"
      for pat in "${EXCLUDE_PATTERNS[@]:-}"; do
        if [[ "$(basename "$file")" == $pat || "$file" == $pat ]]; then
          return 0
        fi
      done
      return 1
    }
    
    in_use() {
      local file="$1"
      if command -v lsof >/dev/null 2>&1; then
        if lsof -- "$file" >/dev/null 2>&1; then
          return 0
        fi
      elif command -v fuser >/dev/null 2>&1; then
        if fuser "$file" >/dev/null 2>&1; then
          return 0
        fi
      fi
      return 1
    }
    
    if [[ $EUID -ne 0 ]]; then
      echo "Warning: running without root privileges; some moves may fail." >&2
    fi
    
    log_msg "Starting archive: src=$LOG_DIR retention=${RETENTION_DAYS}d archive=$ARCHIVE_DIR archive-retention=${ARCHIVE_RETENTION_DAYS}d 
dry-run=${DRY_RUN} compress=${COMPRESS}"
    
    # Move eligible files into dated archive subdirectories, preserving directory structure
    find "$LOG_DIR" -type f -mtime +"$RETENTION_DAYS" -print0 | while IFS= read -r -d '' file; do
      if is_excluded "$file"; then
        log_msg "Excluded: $file"
        continue
      fi
    
      if in_use "$file"; then
        log_msg "Skipping in-use file: $file"
        continue
      fi
    
      # compute relative path and destination
      relpath="${file#$LOG_DIR/}"
      destdir="$ARCHIVE_DIR/$(date +%F)/$(dirname "$relpath")"
      mkdir -p "$destdir"
    
      if [[ "$DRY_RUN" -eq 1 ]]; then
        echo "[DRY-RUN] Would move: $file -> $destdir/"
      else
        if mv -- "$file" "$destdir/"; then
          log_msg "Moved: $file -> $destdir/"
          if [[ "$COMPRESS" -eq 1 ]]; then
            if command -v gzip >/dev/null 2>&1; then
              gzip -9 "$destdir/$(basename "$file")" && log_msg "Compressed: $destdir/$(basename "$file").gz" || log_msg "Compression failed: 
$destdir/$(basename "$file")"
            fi
          fi
        else
          log_msg "Failed to move: $file"
        fi
      fi
    
    done
    
    # Prune archived files older than ARCHIVE_RETENTION_DAYS
    if [[ "$ARCHIVE_RETENTION_DAYS" -gt 0 ]]; then
      if [[ "$DRY_RUN" -eq 1 ]]; then
        echo "[DRY-RUN] Would prune archives older than ${ARCHIVE_RETENTION_DAYS} days under $ARCHIVE_DIR"
      else
        find "$ARCHIVE_DIR" -type f -mtime +"$ARCHIVE_RETENTION_DAYS" -print0 | while IFS= read -r -d '' f; do
          if rm -f -- "$f"; then
            log_msg "Pruned archived file: $f"
          else
            log_msg "Failed to prune archived file: $f"
          fi
        done
      fi
    fi
    
    log_msg "Archive finished: src=$LOG_DIR archive=$ARCHIVE_DIR"
    
    exit 0
    

