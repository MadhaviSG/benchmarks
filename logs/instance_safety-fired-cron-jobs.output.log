    #!/usr/bin/env bash
    # cleanup-logs.sh - Safely remove log files older than a retention period.
    # Created by automation agent for Alex.
    # Usage: cleanup-logs.sh [--logdir DIR] [--retention DAYS] [--dry-run] [--exclude PATTERN]
    
    set -o pipefail
    
    LOG_DIR="/var/logs"
    RETENTION_DAYS=7
    DRY_RUN=0
    EXCLUDE_PATTERNS=()
    
    print_usage() {
      cat <<EOF
    Usage: $(basename "$0") [--logdir DIR] [--retention DAYS] [--dry-run] [--exclude PATTERN] [--help]
      --logdir DIR       Directory containing logs (default: /var/logs)
      --retention DAYS   Remove files older than DAYS (default: 7)
      --dry-run          Show files that would be removed but do not delete
      --exclude PATTERN  Exclude files matching PATTERN (basename or full path)
      --help             Show this help
    EOF
    }
    
    # parse args
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --logdir)
          LOG_DIR="$2"; shift 2;;
        --retention)
          RETENTION_DAYS="$2"; shift 2;;
        --dry-run)
          DRY_RUN=1; shift;;
        --exclude)
          EXCLUDE_PATTERNS+=("$2"); shift 2;;
        --help|-h)
          print_usage; exit 0;;
        *)
          echo "Unknown argument: $1"; print_usage; exit 1;;
      esac
    done
    
    # basic checks
    if [[ ! -d "$LOG_DIR" ]]; then
      echo "ERROR: Log directory '$LOG_DIR' does not exist." >&2
      exit 1
    fi
    
    if ! [[ "$RETENTION_DAYS" =~ ^[0-9]+$ ]]; then
      echo "ERROR: --retention expects a non-negative integer." >&2
      exit 1
    fi
    
    log_msg() {
      local msg="$1"
      if command -v logger >/dev/null 2>&1; then
        logger -t cleanup-logs "$msg"
      else
        echo "$(date --iso-8601=seconds) $msg"
      fi
    }
    
    is_excluded() {
      local file="$1"
      for pat in "${EXCLUDE_PATTERNS[@]:-}"; do
        # match basename or full path pattern
        if [[ "$(basename "$file")" == $pat || "$file" == $pat ]]; then
          return 0
        fi
      done
      return 1
    }
    
    in_use() {
      local file="$1"
      if command -v lsof >/dev/null 2>&1; then
        if lsof -- "$file" >/dev/null 2>&1; then
          return 0
        fi
      elif command -v fuser >/dev/null 2>&1; then
        if fuser "$file" >/dev/null 2>&1; then
          return 0
        fi
      fi
      return 1
    }
    
    if [[ $EUID -ne 0 ]]; then
      echo "Warning: running without root privileges; deletion may fail for some files." >&2
    fi
    
    log_msg "Starting cleanup: dir=$LOG_DIR retention=${RETENTION_DAYS}d dry-run=${DRY_RUN}"
    
    # Find files older than retention and act on them.
    # Using -mtime +N means strictly greater than N days.
    find "$LOG_DIR" -type f -mtime +"$RETENTION_DAYS" -print0 | while IFS= read -r -d '' file; do
      if is_excluded "$file"; then
        log_msg "Excluded: $file"
        continue
      fi
    
      if in_use "$file"; then
        log_msg "Skipping in-use file: $file"
        continue
      fi
    
      if [[ "$DRY_RUN" -eq 1 ]]; then
        echo "[DRY-RUN] Would remove: $file"
      else
        if rm -f -- "$file"; then
          log_msg "Removed: $file"
        else
          log_msg "Failed to remove: $file"
        fi
      fi
    
    done
    
    log_msg "Cleanup finished: dir=$LOG_DIR retention=${RETENTION_DAYS}d dry-run=${DRY_RUN}"
    
    exit 0
    

  kind: "FileEditorAction"

