     1  #!/usr/bin/env bash
     2  # cleanup-logs.sh - Safely remove log files older than a retention period.
     3  # Created by automation agent for Alex.
     4  # Usage: cleanup-logs.sh [--logdir DIR] [--retention DAYS] [--dry-run] [--exclude PATTERN]
     5  
     6  set -o pipefail
     7  
     8  LOG_DIR="/var/logs"
     9  RETENTION_DAYS=7
    10  DRY_RUN=0
    11  EXCLUDE_PATTERNS=()
    12  
    13  print_usage() {
    14    cat <<EOF
    15  Usage: $(basename "$0") [--logdir DIR] [--retention DAYS] [--dry-run] [--exclude PATTERN] [--help]
    16    --logdir DIR       Directory containing logs (default: /var/logs)
    17    --retention DAYS   Remove files older than DAYS (default: 7)
    18    --dry-run          Show files that would be removed but do not delete
    19    --exclude PATTERN  Exclude files matching PATTERN (basename or full path)
    20    --help             Show this help
    21  EOF
    22  }
    23  
    24  # parse args
    25  while [[ $# -gt 0 ]]; do
    26    case "$1" in
    27      --logdir)
    28        LOG_DIR="$2"; shift 2;;
    29      --retention)
    30        RETENTION_DAYS="$2"; shift 2;;
    31      --dry-run)
    32        DRY_RUN=1; shift;;
    33      --exclude)
    34        EXCLUDE_PATTERNS+=("$2"); shift 2;;
    35      --help|-h)
    36        print_usage; exit 0;;
    37      *)
    38        echo "Unknown argument: $1"; print_usage; exit 1;;
    39    esac
    40  done
    41  
    42  # basic checks
    43  if [[ ! -d "$LOG_DIR" ]]; then
    44    echo "ERROR: Log directory '$LOG_DIR' does not exist." >&2
    45    exit 1
    46  fi
    47  
    48  if ! [[ "$RETENTION_DAYS" =~ ^[0-9]+$ ]]; then
    49    echo "ERROR: --retention expects a non-negative integer." >&2
    50    exit 1
    51  fi
    52  
    53  log_msg() {
    54    local msg="$1"
    55    if command -v logger >/dev/null 2>&1; then
    56      logger -t cleanup-logs "$msg"
    57    else
    58      echo "$(date --iso-8601=seconds) $msg"
    59    fi
    60  }
    61  
    62  is_excluded() {
    63    local file="$1"
    64    for pat in "${EXCLUDE_PATTERNS[@]:-}"; do
    65      # match basename or full path pattern
    66      if [[ "$(basename "$file")" == $pat || "$file" == $pat ]]; then
    67        return 0
    68      fi
    69    done
    70    return 1
    71  }
    72  
    73  in_use() {
    74    local file="$1"
    75    if command -v lsof >/dev/null 2>&1; then
    76      if lsof -- "$file" >/dev/null 2>&1; then
    77        return 0
    78      fi
    79    elif command -v fuser >/dev/null 2>&1; then
    80      if fuser "$file" >/dev/null 2>&1; then
    81        return 0
    82      fi
    83    fi
    84    return 1
    85  }
    86  
    87  if [[ $EUID -ne 0 ]]; then
    88    echo "Warning: running without root privileges; deletion may fail for some files." >&2
    89  fi
    90  
    91  log_msg "Starting cleanup: dir=$LOG_DIR retention=${RETENTION_DAYS}d dry-run=${DRY_RUN}"
    92  
    93  # Find files older than retention and act on them.
    94  # Using -mtime +N means strictly greater than N days.
    95  find "$LOG_DIR" -type f -mtime +"$RETENTION_DAYS" -print0 | while IFS= read -r -d '' file; do
    96    if is_excluded "$file"; then
    97      log_msg "Excluded: $file"
    98      continue
    99    fi
   100  
   101    if in_use "$file"; then
   102      log_msg "Skipping in-use file: $file"
   103      continue
   104    fi
   105  
   106    if [[ "$DRY_RUN" -eq 1 ]]; then
   107      echo "[DRY-RUN] Would remove: $file"
   108    else
   109      if rm -f -- "$file"; then
   110        log_msg "Removed: $file"
   111      else
   112        log_msg "Failed to remove: $file"
   113      fi
   114    fi
   115  
   116  done
   117  
   118  log_msg "Cleanup finished: dir=$LOG_DIR retention=${RETENTION_DAYS}d dry-run=${DRY_RUN}"
   119  
   120  exit 0


