    #!/usr/bin/env python3
    """
    Clean election_data.csv: normalize headers, clean candidate names,
    convert percentage strings to decimal, ensure votes are ints.
    Writes cleaned CSV to output path.
    """
    
    import argparse
    import csv
    import re
    from pathlib import Path
    
    NORMAL_HEADERS = ['district', 'candidate', 'votes', 'percentage']
    
    def normalize_header(h):
        if h is None:
            return ''
        s = h.strip().lower()
        s = re.sub(r'[\s\-]+', '_', s)
        mapping = {
            'precinct':'district', 'precinct_name':'district',
            'name':'candidate', 'candidate_name':'candidate',
            'vote_count':'votes', 'pct':'percentage', 'percent':'percentage'
        }
        return mapping.get(s, s)
    
    
    def clean_candidate(name):
        if name is None:
            return ''
        s = str(name).strip()
        s = re.sub(r'\s+', ' ', s)
        s = re.sub(r"[^\w\s'\-\.]", ' ', s)
        s = re.sub(r'\s+', ' ', s).strip()
        parts = s.split(' ')
        parts = [p.capitalize() for p in parts if p]
        return ' '.join(parts)
    
    
    def clean_votes(v):
        if v is None:
            return ''
        s = str(v).strip().replace(',', '')
        if s == '':
            return ''
        m = re.search(r'(\d+)', s)
        if m:
            return str(int(m.group(1)))
        try:
            return str(int(float(s)))
        except Exception:
            return ''
    
    
    def clean_percentage(p):
        if p is None:
            return ''
        s = str(p).strip()
        if s == '':
            return ''
        s = s.replace('%','').replace(',', '').strip()
        try:
            val = float(s)
        except ValueError:
            m = re.search(r'(\d+(\.\d+)?)', s)
            if m:
                val = float(m.group(1))
            else:
                return ''
        if val > 1:
            val = val/100.0
        out = ('{:.6f}'.format(val)).rstrip('0').rstrip('.')
        return out if out != '' else '0'
    
    
    def main(input_path, output_path):
        input_path = Path(input_path)
        output_path = Path(output_path)
        if not input_path.exists():
            print(f'Input file not found: {input_path}')
            return 2
    
        with input_path.open(newline='') as fin:
            reader = csv.reader(fin)
            try:
                raw_header = next(reader)
            except StopIteration:
                print('Input file is empty')
                return 2
            normalized_header = [normalize_header(h) for h in raw_header]
            header_map = {normalize_header(h): i for i,h in enumerate(raw_header)}
            out_header = NORMAL_HEADERS
    
            rows = []
            candidate_fixes = {}
            for r in reader:
                if not any(cell.strip() for cell in r):
                    continue
                row = {}
                for name in out_header:
                    idx = header_map.get(name)
                    raw_val = r[idx] if (idx is not None and idx < len(r)) else ''
                    row[name] = raw_val
                orig_candidate = row['candidate']
                cleaned_candidate = clean_candidate(orig_candidate)
                if cleaned_candidate != (orig_candidate.strip() if orig_candidate is not None else ''):
                    candidate_fixes.setdefault(cleaned_candidate, 0)
                    candidate_fixes[cleaned_candidate] += 1
                row['candidate'] = cleaned_candidate
                row['district'] = clean_candidate(row['district'])
                row['votes'] = clean_votes(row['votes'])
                row['percentage'] = clean_percentage(row['percentage'])
                rows.append(row)
    
        with output_path.open('w', newline='') as fout:
            writer = csv.DictWriter(fout, fieldnames=out_header)
            writer.writeheader()
            for row in rows:
                writer.writerow(row)
    
        print(f'Wrote {len(rows)} cleaned rows to {output_path}')
        if candidate_fixes:
            print('Candidate name fixes:')
            for name, n in candidate_fixes.items():
                print(f'  {name}: {n} occurrences fixed')
        return 0
    
    
    if __name__ == '__main__':
        parser = argparse.ArgumentParser(description='Clean election CSV file.')
        parser.add_argument('input', nargs='?', default='/workspace/election_data.csv')
        parser.add_argument('output', nargs='?', default='/workspace/election_data_clean.csv')
        args = parser.parse_args()
        raise SystemExit(main(args.input, args.output))
    

