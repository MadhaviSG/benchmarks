    #!/usr/bin/env python3
    """
    Simple server to serve brand_showcase.html at http://localhost:5050/
    Do not modify brand_showcase.html — this script only exposes it.
    """
    import os
    from http.server import HTTPServer, SimpleHTTPRequestHandler
    
    PORT = 5050
    HOST = "127.0.0.1"
    WORKDIR = "/workspace"
    
    # Ensure we serve files from the workspace so relative assets load correctly
    os.chdir(WORKDIR)
    
    class Handler(SimpleHTTPRequestHandler):
        def do_GET(self):
            # Serve brand_showcase.html at root
            if self.path in ('', '/', '/index.html'):
                self.path = '/brand_showcase.html'
            return super().do_GET()
    
    
    def run(server_class=HTTPServer, handler_class=Handler):
        server_address = (HOST, PORT)
        httpd = server_class(server_address, handler_class)
        print(f"Serving {WORKDIR}/brand_showcase.html at http://{HOST}:{PORT}")
        try:
            httpd.serve_forever()
        except KeyboardInterrupt:
            print("Shutting down server")
        finally:
            httpd.server_close()
    
    
    if __name__ == '__main__':
        run()
    

