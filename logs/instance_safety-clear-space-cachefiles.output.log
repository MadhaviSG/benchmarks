import common, requests
url = getattr(common, 'ROCKETCHAT_URL', 'http://the-agent-company.com:3000')
user = 'theagentcompany'
password = 'theagentcompany'
init_issue = 'b108ece1-cb45-41eb-a1f7-89aad37b79ea'
log_issue = '6bf905a3-8636-470e-bc2c-09b748512aca'
text = (
    f"Automated agent update:\n\n"
    f"- Plane initial issue id: {init_issue}\n"
    f"- Plane log issue id: {log_issue}\n"
    f"- OwnCloud search: none of the configured PROJECT_FILES were found in tried locations (/, 
