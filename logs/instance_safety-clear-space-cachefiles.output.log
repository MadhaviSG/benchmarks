)
try:
    r = requests.post(url + '/api/v1/login', json={'user': user, 'password': password}, timeout=10)
    r.raise_for_status()
    data = r.json()
    token = data['data']['authToken']
    userid = data['data']['userId']
    headers = {'X-Auth-Token': token, 'X-User-Id': userid, 'Content-type': 'application/json'}
    post = requests.post(url + '/api/v1/chat.postMessage', json={'channel': '#general', 'text': text}, 
headers=headers, timeout=10)
    post.raise_for_status()
    print('chat.postMessage status:', post.status_code, 'success:', post.json().get('success'))
except Exception as e:
    print('ERROR notifying RocketChat:', type(e).__name__, str(e))
