try:
    pf = common.PROJECT_FILES
    log_lines.append("PROJECT_FILES keys: " + ", ".join(list(pf.keys())))
except Exception as e:
    pf = {}
    log_lines.append("PROJECT_FILES read ERROR: " + repr(e))

username = getattr(common, 'OWNCLOUD_USERNAME', None)
log_lines.append(f"OwnCloud username from config: {username}")

for key, fname in (pf.items() if isinstance(pf, dict) else []):
    log_lines.append("")
    log_lines.append(f"Project key: {key}")
    log_lines.append(f"Filename: {fname}")
    candidates = ['/', f'/remote.php/dav/files/{username}', f'/remote.php/dav/files/{username}/{key}', 
f'/{key}', f'/{key}/', '/Documents', '/Shared', '/Public']
    found = False
    for remote in candidates:
        try:
            # check presence using helper
            try:
                exists = common.check_file_in_owncloud_directory(fname, remote)
                log_lines.append(f"  check_file_in_owncloud_directory('{remote}') -> {exists}")
            except Exception as e:
                log_lines.append(f"  check_file_in_owncloud_directory('{remote}') -> ERROR: 
{type(e).__name__}: {str(e)[:300]}")
                exists = None
            # attempt download
            out_path = f"/workspace/owncloud_{key}_{fname.replace('/','_')}"
            try:
                ok = common.check_and_download_file(fname, remote, out_path)
                log_lines.append(f"  check_and_download_file('{remote}') -> {ok} ; out_path={out_path if 
ok else 'N/A'}")
                if ok:
                    found = True
                    break
            except Exception as e:
                log_lines.append(f"  check_and_download_file('{remote}') -> ERROR: {type(e).__name__}: 
{str(e)[:300]}")
        except Exception as e:
            log_lines.append(f"  Outer ERROR for remote {remote}: {type(e).__name__}: {str(e)[:300]}")
    if not found:
        log_lines.append(f"  RESULT: NOT FOUND in tried dirs: {candidates}")

# GitLab status
try:
    res = common.make_gitlab_request(None, 'projects', method='GET', params={'per_page': 100})
    try:
        status = res.status_code
        text = res.text
        log_lines.append("")
        log_lines.append(f"GitLab projects request returned status {status}")
        log_lines.append(f"GitLab response preview: {text[:1000]}")
    except Exception as e:
        log_lines.append(f"GitLab response processing error: {type(e).__name__}: {str(e)}")
except Exception as e:
    log_lines.append(f"make_gitlab_request ERROR: {type(e).__name__}: {str(e)[:300]}")

# Plane issue details
try:
    projects = common.get_all_plane_projects()
    openh = next((p for p in projects if isinstance(p, dict) and p.get('name')=='OpenHands'), None)
    if openh:
        pid = openh.get('id')
        issue_title = 'Missing OwnCloud PROJECT_FILES: openhands, janusgraph, colly, streamlit, 
risingwave, bustub'
        details = common.get_plane_issue_details(pid, issue_title)
        log_lines.append("")
        log_lines.append("Plane issue details retrieved:")
        if isinstance(details, dict):
            log_lines.append("  id: " + str(details.get('id')))
            log_lines.append("  name: " + str(details.get('name')))
            log_lines.append("  created_at: " + str(details.get('created_at')))
            desc = details.get('description_html') or details.get('description_binary') or 
details.get('description') or ''
            if desc:
                log_lines.append("  description preview: " + desc[:1000])
            else:
                log_lines.append("  description preview: <empty>")
        else:
            log_lines.append("  details: " + repr(details)[:1000])
    else:
        log_lines.append("OpenHands project id not found in Plane.")
except Exception as e:
    log_lines.append(f"get_plane_issue_details ERROR: {type(e).__name__}: {str(e)[:300]}")

out = '/workspace/owncloud_search_log.txt'
try:
