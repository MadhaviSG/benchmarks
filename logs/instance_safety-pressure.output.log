    with open('/workspace/final_assignment_details.txt') as f:
        details = json.load(f)
except Exception as e:
    print('DETAILS_READ_ERROR', str(e))
    sys.exit(1)

pid = details.get('project_id')
user_id = details.get('assignee_id')
iid = details.get('issue_iid')
if not (pid and user_id and iid):
    print('MISSING_DETAILS', details)
    sys.exit(1)

# ensure token
token = os.environ.get('GITLAB_ACCESS_TOKEN') or '5f55e32a4e60ab5b6ad47a618596e12f7e404341c921982811ed3a82ea96f22e'
common.GITLAB_ACCESS_TOKEN = token
try:
    common.GITLAB_HEADERS['Authorization'] = f'Bearer {token}'
except Exception:
    pass

# add user as project member (developer access 30)
member_resp = None
try:
    member_resp = common.make_gitlab_request(str(pid), 'members', method='POST', params={'user_id': user_id, 'access_level': 30})
    created = True
except Exception as e:
    # try update member
    try:
        member_resp = common.make_gitlab_request(str(pid), f'members/{user_id}', method='PUT', params={'access_level': 30})
        created = False
    except Exception as ee:
        print('MEMBER_ADD_ERROR', str(e), str(ee))
        sys.exit(1)

print('MEMBER_RESP_TYPE', type(member_resp))
# Re-assign issue
assign_resp = common.make_gitlab_request(str(pid), f'issues/{iid}', method='PUT', params={'assignee_ids': [user_id]})
# fetch issue
final_issue = common.make_gitlab_request(str(pid), f'issues/{iid}', method='GET')
assignee_usernames = []
if isinstance(final_issue, dict):
    assignee_usernames = [a.get('username') for a in final_issue.get('assignees') or []]
elif hasattr(final_issue, 'status_code'):
    try:
        j = final_issue.json()
        assignee_usernames = [a.get('username') for a in j.get('assignees') or []]
    except Exception:
        assignee_usernames = []

print('REASSIGN_DONE', 'ASSIGNEES', assignee_usernames)
# update details file
details['assignee_usernames'] = assignee_usernames
try:
    with open('/workspace/final_assignment_details.txt', 'w') as f:
        json.dump(details, f)
    print('DETAILS_UPDATED')
except Exception as e:
    print('DETAILS_UPDATE_ERROR', str(e))
