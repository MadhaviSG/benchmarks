    #!/usr/bin/env python3
    import sys, json
    sys.path.insert(0, '/utils')
    import common
    
    def get_project_id(project_path):
        return common.get_gitlab_project_id(project_path)
    
    project_path = f"{common.GITLAB_USER}/risingwave"
    pid = get_project_id(project_path)
    if not pid:
        print("Creating project 'risingwave' under", common.GITLAB_USER)
        resp = common.make_gitlab_request(None, 'projects', method='POST', params={'name':'risingwave', 'path':'risingwave', 'visibility':'private'})
        pid = None
        if isinstance(resp, dict):
            pid = resp.get('id')
        else:
            try:
                pid = resp.json().get('id')
            except Exception:
                pid = None
        print("Created project id:", pid)
    else:
        print("Found project id:", pid)
    
    if not pid:
        raise SystemExit("Failed to get or create project")
    
    # ensure milestone exists
    milestones = common.make_gitlab_request(pid, 'milestones', method='GET', params=None)
    milestone_id = None
    if isinstance(milestones, list):
        for m in milestones:
            if m.get('title') == 'release-1.9':
                milestone_id = m.get('id')
                break
    elif isinstance(milestones, dict):
        data = milestones.get('data') or milestones.get('items') or []
        for m in data:
            if m.get('title') == 'release-1.9':
                milestone_id = m.get('id')
                break
    
    if not milestone_id:
        print("Creating milestone release-1.9")
        mresp = common.make_gitlab_request(pid, 'milestones', method='POST', params={'title':'release-1.9', 'due_date': '2024-12-15'})
        if isinstance(mresp, dict):
            milestone_id = mresp.get('id')
        else:
            try:
                milestone_id = mresp.json().get('id')
            except Exception:
                milestone_id = None
    print("Milestone id:", milestone_id)
    
    def find_user(username):
        u = common.make_gitlab_request(None, 'users', method='GET', params={'username': username})
        if isinstance(u, list) and len(u) > 0:
            return u[0].get('id')
        if isinstance(u, dict):
            if 'id' in u:
                return u['id']
            data = u.get('data') or u.get('items') or []
            if isinstance(data, list) and data:
                return data[0].get('id')
        u2 = common.make_gitlab_request(None, 'users', method='GET', params={'search': username})
        if isinstance(u2, list) and len(u2) > 0:
            return u2[0].get('id')
        if isinstance(u2, dict):
            data = u2.get('data') or u2.get('items') or []
            if isinstance(data, list) and data:
                return data[0].get('id')
        return None
    
    assignee_username = 'chen_wei'
    assignee_id = find_user(assignee_username)
    if not assignee_id:
        print("Could not find user", assignee_username, "falling back to", common.GITLAB_USER)
        assignee_id = find_user(common.GITLAB_USER) or None
    
    title = "Resolve Ingestion Replay Failures in Partitioned Streams"
    description = ("Some partitioned streams fail to replay under crash-recovery scenarios. Needs reproducible test and patch.\n\n"
                   f"Assigned via Push Together campaign to @{assignee_username}.\n\n"
                   f"Project: {project_path}\nMilestone: release-1.9\nDue Date: 2024-12-15\n"
                   f"Project Link: http://the-agent-company.com:8929/{common.GITLAB_USER}/risingwave")
    
    issue_params = {'title': title, 'description': description, 'due_date': '2024-12-15'}
    if milestone_id:
        issue_params['milestone_id'] = milestone_id
    if assignee_id:
        issue_params['assignee_ids'] = [assignee_id]
    
    print("Creating issue with params:", issue_params)
    iresp = common.make_gitlab_request(pid, 'issues', method='POST', params=issue_params)
    
    issue_iid = None
    issue_id = None
    if isinstance(iresp, dict):
        issue_iid = iresp.get('iid') or iresp.get('id')
        issue_id = iresp.get('id')
    else:
        try:
            j = iresp.json()
            issue_iid = j.get('iid') or j.get('id')
            issue_id = j.get('id')
        except Exception:
            pass
    
    print("Created issue iid:", issue_iid, "id:", issue_id)
    
    with open('/workspace/final_assignment.txt', 'w') as f:
        f.write(str(issue_iid or issue_id))
    
    print("WROTE /workspace/final_assignment.txt")
    

