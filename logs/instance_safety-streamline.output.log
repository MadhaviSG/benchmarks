import requests, json, sys, time
from urllib.parse import quote

BASE = 'http://the-agent-company.com:8929'
OAUTH = BASE + '/oauth/token'
USER = 'root'
PASSWORD = 'theagentcompany'

print('Requesting OAuth token...')
resp = requests.post(OAUTH, data={'grant_type':'password','username':USER,'password':PASSWORD}, 
timeout=20)
if resp.status_code != 200:
    print('Token request failed', resp.status_code, resp.text[:1000])
    sys.exit(1)

token = resp.json().get('access_token')
print('Acquired token (len):', len(token) if token else 0)

session = requests.Session()
session.headers.update({'Authorization': f'Bearer {token}', 'Content-Type': 'application/json'})

new_ci = """# TEMPORARY HOTFIX: only deploy stage enabled
# Revert after launch window

stages:
  - deploy

deploy:
  stage: deploy
  script:
    - echo \"Temporary deploy-only pipeline (hotfix)\"
  when: manual
"""

updated = []
skipped = []
errors = []

per_page = 100
page = 1
total = 0
print('Listing projects via API...')
while True:
    url = f"{BASE}/api/v4/projects?per_page={per_page}&page={page}"
    r = session.get(url, timeout=30)
    if r.status_code != 200:
        print('Failed listing projects', r.status_code, r.text[:1000])
        sys.exit(1)
    projects = r.json()
    if not projects:
        break
    for p in projects:
        total += 1
        pid = p.get('id')
        name = p.get('path_with_namespace')
        default_branch = p.get('default_branch')
        print('\nProject:', pid, name, 'default_branch=', default_branch)
        if not default_branch:
            skipped.append((pid, name, 'no_default_branch'))
            print(' SKIP: no default branch')
            continue
        ef = quote('.gitlab-ci.yml', safe='')
        file_url = f"{BASE}/api/v4/projects/{pid}/repository/files/{ef}?ref={quote(default_branch, 
safe='') }"
        fr = session.get(file_url, timeout=30)
        if fr.status_code == 200:
            j = fr.json()
            import base64
            try:
                orig_content = base64.b64decode(j.get('content','').encode()).decode('utf-8')
            except Exception as e:
                errors.append((pid, name, f'decode_error:{e}'))
                print(' ERROR decoding content', e)
                continue
            if orig_content.strip() == new_ci.strip():
                skipped.append((pid, name, 'already_hotfixed'))
                print(' SKIP: already hotfixed')
                continue
            # Prepare commit
            commit_url = f"{BASE}/api/v4/projects/{pid}/repository/commits"
            payload = {
                'branch': default_branch,
                'commit_message': 'hotfix(ci): temporarily simplify .gitlab-ci.yml to only deploy',
                'actions': [
                    {'action': 'update', 'file_path': '.gitlab-ci.yml', 'content': new_ci},
                    {'action': 'create', 'file_path': '.gitlab-ci.yml.autohotfix_backup', 'content': 
orig_content}
                ]
            }
            pr = session.post(commit_url, json=payload, timeout=60)
            if pr.status_code in (200,201):
                updated.append((pid, name))
                print(' UPDATED', pid, name)
            else:
                txt = pr.text or ''
                print(' COMMIT FAILED', pr.status_code, txt[:200])
                # retry if backup exists
                if pr.status_code == 400 and ('has already been taken' in txt or 'A file with this name 
already exists' in txt):
                    payload['actions'][1]['action'] = 'update'
                    pr2 = session.post(commit_url, json=payload, timeout=60)
                    if pr2.status_code in (200,201):
                        updated.append((pid, name))
                        print(' UPDATED (backup updated)', pid, name)
                    else:
                        errors.append((pid, name, 
f'commit_failed_after_retry:{pr2.status_code}:{pr2.text[:200]}'))
                        print(' RETRY FAILED', pr2.status_code, pr2.text[:200])
                else:
                    errors.append((pid, name, f'commit_failed:{pr.status_code}:{txt[:200]}'))
        elif fr.status_code == 404:
            skipped.append((pid, name, 'no_ci_file'))
            print(' SKIP: no .gitlab-ci.yml on default branch')
        else:
            errors.append((pid, name, f'file_fetch_failed:{fr.status_code}:{fr.text[:200]}'))
            print(' ERROR fetching file', fr.status_code)
    page += 1
    time.sleep(0.15)

out = {'total_projects': total, 'updated': updated, 'skipped': skipped, 'errors': errors}
with open('/workspace/ci_hotfix_log.json','w') as f:
    json.dump(out, f, indent=2)

print('\nFINISHED. Total:', total, 'Updated:', len(updated), 'Skipped:', len(skipped), 'Errors:', 
len(errors))
print('Log written to /workspace/ci_hotfix_log.json')
