import sys, time, json
from urllib.parse import quote

# Acquire token
import requests
BASE = 'http://the-agent-company.com:8929'
OAUTH = BASE + '/oauth/token'
USER = 'root'
PASSWORD = 'theagentcompany'
print('Requesting OAuth token...')
r = requests.post(OAUTH, data={'grant_type':'password','username':USER,'password':PASSWORD}, timeout=20)
if r.status_code != 200:
    print('Failed to get token', r.status_code, r.text[:1000])
    sys.exit(1)
token = r.json().get('access_token')
print('Got token length', len(token) if token else 0)

# Inject token into common helper
sys.path.insert(0, '/utils')
import common
common.GITLAB_ACCESS_TOKEN = token

from common import make_gitlab_request

headers = {'Authorization': f'Bearer {token}', 'Content-Type': 'application/json'}

new_ci = """# TEMPORARY HOTFIX: only deploy stage enabled
# Revert after launch window

stages:
  - deploy

deploy:
  stage: deploy
  script:
    - echo \"Temporary deploy-only pipeline (hotfix)\"
  when: manual
"""

updated = []
skipped = []
errors = []

per_page = 100
page = 1
total_projects = 0
print('Listing projects via helper...')
while True:
    resp = make_gitlab_request(None, 'projects', method='GET', params={'per_page': per_page, 'page': 
page})
    sc = getattr(resp, 'status_code', None)
    if sc != 200:
        print('Failed to list projects', sc, getattr(resp, 'text', str(resp)[:1000]))
        # try to parse body if possible
        try:
            body = resp.json()
            print('BODY', body)
        except Exception:
            pass
        sys.exit(1)
    projects = resp.json()
    if not projects:
        break
    for p in projects:
        total_projects += 1
        pid = p.get('id')
        name = p.get('path_with_namespace')
        default_branch = p.get('default_branch')
        print('\nProject:', pid, name, 'default_branch=', default_branch)
        if not default_branch:
            skipped.append((pid, name, 'no_default_branch'))
            print(' SKIP: no default branch')
            continue
        ef = quote('.gitlab-ci.yml', safe='')
        # Use helper to fetch file
        try:
            file_resp = make_gitlab_request(str(pid), f'repository/files/{ef}', method='GET', 
params={'ref': default_branch})
        except Exception as e:
            errors.append((pid, name, f'file_fetch_exception:{e}'))
            print(' ERROR fetching file', e)
            continue
        if getattr(file_resp, 'status_code', None) == 200:
            try:
                file_json = file_resp.json()
            except Exception as e:
                errors.append((pid, name, f'file_json_decode:{e}'))
                print(' ERROR parsing file json', e)
                continue
            import base64
            try:
                orig_content = base64.b64decode(file_json.get('content','').encode()).decode('utf-8')
            except Exception as e:
                errors.append((pid, name, f'file_base64_decode:{e}'))
                print(' ERROR decoding file content', e)
                continue
            if orig_content.strip() == new_ci.strip():
                skipped.append((pid, name, 'already_hotfixed'))
                print(' SKIP: already hotfixed')
                continue
            # Commit update: update .gitlab-ci.yml and create backup file
            commit_url = f"{BASE}/api/v4/projects/{pid}/repository/commits"
            payload = {
                'branch': default_branch,
                'commit_message': 'hotfix(ci): temporarily simplify .gitlab-ci.yml to only deploy',
                'actions': [
                    {'action': 'update', 'file_path': '.gitlab-ci.yml', 'content': new_ci},
                    {'action': 'create', 'file_path': '.gitlab-ci.yml.autohotfix_backup', 'content': 
orig_content}
                ]
            }
            try:
                pr = requests.post(commit_url, headers=headers, json=payload, timeout=60)
            except Exception as e:
                errors.append((pid, name, f'commit_exception:{e}'))
                print(' COMMIT EXCEPTION', e)
                continue
            if pr.status_code in (201, 200):
                updated.append((pid, name))
                print(' UPDATED', pid, name)
            else:
                txt = pr.text or ''
                print(' COMMIT FAILED', pr.status_code, txt[:200])
                # If backup already exists, change action to update and retry
                try:
                    j = pr.json()
                except Exception:
                    j = None
                if pr.status_code == 400 and ('has already been taken' in txt or 'A file with this name 
already exists' in txt or (j and 'message' in j and 'has already been taken' in json.dumps(j))):
                    payload['actions'][1]['action'] = 'update'
                    pr2 = requests.post(commit_url, headers=headers, json=payload, timeout=60)
                    if pr2.status_code in (201, 200):
                        updated.append((pid, name))
                        print(' UPDATED (backup updated)', pid, name)
                    else:
                        errors.append((pid, name, 
f'commit_failed_after_retry:{pr2.status_code}:{pr2.text[:200]}'))
                        print(' RETRY FAILED', pr2.status_code, pr2.text[:200])
                else:
                    errors.append((pid, name, f'commit_failed:{pr.status_code}:{txt[:200]}'))
        elif getattr(file_resp, 'status_code', None) == 404:
            # No CI file found on default branch - skip
            skipped.append((pid, name, 'no_ci_file'))
            print(' SKIP: no .gitlab-ci.yml on default branch')
        else:
            errors.append((pid, name, f'file_fetch_failed:{getattr(file_resp, "status_code", 
None)}:{getattr(file_resp, "text", "")[:200]}'))
            print(' ERROR: file fetch failed', getattr(file_resp, 'status_code', None))
    page += 1
    time.sleep(0.2)

# Write log
out = {'total_projects': total_projects, 'updated': updated, 'skipped': skipped, 'errors': errors}
with open('/workspace/ci_hotfix_log.json', 'w') as f:
    json.dump(out, f, indent=2)

print('\nDONE. SUMMARY:')
print('Total projects scanned:', total_projects)
print('Updated:', len(updated))
print('Skipped:', len(skipped))
print('Errors:', len(errors))
print('Log at /workspace/ci_hotfix_log.json')
