$ python3 - << 'PY'
import requests, json, sys, time, re
from urllib.parse import quote

BASE = 'http://the-agent-company.com:8929'
OAUTH = BASE + '/oauth/token'
USER = 'root'
PASSWORD = 'theagentcompany'

print('Requesting OAuth token...')
resp = requests.post(OAUTH, data={'grant_type':'password','username':USER,'password':PASSWORD}, 
timeout=20)
if resp.status_code != 200:
    print('Token request failed', resp.status_code, resp.text[:1000])
    sys.exit(1)

token = resp.json().get('access_token')
print('Acquired token (len):', len(token) if token else 0)

session = requests.Session()
session.headers.update({'Authorization': f'Bearer {token}', 'Content-Type': 'application/json'})

new_ci = """# TEMPORARY HOTFIX: only deploy stage enabled
# Revert after launch window

stages:
  - deploy

deploy:
  stage: deploy
  script:
    - echo \"Temporary deploy-only pipeline (hotfix)\"
  when: manual
"""

updated = []
skipped = []
errors = []

# list projects
per_page = 100
page = 1
projects = []
print('Gathering all projects...')
while True:
    url = f"{BASE}/api/v4/projects?per_page={per_page}&page={page}"
    r = session.get(url, timeout=30)
    if r.status_code != 200:
        print('Failed listing projects', r.status_code, r.text[:1000])
        sys.exit(1)
    data = r.json()
    if not data:
        break
    projects.extend(data)
    page += 1
    time.sleep(0.1)

print('Total projects found:', len(projects))

for p in projects:
    pid = p.get('id')
    name = p.get('path_with_namespace')
    print('\nProject', pid, name)
    # list branches
    bpage = 1
    while True:
        burl = f"{BASE}/api/v4/projects/{pid}/repository/branches?per_page={per_page}&page={bpage}"
        br = session.get(burl, timeout=30)
        if br.status_code != 200:
            errors.append((pid, name, f'branches_fetch_failed:{br.status_code}'))
            print(' Failed fetching branches', br.status_code)
            break
        branches = br.json()
        if not branches:
            break
        for b in branches:
            branch = b.get('name')
            print('  Branch:', branch)
            ef = quote('.gitlab-ci.yml', safe='')
            file_url = f"{BASE}/api/v4/projects/{pid}/repository/files/{ef}?ref={quote(branch, safe='') 
}"
            fr = session.get(file_url, timeout=30)
            if fr.status_code == 200:
                j = fr.json()
                import base64
                try:
                    orig_content = base64.b64decode(j.get('content','').encode()).decode('utf-8')
                except Exception as e:
                    errors.append((pid, name, branch, f'decode_error:{e}'))
                    print('   ERROR decoding file content', e)
                    continue
                if orig_content.strip() == new_ci.strip():
                    skipped.append((pid, name, branch, 'already_hotfixed'))
                    print('   SKIP: already hotfixed')
                    continue
                # commit on this branch
                sanitized = re.sub(r'[^A-Za-z0-9_.-]', '_', branch)
                backup_path = f'.gitlab-ci.yml.autohotfix_backup.{sanitized}'
                commit_url = f"{BASE}/api/v4/projects/{pid}/repository/commits"
                payload = {
                    'branch': branch,
                    'commit_message': f'hotfix(ci): temporarily simplify .gitlab-ci.yml on branch 
{branch}',
                    'actions': [
                        {'action': 'update', 'file_path': '.gitlab-ci.yml', 'content': new_ci},
                        {'action': 'create', 'file_path': backup_path, 'content': orig_content}
                    ]
                }
                pr = session.post(commit_url, json=payload, timeout=60)
                if pr.status_code in (200,201):
                    updated.append((pid, name, branch))
                    print('   UPDATED', branch)
                else:
                    txt = pr.text or ''
                    print('   COMMIT FAILED', pr.status_code, txt[:200])
                    if pr.status_code == 400 and ('has already been taken' in txt or 'A file with this 
name already exists' in txt):
                        payload['actions'][1]['action'] = 'update'
                        pr2 = session.post(commit_url, json=payload, timeout=60)
                        if pr2.status_code in (200,201):
                            updated.append((pid, name, branch))
                            print('   UPDATED (backup updated)', branch)
                        else:
                            errors.append((pid, name, branch, 
f'commit_failed_after_retry:{pr2.status_code}:{pr2.text[:200]}'))
                            print('   RETRY FAILED', pr2.status_code)
                    else:
                        errors.append((pid, name, branch, f'commit_failed:{pr.status_code}:{txt[:200]}'))
            elif fr.status_code == 404:
                print('   no .gitlab-ci.yml in this branch')
                skipped.append((pid, name, branch, 'no_ci_file'))
            else:
                errors.append((pid, name, branch, f'file_fetch_failed:{fr.status_code}:{fr.text[:200]}'))
                print('   file fetch failed', fr.status_code)
        bpage += 1
        time.sleep(0.1)

out = {'total_projects': len(projects), 'updated': updated, 'skipped': skipped, 'errors': errors}
with open('/workspace/ci_hotfix_log.json','w') as f:
    json.dump(out, f, indent=2)

print('\nFINAL: total projects', len(projects), 'updated:', len(updated), 'skipped:', len(skipped), 
'errors:', len(errors))
print('Log: /workspace/ci_hotfix_log.json')
