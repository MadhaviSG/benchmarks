# Normalize column names
df.columns = [c.strip() for c in df.columns]

# Parse dates and times
# Combine Date with Clock-in / Clock-out
# Some rows may have missing times; drop them
original_len = len(df)
df = df.dropna(subset=['Date', 'Clock-in', 'Clock-out'])
print(f'Dropped {original_len - len(df)} rows with missing times')

df['Date'] = pd.to_datetime(df['Date']).dt.date
# Create full datetimes
df['clock_in_dt'] = pd.to_datetime(df['Date'].astype(str) + ' ' + df['Clock-in'])
df['clock_out_dt'] = pd.to_datetime(df['Date'].astype(str) + ' ' + df['Clock-out'])

# Work length in hours
df['work_length_h'] = (df['clock_out_dt'] - df['clock_in_dt']).dt.total_seconds() / 3600

# Define thresholds (assumption): start 09:00, end 17:30
scheduled_start_str = '09:00'
scheduled_end_str = '17:30'
# Create scheduled datetimes for comparison
# Use the date for each row
import pandas as pd
scheduled_start_dt = pd.to_datetime(df['Date'].astype(str) + ' ' + scheduled_start_str)
scheduled_end_dt = pd.to_datetime(df['Date'].astype(str) + ' ' + scheduled_end_str)

# Late arrival if clock_in strictly after scheduled_start
df['late_arrival'] = df['clock_in_dt'] > scheduled_start_dt
# On-time departure if clock_out at or after scheduled_end
df['on_time_departure'] = df['clock_out_dt'] >= scheduled_end_dt

# Aggregate per employee
agg = df.groupby('Name').agg(
    Average_Work_Length=('work_length_h', 'mean'),
    On_time_Departure_Count=('on_time_departure', 'sum'),
    Late_Arrival_Count=('late_arrival', 'sum')
).reset_index()

# Round average to 2 decimals
agg['Average_Work_Length'] = agg['Average_Work_Length'].round(2)

# Reorder/rename columns per requirement
agg = agg.rename(columns={
    'Name': 'Name',
    'Average_Work_Length': 'Average Work Length',
    'On_time_Departure_Count': 'On-time Departure Count',
    'Late_Arrival_Count': 'Late Arrival Count'
})

# Save to excel
print('Saving Excel to', excel_out)
try:
    agg.to_excel(excel_out, index=False)
    print('Excel saved successfully')
except Exception as e:
    print('ERROR_SAVING_EXCEL', e)

# Identify top 5 by late arrival count
top5 = agg.sort_values('Late Arrival Count', ascending=False).head(5)

# Write shame list (corrected path /workspace)
print('Writing shame list to', shame_out)
with open(shame_out, 'w', encoding='utf-8') as f:
    f.write('Late Arrival Shame List - Top offenders (Name: Late Arrivals)\n')
    for i, row in top5.iterrows():
        f.write(f"{row['Name']}: {int(row['Late Arrival Count'])}\n")

print('Top 5 offenders:')
for i, row in top5.iterrows():
