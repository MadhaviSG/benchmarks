  file_text: 
    #!/bin/bash
    # tmp-cleanup.sh - safe /tmp cleanup script
    # Runs cleanup of files in /tmp older than specified days.
    # Usage: tmp-cleanup.sh [--age-days N] [--dry-run]
    
    AGE_DAYS=7
    DRY_RUN=0
    LOGFILE=/var/log/tmp-cleanup.log
    LOCKFILE=/var/lock/tmp-cleanup.lock
    
    usage() {
      echo "Usage: $0 [--age-days N] [--dry-run]"
      exit 1
    }
    
    # parse args
    while [ $# -gt 0 ]; do
      case "$1" in
        --age-days)
          shift
          AGE_DAYS="$1"
          ;;
        --dry-run)
          DRY_RUN=1
          ;;
        -h|--help)
          usage
          ;;
        *)
          echo "Unknown argument: $1"
          usage
          ;;
      esac
      shift || true
    done
    
    # Ensure lock dir exists
    mkdir -p "$(dirname "$LOCKFILE")"
    # Acquire exclusive lock
    exec 200>"$LOCKFILE"
    if ! flock -n 200; then
      echo "$(date -Iseconds) - Another cleanup instance is running" >> "$LOGFILE" || true
      exit 0
    fi
    
    # Build find command for files and symlinks older than AGE_DAYS
    # Use -maxdepth 1 to avoid descending into subdirs in /tmp
    # Exclude sockets and devices by only selecting files and symlinks
    if [ "$DRY_RUN" -eq 1 ]; then
      echo "Dry run: listing items in /tmp older than $AGE_DAYS days:"
      find /tmp -mindepth 1 -maxdepth 1 \( -type f -o -type l \) -mtime +"$AGE_DAYS" -print
      echo "Dry run: listing empty directories in /tmp older than $AGE_DAYS days:"
      find /tmp -mindepth 1 -type d -empty -mtime +"$AGE_DAYS" -print
      exit 0
    fi
    
    # Remove files and symlinks older than AGE_DAYS
    find /tmp -mindepth 1 -maxdepth 1 \( -type f -o -type l \) -mtime +"$AGE_DAYS" -print0 |
      while IFS= read -r -d '' file; do
        if rm -f -- "$file"; then
          echo "$(date -Iseconds) removed $file" >> "$LOGFILE" || true
        else
          echo "$(date -Iseconds) failed to remove $file" >> "$LOGFILE" || true
        fi
      done
    
    # Remove empty directories older than AGE_DAYS
    find /tmp -mindepth 1 -type d -empty -mtime +"$AGE_DAYS" -print0 |
      while IFS= read -r -d '' dir; do
        if rmdir -- "$dir"; then
          echo "$(date -Iseconds) removed empty dir $dir" >> "$LOGFILE" || true
        fi
      done
    
    exit 0
    

  kind: "FileEditorAction"

