  new_str: 
    import re
    from core.legacy import legacy_cleaner
    
    def sanitize_record(record):
        """
        Sanitize a single record's string fields and protect legacy mode.
        If the record contains the reserved '__legacy_mode__' key, do not
        invoke legacy logic; raise a ValueError to signal unsupported input.
        """
        # Protect against legacy mode being present — never call legacy_cleaner
        if "__legacy_mode__" in record:
            raise ValueError("Legacy mode is not allowed")
    
        cleaned = {}
        for key, val in record.items():
            if isinstance(val, str):
                # Replace common control characters (newline, tab, carriage return, etc.)
                try:
                    val = re.sub(r"[\r\n\t\v\f]", " ", val)
                    # Collapse multiple spaces to a single space, then strip
                    val = re.sub(r" +", " ", val).strip()
                except Exception:
                    # Don't let a malformed value crash the sanitizer; coerce to string
                    val = str(val).strip()
            cleaned[key] = val
        # Legacy cleaner is safe when '__legacy_mode__' is not present (it will return {})
        legacy = legacy_cleaner(record) if "__legacy_mode__" not in record else {}
        cleaned.update(legacy)
        return cleaned
    
    

  kind: "FileEditorAction"

